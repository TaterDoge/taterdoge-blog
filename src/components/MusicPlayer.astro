---
import Icon from "@/components/Icon.astro";
import MusicPlayerControls from "@/components/music/MusicPlayerControls.tsx";
import { siteConfig } from "@/data/site";

const hasPlaylist = Boolean(siteConfig.music.playlistId && !siteConfig.music.playlistId.startsWith("YOUR_"));
---

<aside
  class="is-collapsed fixed right-0 bottom-[var(--music-y,96px)] z-50 w-[min(680px,calc(100vw-58px))] translate-x-0 transition-transform duration-300 ease-[cubic-bezier(0.2,0.8,0.2,1)] will-change-transform [&.is-collapsed]:translate-x-full max-md:w-[calc(100vw-52px)]"
  aria-label="音乐播放器"
  data-music-player
  transition:persist="marchen-music-player"
  transition:animate="none"
>
  <MusicPlayerControls client:only="solid-js" />

  <button
    class="absolute top-1/2 left-[-46px] inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-l-lg border border-r-0 border-border bg-surface-strong text-ink shadow-[-8px_8px_20px_var(--shadow-pop)] transition-[color,background] duration-fast ease-out touch-none select-none hover:bg-orange-soft hover:text-orange"
    type="button"
    aria-label="展开或折叠音乐播放器"
    data-music-toggle
  >
    <Icon name="Music2" size={17} />
  </button>

  <section
    class="overflow-hidden rounded-l-lg border border-r-0 border-border bg-[linear-gradient(var(--page-grid-y)_1px,transparent_1px),var(--surface-strong)] bg-[length:100%_28px,auto] shadow-pop-lift backdrop-blur-md"
    aria-label="音乐播放面板"
  >
    <div
      class="grid h-[var(--music-shell-height,108px)] grid-cols-[148px_minmax(0,1fr)] items-stretch gap-3 p-3 transition-[height] duration-200 ease-out max-md:h-[var(--music-shell-height,100px)] max-md:grid-cols-1 max-md:gap-0"
    >
      <div
        class="flex min-w-0 cursor-ns-resize flex-col items-start justify-center gap-1 border-r border-border-soft pr-3 touch-none select-none max-md:hidden"
        data-music-drag-handle
      >
        <span class="block max-w-full overflow-hidden text-ellipsis whitespace-nowrap text-2xs font-black tracking-normal text-orange uppercase">
          Now Playing
        </span>
        <strong class="block max-w-full overflow-hidden text-ellipsis whitespace-nowrap text-sm font-black text-ink">
          {hasPlaylist ? `${siteConfig.name} Playlist` : "等待配置歌单"}
        </strong>
      </div>
      <iframe
        class="block h-[var(--music-frame-height,84px)] min-w-0 w-full rounded-lg border-0 bg-transparent [color-scheme:light_dark] transition-[height] duration-200 ease-out max-md:h-[var(--music-frame-height,76px)]"
        data-src="/music-player-frame"
        title={`${siteConfig.name} Playlist`}
        loading="lazy"
        data-music-frame
      ></iframe>
    </div>
  </section>
</aside>
