---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Icon from "@/components/Icon.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  cover?: ImageMetadata;
  readingMinutes?: number;
  featured?: boolean;
}

const { href, title, description, date, tags = [], cover, readingMinutes = 1, featured = false } = Astro.props;
const dateLabel = date.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" });
const optimizedCover = cover
  ? await getImage({ src: cover, width: Math.min(368, cover.width), format: "webp", quality: 80 })
  : undefined;
---

<a
  class:list={[
    "grid items-stretch gap-4 border-b border-border-soft px-1 py-3.5 text-inherit transition-[background,color,transform] duration-fast ease-out first:border-t first:border-t-border-soft hover:translate-x-0.5 hover:text-blue max-sm:grid-cols-[92px_minmax(0,1fr)] max-sm:gap-3",
    featured ? "grid-cols-[184px_minmax(0,1fr)]" : "grid-cols-[124px_minmax(0,1fr)]",
  ]}
  href={href}
  data-astro-prefetch="hover"
  aria-label={`阅读：${title}`}
>
  <span class="block min-w-0 [&_.media-shell]:w-full [&_.media-shell]:rounded-md">
    <span class="media-shell">
      <img
        class:list={[
          "w-full rounded-md border border-border object-cover bg-paper-soft max-sm:h-[78px]",
          featured ? "h-[132px]" : "h-[92px]",
        ]}
        src="/images/image-placeholder.svg"
        data-media-src={optimizedCover?.src}
        alt=""
        loading="lazy"
      />
    </span>
  </span>
  <div class="grid min-w-0 content-center text-ink">
    <div class="flex flex-wrap items-center gap-2 text-xs font-extrabold text-muted">
      <time datetime={date.toISOString()}>{dateLabel}</time>
      <span class="inline-flex items-center gap-2">
        <Icon name="Clock3" size={14} /> {readingMinutes} 分钟
      </span>
    </div>
    <h3
      class:list={[
        "mt-1 mb-1 leading-snug tracking-normal text-ink max-sm:text-base",
        featured ? "text-xl" : "text-base",
      ]}
    >
      {title}
    </h3>
    <p class="m-0 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>
    <div class="bottom-line mt-2.5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2 max-sm:hidden">
        {tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
      </div>
      <span class="inline-flex items-center gap-2 whitespace-nowrap text-sm font-black text-blue">
        阅读全文 <Icon name="ArrowRight" size={15} />
      </span>
    </div>
  </div>
</a>
