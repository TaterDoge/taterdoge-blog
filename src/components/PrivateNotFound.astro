---
import Icon from "@/components/Icon.astro";
---

<section
  class="relative mt-2 grid min-h-[520px] content-center justify-items-center border-b border-border-soft px-0 py-7 text-center"
>
  <span class="tape" aria-hidden="true"></span>
  <Icon name="FileQuestion" size={58} class="text-blue" />
  <p class="eyebrow mt-4 text-sm">404</p>
  <h1 class="mt-2.5 mb-2 text-[clamp(2.3rem,5vw,4.2rem)] leading-tight">页面未找到</h1>
  <p class="m-0 max-w-narrow text-base text-muted">你访问的页面不存在，或者暂时还没开放</p>
  <a class="button mt-6 min-h-11 px-5 text-sm" href="/"><Icon name="ArrowLeft" size={18} /> 返回首页</a>
</section>
