---
import { getCollection } from "astro:content";
import Icon from "@/components/Icon.astro";
import { projects } from "@/data/projects";
import { siteConfig } from "@/data/site";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.visibility === "public")
  .sort((a, b) => {
    const dateA = (a.data.updatedDate ?? a.data.pubDate).valueOf();
    const dateB = (b.data.updatedDate ?? b.data.pubDate).valueOf();
    return dateB - dateA;
  });
const notes = (await getCollection("notes")).filter((note) => note.data.visibility === "public");
const latestPosts = posts.slice(0, 4);
const allTags = Array.from(new Set([...posts.flatMap((post) => post.data.tags), ...notes.flatMap((note) => note.data.tags)]));
const configuredLaunchDate = import.meta.env.SITE_LAUNCH_DATE ? new Date(import.meta.env.SITE_LAUNCH_DATE) : null;
const contentDates = [...posts.map((post) => post.data.pubDate), ...notes.map((note) => note.data.pubDate)]
  .filter((date) => !Number.isNaN(date.valueOf()))
  .sort((a, b) => a.valueOf() - b.valueOf());
const launchDate =
  configuredLaunchDate && !Number.isNaN(configuredLaunchDate.valueOf())
    ? configuredLaunchDate
    : (contentDates[0] ?? new Date());
const today = new Date();
const runDays = Math.max(1, Math.floor((today.valueOf() - launchDate.valueOf()) / 86400000) + 1);

const formatShortDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", {
    month: "2-digit",
    day: "2-digit",
  }).format(date);

const beliefItems = [
  {
    title: "保持好奇，持续创造",
    description: "记录想法、分享知识，在构建中探索更多可能。",
    icon: "Coffee",
    accent: "blue",
  },
  {
    title: "为热爱而构建",
    description: "专注于有价值的技术实践，追求简洁、可用与美感。",
    icon: "Leaf",
    accent: "green",
  },
  {
    title: "开放 · 分享 · 连接",
    description: "相信开源的力量，与更多开发者一起成长。",
    icon: "Heart",
    accent: "orange",
  },
];

const stats = [
  { label: "文章", value: posts.length, icon: "FileText", accent: "blue" },
  { label: "项目", value: projects.length, icon: "Box", accent: "green" },
  { label: "标签", value: allTags.length, icon: "Tag", accent: "orange" },
  { label: "运行天数", value: `${runDays}+`, icon: "Clock3", accent: "purple" },
];
---

<footer id="site-footer" class="site-footer relative z-10 overflow-hidden bg-transparent pt-1 text-ink" data-site-footer>
  <section class="page-shell relative -translate-y-0.5" aria-label="站点理念与订阅">
    <div class="belief-grid relative grid grid-cols-4 overflow-hidden rounded-lg border border-border-soft bg-surface-strong shadow-[0_24px_70px_rgba(36,57,95,0.1)]">
      {beliefItems.map((item) => (
        <article class={`belief-item belief-${item.accent} relative grid min-h-[196px] min-w-0 justify-items-center gap-3 px-[clamp(18px,3vw,34px)] py-[clamp(22px,3.2vw,40px)] text-center`}>
          <div class="relative grid h-[50px] w-[74px] place-items-center" aria-hidden="true">
            <Icon name={item.icon} size={38} strokeWidth={1.8} />
            <span class="absolute bottom-3 left-1 size-2 rounded-full bg-current opacity-30"></span>
            <span class="absolute top-2.5 right-1 size-2 rounded-full bg-current opacity-30"></span>
          </div>
          <h2 class="footer-title">{item.title}</h2>
          <p class="footer-desc">{item.description}</p>
          <i class="h-0.5 w-7 rounded-full bg-current" aria-hidden="true"></i>
        </article>
      ))}

      <article class="subscribe-panel relative grid min-w-0 content-center gap-3.5 border-l border-border-soft px-[clamp(18px,3vw,34px)] py-[clamp(22px,3.2vw,40px)]">
        <h2 class="footer-title">订阅更新</h2>
        <p class="footer-desc">输入邮箱，获取最新文章、项目和思考的更新通知。</p>
        <form class="subscribe-form grid grid-cols-[minmax(0,1fr)_48px] gap-2" data-footer-subscribe novalidate>
          <label class="sr-only" for="footer-email">订阅邮箱</label>
          <input
            id="footer-email"
            class="h-11 min-w-0 rounded-lg border border-border bg-surface-strong px-3.5 font-bold text-ink outline-0 transition-[border-color,box-shadow] duration-fast focus:border-blue focus:shadow-[0_0_0_4px_var(--focus-ring)] placeholder:text-sm"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            placeholder="your@email.com"
            required
          />
          <button
            class="grid h-11 w-12 place-items-center rounded-lg border border-[color-mix(in_srgb,var(--blue)_82%,var(--ink))] bg-blue text-on-accent shadow-[0_10px_18px_color-mix(in_srgb,var(--blue)_22%,transparent)] transition-[filter,box-shadow] duration-fast hover:border-[color-mix(in_srgb,var(--blue)_74%,var(--ink))] hover:bg-[color-mix(in_srgb,var(--blue)_74%,var(--ink))] hover:brightness-105 hover:shadow-[0_0_0_4px_color-mix(in_srgb,var(--blue)_16%,transparent),0_12px_22px_color-mix(in_srgb,var(--blue)_28%,transparent)]"
            type="submit"
            aria-label="订阅更新"
          >
            <Icon name="ArrowRight" size={22} strokeWidth={2.4} />
          </button>
        </form>
        <p class="subscribe-message min-h-[1.35em] text-xs font-extrabold" data-subscribe-message aria-live="polite"></p>
      </article>
    </div>
  </section>

  <section class="footer-main mt-8 border-y border-border-soft">
    <div class="page-shell footer-main-grid grid min-h-[248px] grid-cols-[1.18fr_1.16fr_1fr_1.1fr] items-center gap-[clamp(26px,4vw,56px)] py-10">
      <article class="min-w-0">
        <div class="brand-row flex items-center gap-4">
          <img
            class="size-[76px] shrink-0 rounded-full border border-border object-cover shadow-soft-lift"
            src={siteConfig.avatar}
            alt={`${siteConfig.name} 头像`}
            width="96"
            height="96"
            loading="lazy"
            decoding="async"
            data-no-media-shell="true"
          />
          <a class="inline-flex items-center gap-3 text-blue" href="/" aria-label={`${siteConfig.name} 首页`}>
            <Icon name="Code2" size={34} strokeWidth={2.5} />
            <strong class="font-hand text-2xl font-bold leading-none text-ink">{siteConfig.name}</strong>
          </a>
        </div>
        <p class="my-4 mb-5 text-sm leading-loose text-muted">{siteConfig.description}。希望这些内容能为你带来一些启发。</p>
        <nav class="flex flex-wrap gap-2.5" aria-label="社交链接">
          {siteConfig.socials.map((item) => (
            <a
              class="grid size-9 place-items-center rounded-lg border border-border bg-surface-strong text-ink-2 shadow-soft-card transition-[border-color,color,background,transform] duration-fast hover:-translate-y-px hover:border-blue hover:bg-blue-soft hover:text-blue"
              href={item.href}
              title={item.name}
              aria-label={item.name}
            >
              <Icon name={item.icon} size={18} strokeWidth={2.2} />
            </a>
          ))}
        </nav>
      </article>

      <article class="min-w-0">
        <h2 class="mb-5 inline-flex items-center gap-3 footer-title">
          <span class="title-dot border-blue shadow-[0_0_0_4px_color-mix(in_srgb,var(--blue)_12%,transparent)]"></span>
          最近更新
        </h2>
        <ol class="m-0 grid list-none gap-0 p-0">
          {latestPosts.map((post) => (
            <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3.5 border-b border-border-soft py-2 text-sm text-ink-2">
              <a class="latest-link relative overflow-hidden pl-4 whitespace-nowrap text-ellipsis font-extrabold transition-colors duration-fast hover:text-blue" href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
              <time class="text-xs text-muted tabular-nums" datetime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}>
                {formatShortDate(post.data.updatedDate ?? post.data.pubDate)}
              </time>
            </li>
          ))}
        </ol>
      </article>

      <article class="min-w-0">
        <h2 class="mb-5 inline-flex items-center gap-3 footer-title">
          <span class="title-dot border-green shadow-[0_0_0_4px_color-mix(in_srgb,var(--green)_12%,transparent)]"></span>
          站点统计
        </h2>
        <dl class="stats-list m-0 grid grid-cols-2 gap-x-7 gap-y-6">
          {stats.map((item) => (
            <div class={`stat-${item.accent} grid grid-cols-[46px_minmax(0,1fr)] items-center gap-3`}>
              <dt class="contents text-xs font-extrabold text-muted">
                <span class="row-span-2 grid size-12 place-items-center rounded-full border border-current bg-[color-mix(in_srgb,currentColor_12%,var(--surface-strong))] shadow-[0_10px_20px_color-mix(in_srgb,currentColor_12%,transparent)]" aria-hidden="true">
                  <Icon name={item.icon} size={24} strokeWidth={2.1} />
                </span>
                <b class="font-[inherit] whitespace-nowrap">{item.label}</b>
              </dt>
              <dd class="m-0 text-xl font-black leading-none text-ink">{item.value}</dd>
            </div>
          ))}
        </dl>
      </article>

      <div class="footer-illustration relative flex min-h-[170px] justify-center" aria-hidden="true">
        <img
          class="absolute bottom-2.5 left-[5%] w-[108px] drop-shadow-[0_16px_20px_var(--shadow-soft)]"
          src="/images/decorative_element/sprite3.webp"
          alt=""
          loading="lazy"
          decoding="async"
          data-no-media-shell="true"
        />
        <div class="absolute right-[2%] bottom-4 min-h-[102px] w-[136px] rotate-[-5deg] border-2 border-[color-mix(in_srgb,var(--line-blue)_65%,transparent)] bg-surface-strong px-3.5 pt-6 pb-3 text-muted">
          <span class="absolute -top-2.5 left-[34px] h-[15px] w-[62px] rotate-[-7deg] bg-[rgba(174,204,255,0.72)]"></span>
          <p class="m-0 font-hand text-base leading-snug">Stay curious.<br />Keep building.</p>
          <Icon class="absolute right-2.5 bottom-2 text-line-blue" name="Code2" size={18} />
        </div>
      </div>
    </div>
  </section>

  <section class="footer-quote border-b border-border-soft" aria-label="页脚引用">
    <div class="page-shell flex min-h-[100px] items-center justify-center gap-7">
      <span class="size-1.5 rounded-full border-2 border-blue opacity-60" aria-hidden="true"></span>
      <p class="m-0 inline-flex items-center gap-3 text-sm text-ink-2">
        <Icon class="size-12 rounded-full border border-line-blue bg-surface-strong p-2.5 text-blue shadow-soft-card" name="Quote" size={26} />
        <em class="font-hand text-lg not-italic text-ink-2">Stay curious.</em>
        保持好奇，才能走得更远。
      </p>
      <span class="size-1.5 rounded-full border-2 border-blue opacity-60" aria-hidden="true"></span>
    </div>
  </section>

  <section class="bg-[color-mix(in_srgb,var(--surface-strong)_78%,transparent)]">
    <div class="page-shell bottom-row flex min-h-16 items-center justify-between gap-4 text-xs text-muted">
      <p class="m-0 flex flex-wrap items-center gap-2.5">
        &copy; 2026 {siteConfig.name} <span>·</span> Built with Astro &amp; Tailwind CSS <span>·</span> &lt;3 from Chengdu, China
      </p>
      <nav class="flex flex-wrap items-center gap-2.5" aria-label="页脚辅助链接">
        <a class="inline-flex items-center gap-2 font-extrabold text-muted transition-colors duration-fast hover:text-blue" href="/" aria-label="在线状态">
          <span class="online-dot size-2 rounded-full bg-green shadow-[0_0_0_4px_color-mix(in_srgb,var(--green)_15%,transparent)]"></span>
          在线状态
        </a>
        <i class="h-[18px] w-px bg-border" aria-hidden="true"></i>
        <a class="font-extrabold text-muted transition-colors duration-fast hover:text-blue" href="/rss.xml">RSS</a>
        <i class="h-[18px] w-px bg-border" aria-hidden="true"></i>
        <a class="font-extrabold text-muted transition-colors duration-fast hover:text-blue" href="https://beian.miit.gov.cn/" rel="noreferrer">蜀ICP备2024001234号-1</a>
      </nav>
    </div>
  </section>
</footer>

<script>
  function initFooterSubscribe() {
    const form = document.querySelector("[data-footer-subscribe]");
    if (!(form instanceof HTMLFormElement) || form.dataset.ready === "true") return;
    form.dataset.ready = "true";

    const input = form.querySelector("input[type='email']");
    const button = form.querySelector("button");
    const message = form.closest("[data-site-footer]")?.querySelector("[data-subscribe-message]");
    const storageKey = "marchen_footer_subscribers";
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const setMessage = (text: string, state: string) => {
      if (!(message instanceof HTMLElement)) return;
      message.textContent = text;
      message.dataset.state = state;
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(input instanceof HTMLInputElement)) return;

      const email = input.value.trim().toLowerCase();
      if (!emailPattern.test(email)) {
        input.focus();
        setMessage("请输入有效的邮箱地址。", "error");
        return;
      }

      let subscribers = [];
      try {
        subscribers = JSON.parse(localStorage.getItem(storageKey) || "[]");
      } catch {
        subscribers = [];
      }

      if (!Array.isArray(subscribers)) subscribers = [];
      const exists = subscribers.includes(email);
      if (!exists) {
        subscribers.push(email);
        localStorage.setItem(storageKey, JSON.stringify(subscribers));
      }

      input.value = "";
      setMessage(exists ? "这个邮箱已经订阅过了。" : "已记录订阅，后续更新会优先通知你。", "success");
      button?.animate(
        [
          { transform: "translateX(0)" },
          { transform: "translateX(3px)" },
          { transform: "translateX(0)" },
        ],
        { duration: 240, easing: "ease-out" }
      );
    });
  }

  initFooterSubscribe();
  document.addEventListener("astro:page-load", initFooterSubscribe);
  document.addEventListener("astro:after-swap", initFooterSubscribe);
</script>

