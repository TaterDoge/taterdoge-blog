---
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";

const pathname = Astro.url.pathname;
const navItems = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "博客" },
  { href: "/projects", label: "项目" },
  { href: "/tools", label: "工具" },
  { href: "/favorites", label: "收藏" },
  { href: "/kb", label: "知识库", private: true },
  { href: "/about", label: "关于" },
];

const isActive = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
const pagefindEnabled = import.meta.env.PROD;
---

<header
  class="site-header sticky top-0 z-40 border-b border-border bg-header-bg backdrop-blur-md"
  data-site-header
>
  <div class="page-shell header-inner grid min-h-16 grid-cols-[236px_minmax(0,1fr)_auto] items-center gap-6">
    <a class="inline-flex min-w-0 items-center gap-2.5" href="/" aria-label={`${siteConfig.name} 首页`}>
      <span class="brand-mark text-3xl font-black leading-none text-blue">&lt;/&gt;</span>
      <span class="block min-w-0">
        <strong class="block min-w-0 font-hand text-2xl font-black leading-none text-ink">{siteConfig.name}</strong>
        <small class="brand-tagline mt-0.5 block min-w-0 text-2xs font-extrabold leading-tight text-muted">
          notes / ideas / daily
        </small>
      </span>
    </a>

    <nav class="nav-links flex min-w-0 justify-center gap-7" aria-label="主导航" style="--nav-letter-spacing: 0.5em">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={["nav-link relative inline-flex items-center justify-center whitespace-nowrap py-6 pb-5 text-center text-sm font-black text-nav-text transition-colors duration-500", { active: isActive(item.href), "private-link": item.private }]}
          data-private-link={item.private ? "true" : undefined}
        >
          <span class="inline-block tracking-[var(--nav-letter-spacing)] -mr-[var(--nav-letter-spacing)]">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions inline-flex items-center justify-end gap-2">
      <button class="nav-toggle size-9 place-items-center rounded-md border-0 bg-transparent text-ink transition-colors duration-fast" type="button" data-nav-toggle aria-label="打开导航" aria-expanded="false">
        <span class="nav-icon open col-start-1 row-start-1 grid place-items-center transition duration-fast"><Icon name="Menu" size={20} /></span>
        <span class="nav-icon close col-start-1 row-start-1 grid place-items-center transition duration-fast"><Icon name="X" size={20} /></span>
      </button>
      <button class="theme-toggle relative grid size-9 place-items-center rounded-md border-0 bg-transparent text-ink transition-colors duration-fast" type="button" data-theme-toggle aria-label="切换夜间模式" title="切换夜间模式">
        <span class="theme-icon light col-start-1 row-start-1 grid place-items-center transition duration-fast"><Icon name="Sun" size={19} /></span>
        <span class="theme-icon dark col-start-1 row-start-1 grid place-items-center transition duration-fast"><Icon name="Moon" size={19} /></span>
      </button>
      <button class="search-toggle grid size-9 place-items-center rounded-md border-0 bg-transparent text-ink transition-colors duration-fast" type="button" data-search-toggle aria-label="打开搜索" aria-expanded="false" aria-controls="search-panel">
        <Icon name="Search" size={20} />
      </button>
      {siteConfig.socials
        .filter((item) => item.inHeader)
        .map((item) => (
          <a class="grid size-9 place-items-center rounded-md text-ink transition-colors duration-fast" href={item.href} aria-label={item.name}>
            <Icon name={item.icon} size={20} />
          </a>
        ))}
    </div>
  </div>

  <dialog id="search-panel" class="search-panel" data-search-panel data-search-production={String(pagefindEnabled)} aria-labelledby="search-panel-title" aria-modal="true" aria-hidden="true" data-pagefind-ignore inert>
    <h2 id="search-panel-title" class="sr-only">站内搜索</h2>
    <div class="search-box" role="search">
      <div class="search-field">
        <Icon name="Search" size={20} />
        <label class="sr-only" for="site-search-input">搜索文章</label>
        <input id="site-search-input" type="search" inputmode="search" autocomplete="off" placeholder="搜索文章、关键字..." data-search-input />
        <span class="search-shortcut" aria-hidden="true">Esc</span>
      </div>
      <div class="search-status text-sm text-muted" data-search-status role="status" aria-live="polite">输入关键词搜索全部文章</div>
      <ul class="search-results" data-search-results></ul>
    </div>
  </dialog>
  <button class="nav-backdrop" type="button" data-nav-backdrop aria-label="关闭导航"></button>
</header>

<script src="../scripts/header.ts" />

