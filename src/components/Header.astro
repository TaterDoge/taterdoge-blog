---
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";

const pathname = Astro.url.pathname;
const navItems = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "博客" },
  { href: "/notes", label: "碎念" },
  { href: "/projects", label: "项目" },
  { href: "/tools", label: "工具" },
  { href: "/favorites", label: "收藏" },
  { href: "/kb", label: "知识库", private: true },
  { href: "/about", label: "关于" },
];

const isActive = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header
  class="site-header sticky top-0 z-40 border-b border-border bg-header-bg backdrop-blur-md"
  data-site-header
>
  <div class="page-shell header-inner grid min-h-16 grid-cols-[236px_minmax(0,1fr)_auto] items-center gap-6">
    <a class="inline-flex min-w-0 items-center gap-2.5" href="/" aria-label={`${siteConfig.name} 首页`}>
      <span class="brand-mark text-3xl font-black leading-none text-blue">&lt;/&gt;</span>
      <span class="block min-w-0">
        <strong class="block min-w-0 font-hand text-2xl font-black leading-none text-ink">{siteConfig.name}</strong>
        <small class="brand-tagline mt-0.5 block min-w-0 text-2xs font-extrabold leading-tight text-muted">
          notes / ideas / daily
        </small>
      </span>
    </a>

    <nav class="nav-links flex min-w-0 justify-center gap-7" aria-label="主导航" style="--nav-letter-spacing: 0.5em">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={["nav-link relative inline-flex items-center justify-center whitespace-nowrap py-6 pb-5 text-center text-sm font-black text-nav-text transition-colors duration-500", { active: isActive(item.href), "private-link": item.private }]}
          data-private-link={item.private ? "true" : undefined}
        >
          <span class="inline-block tracking-[var(--nav-letter-spacing)] -mr-[var(--nav-letter-spacing)]">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions inline-flex items-center justify-end gap-2">
      <button class="nav-toggle grid size-9 place-items-center rounded-md border-0 bg-transparent text-ink transition-colors duration-fast" type="button" data-nav-toggle aria-label="打开导航" aria-expanded="false">
        <span class="nav-icon open col-start-1 row-start-1 grid place-items-center transition duration-fast"><Icon name="Menu" size={20} /></span>
        <span class="nav-icon close col-start-1 row-start-1 grid place-items-center transition duration-fast"><Icon name="X" size={20} /></span>
      </button>
      <button class="theme-toggle relative grid size-9 place-items-center rounded-md border-0 bg-transparent text-ink transition-colors duration-fast" type="button" data-theme-toggle aria-label="切换夜间模式" title="切换夜间模式">
        <span class="theme-icon light col-start-1 row-start-1 grid place-items-center transition duration-fast"><Icon name="Sun" size={19} /></span>
        <span class="theme-icon dark col-start-1 row-start-1 grid place-items-center transition duration-fast"><Icon name="Moon" size={19} /></span>
      </button>
      <a class="grid size-9 place-items-center rounded-md text-ink transition-colors duration-fast" href="/blog#search" aria-label="搜索">
        <Icon name="Search" size={20} />
      </a>
      <a class="grid size-9 place-items-center rounded-md text-ink transition-colors duration-fast" href="/rss.xml" aria-label="RSS">
        <Icon name="Rss" size={20} />
      </a>
      <a class="grid size-9 place-items-center rounded-md text-ink transition-colors duration-fast" href="https://github.com/marchen-orz" aria-label="GitHub">
        <Icon name="Github" size={20} />
      </a>
    </div>
  </div>
  <button class="nav-backdrop" type="button" data-nav-backdrop aria-label="关闭导航"></button>
</header>

<script is:inline>
  async function syncPrivateNav() {
    let hasPrivateAccess = false;
    try {
      const response = await fetch("/api/private/check", {
        cache: "no-store",
        credentials: "same-origin",
      });
      if (response.ok) {
        const data = await response.json();
        hasPrivateAccess = Boolean(data?.enabled);
      }
    } catch {
      hasPrivateAccess = false;
    }

    document.querySelectorAll("[data-private-link='true']").forEach((link) => {
      link.classList.toggle("is-visible", hasPrivateAccess);
    });
    document.querySelectorAll("[data-private-action]").forEach((action) => {
      if (action instanceof HTMLElement) action.hidden = !hasPrivateAccess;
    });
  }

  window.__marchenSyncPrivateNav = syncPrivateNav;
  syncPrivateNav();
  if (!window.__marchenPrivateNavBound) {
    document.addEventListener("DOMContentLoaded", () => window.__marchenSyncPrivateNav?.(), { once: true });
    document.addEventListener("astro:page-load", () => window.__marchenSyncPrivateNav?.());
    document.addEventListener("astro:after-swap", () => window.__marchenSyncPrivateNav?.());
    window.__marchenPrivateNavBound = true;
  }

  function syncThemeToggle() {
    const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
      button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
      button.setAttribute("title", theme === "dark" ? "切换浅色模式" : "切换夜间模式");
    });
  }

  function toggleTheme() {
    const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem("marchen_theme", nextTheme);
    syncThemeToggle();
  }

  window.__marchenSyncThemeToggle = syncThemeToggle;
  syncThemeToggle();
  if (!window.__marchenThemeToggleBound) {
    document.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-theme-toggle]")) {
        toggleTheme();
      }
    });
    document.addEventListener("astro:page-load", () => window.__marchenSyncThemeToggle?.());
    document.addEventListener("astro:after-swap", () => window.__marchenSyncThemeToggle?.());
    window.__marchenThemeToggleBound = true;
  }

  function setMobileNav(open) {
    document.documentElement.classList.toggle("nav-open", open);
    document.querySelectorAll("[data-nav-toggle]").forEach((button) => {
      button.setAttribute("aria-expanded", open ? "true" : "false");
      button.setAttribute("aria-label", open ? "关闭导航" : "打开导航");
    });
  }

  if (!window.__marchenMobileNavBound) {
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest("[data-nav-toggle]")) {
        setMobileNav(!document.documentElement.classList.contains("nav-open"));
        return;
      }
      if (event.target.closest("[data-nav-backdrop]") || event.target.closest(".nav-links a")) {
        setMobileNav(false);
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMobileNav(false);
    });
    document.addEventListener("astro:after-swap", () => setMobileNav(false));
    window.__marchenMobileNavBound = true;
  }
</script>

