---
import Icon from "@/components/Icon.astro";

interface Props {
  project: {
    name: string;
    description: string;
    techStack: string[];
    cover: string;
    github: string;
    demo: string;
    status: string;
  };
  variant?: "home" | "page";
}

const { project, variant = "home" } = Astro.props;
const hasDemo = Boolean(project.demo && project.demo !== "#");
const hasGithub = Boolean(project.github && project.github !== "#");
const targetHref = hasDemo ? project.demo : hasGithub ? project.github : "/projects";
const isExternal = (href: string) => href.startsWith("http");
---

<article
  class:list={[
    "group relative grid grid-cols-[136px_minmax(0,1fr)] gap-4 border-b border-border-soft px-1 py-3.5 transition-[background,color,transform,border-color] duration-fast ease-out max-sm:grid-cols-[92px_minmax(0,1fr)]",
    variant === "home" && "hover:translate-x-0.5 hover:text-blue",
    variant === "page" && "hover:bg-[color-mix(in_srgb,var(--blue)_7%,transparent)] hover:text-ink",
  ]}
>
  <a
    class="absolute inset-0 z-10 rounded-md"
    href={targetHref}
    target={isExternal(targetHref) ? "_blank" : undefined}
    rel={isExternal(targetHref) ? "noreferrer" : undefined}
    aria-label={`打开项目：${project.name}`}
  ></a>

  <a
    class="block min-w-0 [&_.media-shell]:w-full [&_.media-shell]:rounded-md"
    href={targetHref}
    target={isExternal(targetHref) ? "_blank" : undefined}
    rel={isExternal(targetHref) ? "noreferrer" : undefined}
    aria-label={`查看项目：${project.name}`}
    tabindex="-1"
  >
    <img
      class="aspect-square h-auto w-full rounded-md border border-border object-cover bg-paper-soft"
      src="/images/image-placeholder.svg"
      data-media-src={project.cover}
      alt={`${project.name} 项目截图`}
      loading="lazy"
    />
  </a>

  <div class="block min-w-0">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span class="text-xs font-black text-orange">{project.status}</span>
      <span class="relative z-20 flex flex-wrap items-center gap-2">
        {
          hasDemo && (
            <a
              class="icon-link"
              href={project.demo}
              target={isExternal(project.demo) ? "_blank" : undefined}
              rel={isExternal(project.demo) ? "noreferrer" : undefined}
              aria-label={`${project.name} 演示地址`}
            >
              <Icon name="ExternalLink" size={16} />
            </a>
          )
        }
        {
          hasGithub && (
            <a
              class="icon-link"
              href={project.github}
              target="_blank"
              rel="noreferrer"
              aria-label={`${project.name} GitHub 仓库`}
            >
              <Icon name="Github" size={16} />
            </a>
          )
        }
      </span>
    </div>

    <h3 class="mt-1 mb-2 text-base leading-snug">
      <a
        class="transition-colors duration-fast ease-out group-hover:text-blue hover:text-blue"
        href={targetHref}
        target={isExternal(targetHref) ? "_blank" : undefined}
        rel={isExternal(targetHref) ? "noreferrer" : undefined}
        tabindex="-1"
      >
        {project.name}
      </a>
    </h3>
    <p class="m-0 line-clamp-2 text-sm leading-relaxed text-muted">{project.description}</p>
    <span class="mt-3 flex flex-wrap items-center gap-2">
      {
        project.techStack.map((item) => (
          <span class="rounded-md border border-tag-border bg-note-blue-bg px-2 py-0.5 text-2xs font-extrabold text-tag-text">
            {item}
          </span>
        ))
      }
    </span>
  </div>
</article>

