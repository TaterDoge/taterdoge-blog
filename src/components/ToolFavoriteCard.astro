---
import Icon from "@/components/Icon.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  label?: string;
}

const { title, description, href, icon, label } = Astro.props;
---

<a
  class="group mb-2.5 grid min-h-[78px] grid-cols-[36px_minmax(0,1fr)] gap-2.5 rounded-lg border border-border bg-surface p-3 shadow-none transition-[background,border-color,color,transform] duration-fast ease-out hover:border-line-blue hover:bg-surface-soft hover:text-blue"
  href={href}
>
  <span class="grid size-9 place-items-center rounded-md border border-tag-border bg-blue-soft text-blue">
    <Icon name={icon} size={21} />
  </span>
  <span class="block min-w-0 not-italic">
    <span class="flex min-w-0 items-center justify-between gap-2.5">
      <strong class="block min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-sm font-bold leading-tight text-ink not-italic transition-colors duration-fast ease-out group-hover:text-blue">
        {title}
      </strong>
      {
        label && (
          <small class="shrink-0 rounded-full bg-orange-soft px-2 py-px text-2xs font-black text-orange">
            {label}
          </small>
        )
      }
    </span>
    <em class="mt-1 line-clamp-2 block min-w-0 text-sm leading-normal text-muted not-italic">
      {description}
    </em>
  </span>
</a>
