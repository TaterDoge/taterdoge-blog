---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";
import { getReadingMinutes } from "@/lib/reading-time";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.visibility === "public")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags)));
const categories = Array.from(new Set(posts.map((post) => post.data.category)));
const totalMinutes = posts.reduce((sum, post) => sum + getReadingMinutes(post.body), 0);
const tagCounts = new Map(tags.map((tag) => [tag, posts.filter((post) => post.data.tags.includes(tag)).length]));
---

<BaseLayout title="博客" description={`${siteConfig.name} 的文章、随笔和记录`}>
  <div class="page-shell page">
    <section class="page-intro">
      <div>
        <p class="eyebrow">Articles</p>
        <h1>文章归档</h1>
        <p>文章、随笔和学习心得按时间排好队，先看阅读时间，再决定现在读还是晚点翻</p>
      </div>
      <aside class="intro-note">
        <span>认真写，写给自己看</span>
        <a class="private-publish" href="/admin/publish?type=blog" data-private-action hidden>
          <Icon name="PencilLine" size={16} /> 发布文章
        </a>
      </aside>
    </section>

    <section class="archive-layout" data-blog-archive>
      <main class="archive-main">
        <section id="search" class="search-line">
          <Icon name="Search" size={19} />
          <input type="search" placeholder="搜索文章、关键字..." aria-label="搜索文章" data-blog-search />
          <button type="button">搜索</button>
        </section>

        <div class="tag-row" aria-label="文章标签">
          <button class="tag active" type="button" data-tag-filter="all">全部 <span>{posts.length}</span></button>
          {tags.map((tag) => (
            <button class="tag" type="button" data-tag-filter={tag}>
              #{tag} <span>{tagCounts.get(tag)}</span>
            </button>
          ))}
        </div>

        <section class="post-list" aria-live="polite">
          {posts.map((post, index) => (
            <div
              class="post-item"
              data-post-item
              data-category={post.data.category}
              data-tags={post.data.tags.join("|")}
              data-search={`${post.data.title} ${post.data.description} ${post.data.category} ${post.data.tags.join(" ")} ${post.body}`.toLocaleLowerCase()}
            >
              <ArticleCard
                href={`/blog/${post.id}`}
                title={post.data.title}
                description={post.data.description}
                date={post.data.pubDate}
                tags={post.data.tags}
                cover={post.data.cover?.src}
                readingMinutes={getReadingMinutes(post.body)}
                featured={index === 0}
              />
            </div>
          ))}
          <p class="empty-state" data-empty-state hidden>没有匹配到文章，换个关键词试试</p>
        </section>
      </main>

      <aside class="archive-rail">
        <section class="rail-note">
          <h2>归档概览</h2>
          <dl>
            <div><dt>文章</dt><dd>{posts.length}</dd></div>
            <div><dt>分类</dt><dd>{categories.length}</dd></div>
            <div><dt>阅读</dt><dd>{totalMinutes} 分钟</dd></div>
          </dl>
        </section>

        <section class="rail-note">
          <h2>分类</h2>
          <div class="category-list">
            <button class="active" type="button" data-category-filter="all">
              <b>全部文章</b>
              <em>{posts.length}</em>
            </button>
            {categories.map((category) => (
              <button type="button" data-category-filter={category}>
                <b>{category}</b>
                <em>{posts.filter((post) => post.data.category === category).length}</em>
              </button>
            ))}
          </div>
        </section>
      </aside>
    </section>

    <script>
      function initBlogArchive() {
        const archive = document.querySelector("[data-blog-archive]");
        if (!(archive instanceof HTMLElement) || archive.dataset.ready === "true") return;
        archive.dataset.ready = "true";

        const searchInput = archive.querySelector("[data-blog-search]");
        const searchButton = archive.querySelector(".search-line button");
        const postItems = Array.from(archive.querySelectorAll("[data-post-item]"));
        const tagButtons = Array.from(archive.querySelectorAll("[data-tag-filter]"));
        const categoryButtons = Array.from(archive.querySelectorAll("[data-category-filter]"));
        const emptyState = archive.querySelector("[data-empty-state]");
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const state = {
          query: "",
          tag: "all",
          category: "all",
        };

        const getPostTags = (item) => (item instanceof HTMLElement ? (item.dataset.tags ?? "").split("|").filter(Boolean) : []);
        const matchesBaseFilters = (item) => {
          if (!(item instanceof HTMLElement)) return false;
          const searchText = item.dataset.search ?? "";
          const category = item.dataset.category ?? "";
          return (!state.query || searchText.includes(state.query)) && (state.category === "all" || category === state.category);
        };

        const refreshTagList = () => {
          const available = new Map();
          const baseItems = postItems.filter(matchesBaseFilters);

          baseItems.forEach((item) => {
            getPostTags(item).forEach((tag) => {
              available.set(tag, (available.get(tag) ?? 0) + 1);
            });
          });

          if (state.tag !== "all" && !available.has(state.tag)) {
            state.tag = "all";
          }

          tagButtons.forEach((button) => {
            if (!(button instanceof HTMLElement)) return;
            const tag = button.dataset.tagFilter ?? "all";
            const count = tag === "all" ? baseItems.length : available.get(tag) ?? 0;
            button.hidden = tag !== "all" && count === 0;
            button.classList.toggle("active", state.tag === tag);
            const countNode = button.querySelector("span");
            if (countNode) countNode.textContent = String(count);
          });
        };

        const revealPosts = (items) => {
          if (prefersReducedMotion.matches) return;
          requestAnimationFrame(() => {
            items.forEach((item, index) => {
              if (!(item instanceof HTMLElement)) return;
              item.style.setProperty("--filter-index", String(index));
              item.classList.add("is-visible");
            });
          });
        };

        const applyFilters = () => {
          const rawQuery = searchInput instanceof HTMLInputElement ? searchInput.value : "";
          state.query = rawQuery.trim().toLocaleLowerCase();
          postItems.forEach((item) => {
            if (item instanceof HTMLElement) item.classList.remove("is-visible");
          });
          refreshTagList();

          let visibleCount = 0;
          const visibleItems = [];
          postItems.forEach((item) => {
            if (!(item instanceof HTMLElement)) return;
            const matchesTag = state.tag === "all" || getPostTags(item).includes(state.tag);
            const visible = matchesBaseFilters(item) && matchesTag;
            item.hidden = !visible;
            visibleCount += visible ? 1 : 0;
            if (visible) visibleItems.push(item);
          });

          categoryButtons.forEach((button) => {
            if (!(button instanceof HTMLElement)) return;
            button.classList.toggle("active", button.dataset.categoryFilter === state.category);
          });

          if (emptyState instanceof HTMLElement) {
            emptyState.hidden = visibleCount > 0;
          }

          revealPosts(visibleItems);
        };

        searchInput?.addEventListener("input", applyFilters);
        searchButton?.addEventListener("click", applyFilters);
        tagButtons.forEach((button) => {
          button.addEventListener("click", () => {
            if (!(button instanceof HTMLElement)) return;
            state.tag = button.dataset.tagFilter ?? "all";
            applyFilters();
          });
        });
        categoryButtons.forEach((button) => {
          button.addEventListener("click", () => {
            if (!(button instanceof HTMLElement)) return;
            state.category = button.dataset.categoryFilter ?? "all";
            applyFilters();
          });
        });

        applyFilters();
      }

      initBlogArchive();
      document.addEventListener("astro:page-load", initBlogArchive);
    </script>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 24px;
  }

  .archive-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 28px;
    align-items: start;
  }

  .archive-main {
    min-width: 0;
  }

  .search-line {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-soft);
  }

  input {
    min-width: 0;
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
  }

  .search-line button,
  .category-list button {
    border: 1px solid var(--tag-border);
    border-radius: 5px;
    background: var(--blue-soft);
    padding: 5px 10px;
    color: var(--blue);
    font-size: 0.82rem;
    font-weight: 900;
    transition:
      background 220ms ease-out,
      border-color 220ms ease-out,
      color 220ms ease-out,
      box-shadow 220ms ease-out,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tag-row {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    flex-wrap: nowrap;
    gap: 8px;
    margin: 14px 0 12px;
    padding: 0 0 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }

  .tag {
    position: relative;
    flex: 0 0 auto;
    gap: 4px;
    min-height: 24px;
    border-radius: 5px;
    padding: 2px 8px;
    font-size: 0.74rem;
    font-weight: 800;
    white-space: nowrap;
    transition:
      background 220ms ease-out,
      border-color 220ms ease-out,
      color 220ms ease-out,
      opacity 180ms ease-out,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tag span {
    font-size: 0.68rem;
    opacity: 0.78;
  }

  .tag[hidden] {
    display: none;
  }

  .tag.active,
  .category-list button.active {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--on-accent);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--blue) 18%, transparent);
    transform: translateY(-1px);
  }

  .tag:hover {
    border-color: var(--blue);
    background: var(--blue-soft);
    color: var(--blue);
  }

  .tag.active:hover {
    background: var(--blue);
    color: var(--on-accent);
  }

  .category-list button:hover {
    border-color: var(--blue);
    transform: translateY(-1px);
  }

  .post-list {
    display: grid;
  }

  .post-item {
    opacity: 1;
  }

  .post-item.is-visible {
    animation: filter-post-in 260ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: min(calc(var(--filter-index) * 34ms), 170ms);
  }

  @keyframes filter-post-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-item[hidden],
  .empty-state[hidden] {
    display: none;
  }

  .empty-state {
    margin: 18px 0 0;
    border: 1px dashed var(--border-strong);
    border-radius: 8px;
    padding: 18px;
    color: var(--muted);
    font-size: 0.92rem;
    text-align: center;
  }

  .archive-rail {
    position: sticky;
    top: 94px;
    display: grid;
    gap: 20px;
  }

  .rail-note {
    padding: 16px 0;
    border-bottom: 1px solid var(--border-soft);
  }

  .rail-note h2 {
    margin: 0 0 12px;
    font-size: 1rem;
  }

  dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  dl div,
  .category-list button {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  dt,
  dd,
  em {
    margin: 0;
    font-style: normal;
  }

  dd,
  .category-list em {
    color: var(--blue);
    font-weight: 900;
  }

  .category-list {
    display: grid;
    gap: 9px;
  }

  .category-list button {
    position: relative;
    width: 100%;
    border-color: transparent;
    background: transparent;
    padding: 7px 8px;
    text-align: left;
  }

  .category-list button::before {
    position: absolute;
    top: 50%;
    left: -2px;
    width: 3px;
    height: 0;
    border-radius: 999px;
    background: currentColor;
    content: "";
    opacity: 0;
    transform: translateY(-50%);
    transition:
      height 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 180ms ease-out;
  }

  .category-list button.active::before {
    height: 18px;
    opacity: 1;
  }

  .category-list b {
    color: var(--ink);
  }

  .category-list button.active b,
  .category-list button.active em {
    color: inherit;
  }

  @media (max-width: 860px) {
    .archive-layout {
      grid-template-columns: 1fr;
    }

    .archive-rail {
      position: static;
      order: -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .archive-rail {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag,
    .search-line button,
    .category-list button,
    .post-item.is-visible {
      animation: none;
      transition: none;
    }
  }
</style>
