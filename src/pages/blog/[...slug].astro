---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ArticleCard from "@/components/blog/ArticleCard.tsx";
import { siteConfig } from "@/data/site";
import { getReadingMinutes } from "@/lib/reading-time";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((entry) => !entry.data.draft && entry.data.visibility === "public")
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = (await getCollection("blog"))
  .filter((entry) => !entry.data.draft && entry.data.visibility === "public")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = allPosts.findIndex((entry) => entry.id === post.id);
const others = allPosts.filter((entry) => entry.id !== post.id);
const relatedPosts = [
  ...others.filter((entry) => entry.data.category === post.data.category),
  ...others.filter((entry) => entry.data.category !== post.data.category),
].slice(0, 3);
const relatedCovers = await Promise.all(
  relatedPosts.map(async (entry) =>
    entry.data.cover
      ? (await getImage({ src: entry.data.cover, width: Math.min(368, entry.data.cover.width), format: "webp", quality: 80 })).src
      : undefined,
  ),
);
const readingMinutes = getReadingMinutes(post.body);
const heroCover = post.data.cover
  ? await getImage({ src: post.data.cover, width: Math.min(960, post.data.cover.width), format: "webp", quality: 82 })
  : undefined;
const tocTree: Array<{ slug: string; text: string; children: Array<{ slug: string; text: string }> }> = [];
let currentTocParent: (typeof tocTree)[number] | undefined;

headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .forEach((heading) => {
    if (heading.depth === 2 || !currentTocParent) {
      currentTocParent = { slug: heading.slug, text: heading.text, children: [] };
      tocTree.push(currentTocParent);
      return;
    }

    currentTocParent.children.push({ slug: heading.slug, text: heading.text });
  });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="page-shell grid grid-cols-[minmax(0,1fr)_282px] gap-8 max-lg:grid-cols-1">
    <main class="article-main min-w-0">
      <header class="article-hero border-b border-border-soft py-4 pb-6">
        <nav class="mb-4 flex flex-wrap gap-2 text-xs font-extrabold text-muted" aria-label="面包屑">
          <a class="text-blue" href="/">首页</a>
          <span>/</span>
          <a class="text-blue" href="/blog">文章</a>
          <span>/</span>
          <b>{post.data.category}</b>
        </nav>
        <p class="eyebrow">{post.data.category}</p>
        <h1 class="my-3 max-w-4xl text-4xl leading-tight tracking-normal max-md:text-3xl" data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{post.data.title}</h1>
        <p class="m-0 max-w-content text-base text-muted" data-pagefind-body>{post.data.description}</p>
        <div class="mt-3.5 flex flex-wrap gap-2.5">
          <span class="article-meta"><Icon name="UserRound" size={16} /> {siteConfig.name}</span>
          <time class="article-meta" datetime={post.data.pubDate.toISOString()}><Icon name="CalendarDays" size={16} /> {post.data.pubDate.toLocaleDateString("zh-CN")}</time>
          <span class="article-meta"><Icon name="Clock3" size={16} /> {readingMinutes} 分钟</span>
          {post.data.updatedDate && <span class="article-meta"><Icon name="RefreshCw" size={16} /> 更新 {post.data.updatedDate.toLocaleDateString("zh-CN")}</span>}
        </div>
        <div class="tag-row mt-3.5 flex flex-wrap gap-2.5">
          {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
        {heroCover && post.data.cover && <img class="cover block h-auto w-full rounded-lg border border-border bg-paper-soft object-contain" src={heroCover.src} width={heroCover.attributes.width} height={heroCover.attributes.height} data-lightbox-src={post.data.cover.src} alt={`${post.data.title} 封面`} loading="eager" fetchpriority="high" decoding="async" />}
      </header>

      <section class="prose article-content max-w-content pt-2.5" data-article-content data-pagefind-body>
        <Content />
      </section>

      <section class="mt-8">
        <div class="section-header">
          <div>
            <p class="eyebrow">Continue</p>
            <h2 class="section-title">继续阅读</h2>
          </div>
          <a class="plain-link" href="/blog">全部文章 <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="grid">
          {relatedPosts.map((entry, index) => (
            <ArticleCard
              href={`/blog/${entry.id}`}
              title={entry.data.title}
              description={entry.data.description}
              pubDate={entry.data.pubDate.toISOString()}
              tags={entry.data.tags}
              cover={relatedCovers[index]}
              readingMinutes={getReadingMinutes(entry.body)}
            />
          ))}
        </div>
      </section>
    </main>

    <aside class="sticky top-[94px] grid h-max content-start gap-4 pt-4 max-lg:static max-lg:order-first max-lg:grid-cols-3 max-lg:pt-0 max-md:grid-cols-1">
      <nav class="toc border-b border-border-soft py-4" aria-label="文章目录">
        <h2 class="aside-title">文章目录</h2>
        {tocTree.length > 0 ? (
          <ol class="grid gap-1 p-0 m-0 list-none" data-article-toc>
            {tocTree.map((heading) => (
              <li class="toc-item min-w-0" data-toc-parent data-toc-item data-toc-slug={heading.slug}>
                <a href={`#${heading.slug}`} data-toc-link data-toc-depth="2">{heading.text}</a>
                {heading.children.length > 0 && (
                  <ol class="toc-sublist m-0 list-none gap-0.5 pl-3.5">
                    {heading.children.map((child) => (
                      <li class="toc-item depth-3 min-w-0" data-toc-item data-toc-slug={child.slug}>
                        <a href={`#${child.slug}`} data-toc-link data-toc-depth="3">{child.text}</a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        ) : (
          <p>这篇文章暂时没有目录</p>
        )}
      </nav>

      <section class="border-b border-border-soft py-4">
        <h2 class="aside-title">阅读进度</h2>
        <span class="block h-2 overflow-hidden rounded-full bg-surface-soft" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-reading-progress-track>
          <i class="block h-full rounded-[inherit] bg-blue" data-reading-progress style="width:0%"></i>
        </span>
        <p class="my-2.5 flex items-center gap-2 text-sm text-muted"><span data-reading-progress-text>0%</span> / 预计 {readingMinutes} 分钟读完</p>
      </section>

      <section class="border-b border-border-soft py-4">
        <h2 class="aside-title">文章信息</h2>
        <p class="info-row"><Icon name="BookMarked" size={16} /> 第 {currentIndex + 1} 篇公开文章</p>
        <p class="info-row"><Icon name="Tags" size={16} /> {post.data.tags.length} 个标签</p>
        <p class="info-row"><Icon name="MessageSquare" size={16} /> 评论区预留</p>
      </section>
    </aside>
  </article>

  <script>
    import { setupLightbox } from "@/lib/lightbox";

    let cleanupReadingProgress = () => {};
    let cleanupArticleToc = () => {};
    let cleanupArticleLightbox = () => {};

    function initArticleLightbox() {
      cleanupArticleLightbox();
      const article = document.querySelector(".article-main");
      if (!(article instanceof HTMLElement)) return;
      cleanupArticleLightbox = setupLightbox(article, ".article-hero .cover, [data-article-content] img");
      document.addEventListener("astro:before-swap", cleanupArticleLightbox, { once: true });
    }

    function initReadingProgress() {
      cleanupReadingProgress();
      const article = document.querySelector("[data-article-content]");
      const bar = document.querySelector("[data-reading-progress]");
      const track = document.querySelector("[data-reading-progress-track]");
      const label = document.querySelector("[data-reading-progress-text]");
      if (!(article instanceof HTMLElement) || !(bar instanceof HTMLElement)) return;

      let ticking = false;
      const update = () => {
        const rect = article.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const articleTop = rect.top + window.scrollY;
        const articleHeight = article.offsetHeight;
        const scrollStart = articleTop;
        const scrollEnd = Math.max(scrollStart + 1, articleTop + articleHeight - viewportHeight);
        const progress = Math.min(100, Math.max(0, ((window.scrollY - scrollStart) / (scrollEnd - scrollStart)) * 100));
        const rounded = Math.round(progress);
        bar.style.width = `${progress}%`;
        if (track instanceof HTMLElement) track.setAttribute("aria-valuenow", String(rounded));
        if (label instanceof HTMLElement) label.textContent = `${rounded}%`;
        ticking = false;
      };
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      };

      const controller = new AbortController();
      update();
      window.addEventListener("scroll", requestUpdate, { passive: true, signal: controller.signal });
      window.addEventListener("resize", requestUpdate, { signal: controller.signal });
      cleanupReadingProgress = () => controller.abort();
      document.addEventListener("astro:before-swap", cleanupReadingProgress, { once: true });
    }

    function initArticleToc() {
      cleanupArticleToc();
      const toc = document.querySelector("[data-article-toc]");
      if (!(toc instanceof HTMLElement)) return;

      const links = Array.from(toc.querySelectorAll("[data-toc-link]")).filter((link) => link instanceof HTMLAnchorElement);
      const sections = links
        .map((link) => {
          const id = decodeURIComponent(link.hash.slice(1));
          const section = document.getElementById(id);
          return section instanceof HTMLElement ? { id, section } : undefined;
        })
        .filter((item) => Boolean(item));

      const setActive = (id) => {
        toc.querySelectorAll("[data-toc-parent]").forEach((item) => {
          if (item instanceof HTMLElement) item.dataset.expanded = "false";
        });

        links.forEach((link) => {
          const active = decodeURIComponent(link.hash.slice(1)) === id;
          link.classList.toggle("active", active);
          if (active) {
            link.setAttribute("aria-current", "location");
            const item = link.closest("[data-toc-item]");
            const parent = item?.matches("[data-toc-parent]") ? item : item?.closest("[data-toc-parent]");
            if (item instanceof HTMLElement) item.dataset.active = "true";
            if (parent instanceof HTMLElement) parent.dataset.expanded = "true";
          } else {
            link.removeAttribute("aria-current");
            link.closest("[data-toc-item]")?.removeAttribute("data-active");
          }
        });
      };

      let ticking = false;
      const update = () => {
        const offset = 120;
        let activeId = "";

        for (const item of sections) {
          const top = item.section.getBoundingClientRect().top;
          if (top <= offset) activeId = item.id;
        }

        if (!activeId) {
          const next = sections.find((item) => {
            const top = item.section.getBoundingClientRect().top;
            return top > offset && top < window.innerHeight * 0.58;
          });
          activeId = next?.id ?? "";
        }

        setActive(activeId);
        ticking = false;
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      };

      const controller = new AbortController();
      update();
      window.addEventListener("scroll", requestUpdate, { passive: true, signal: controller.signal });
      window.addEventListener("resize", requestUpdate, { signal: controller.signal });
      cleanupArticleToc = () => controller.abort();
      document.addEventListener("astro:before-swap", cleanupArticleToc, { once: true });
    }

    function initArticlePage() {
      initReadingProgress();
      initArticleToc();
      initArticleLightbox();
    }

    // dev 下无 ClientRouter（astro:page-load 不派发），直接调用保证首屏初始化；
    // 生产软导航靠事件重新绑定（与 Footer/index/notes 脚本同一模式）。
    initArticlePage();
    document.addEventListener("astro:page-load", initArticlePage);
  </script>
</BaseLayout>

