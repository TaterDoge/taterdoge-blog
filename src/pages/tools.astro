        const cronMonthAliases = {
          jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6,
          jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12,
        };
        const cronWeekdayAliases = {
          sun: 0, mon: 1, tue: 2, wed: 3, thu: 4, fri: 5, sat: 6,
        };
        const formatCronDate = (date) => date.toLocaleString("zh-CN", {
          month: "2-digit",
          day: "2-digit",
          weekday: "short",
          hour: "2-digit",
          minute: "2-digit",
        });
        const formatCronDelta = (date) => {
          const diff = Math.max(0, date.getTime() - Date.now());
          const days = Math.floor(diff / 86400000);
          const hours = Math.floor((diff % 86400000) / 3600000);
          const minutes = Math.ceil((diff % 3600000) / 60000);
          if (days > 0) return `${days} 天 ${hours} 小时后`;
          if (hours > 0) return `${hours} 小时 ${minutes} 分钟后`;
          return `${minutes || 1} 分钟后`;
        };
        function normalizeCronToken(value, aliases = {}) {
          const lower = value.trim().toLowerCase();
          return Object.prototype.hasOwnProperty.call(aliases, lower) ? aliases[lower] : Number(lower);
        }
        function parseCronField(field, min, max, aliases = {}) {
          const values = new Set();
          const normalizedField = field.trim().replace(/\?/g, "*");
          if (!normalizedField) throw new Error("Cron 字段不能为空");
          normalizedField.split(",").forEach((part) => {
            const [rangePart, stepPart] = part.trim().split("/");
            const step = Math.max(1, Number.parseInt(stepPart || "1", 10) || 1);
            const range = rangePart === "*"
              ? [min, max]
              : rangePart.includes("-")
                ? rangePart.split("-").map((item) => normalizeCronToken(item, aliases))
                : [normalizeCronToken(rangePart, aliases), normalizeCronToken(rangePart, aliases)];
            if (!range.every(Number.isFinite)) throw new Error(`无效字段：${field}`);
            if (range[0] > range[1]) throw new Error(`范围起点不能大于终点：${field}`);
            for (let value = Math.max(min, range[0]); value <= Math.min(max, range[1]); value += step) values.add(value);
          });
          return [...values].sort((a, b) => a - b);
        }
        function describeCronField(raw, values, unit, everyLabel = "每") {
          const value = raw.trim();
          if (value === "*" || value === "?") return `${everyLabel}${unit}`;
          if (/^\*\/\d+$/.test(value)) return `每 ${value.slice(2)} ${unit}`;
          if (values.length <= 6) return `${unit} ${values.join("、")}`;
          return `${unit} ${values[0]}-${values[values.length - 1]} 等 ${values.length} 个值`;
        }
        function updateCronFields(expression) {
          const parts = expression.trim().split(/\s+/);
          if (parts.length !== 5) throw new Error("请输入 5 段 cron 表达式");
          ["minute", "hour", "day", "month", "weekday"].forEach((name, index) => setValue(qs(`[data-cron-field='${name}']`), parts[index]));
        }
        function parseCron() {
          try {
            const expression = textValue(qs("[data-cron-expression]")).trim();
            updateCronFields(expression);
            const [minute, hour, day, month, weekday] = expression.split(/\s+/);
            const minutes = parseCronField(minute, 0, 59);
            const hours = parseCronField(hour, 0, 23);
            const days = parseCronField(day, 1, 31);
            const months = parseCronField(month, 1, 12, cronMonthAliases);
            const weekdays = parseCronField(weekday, 0, 7, cronWeekdayAliases).map((value) => value === 7 ? 0 : value);
            const results = [];
            const cursor = new Date(Date.now() + 60000);
            cursor.setSeconds(0, 0);
            for (let guard = 0; guard < 525600 && results.length < 8; guard += 1) {
              if (minutes.includes(cursor.getMinutes()) && hours.includes(cursor.getHours()) && days.includes(cursor.getDate()) && months.includes(cursor.getMonth() + 1) && weekdays.includes(cursor.getDay())) {
                results.push(new Date(cursor));
              }
              cursor.setMinutes(cursor.getMinutes() + 1);
            }
            const summary = [
              `表达式：${expression}`,
              describeCronField(minute, minutes, "分钟"),
              describeCronField(hour, hours, "小时"),
              describeCronField(day, days, "日期"),
              describeCronField(month, months, "月份"),
              describeCronField(weekday, [...new Set(weekdays)].sort((a, b) => a - b), "星期"),
            ].join("\n");
            setValue(qs("[data-cron-description]"), summary);
            setValue(qs("[data-cron-next]"), results[0] ? `下次执行：${formatCronDate(results[0])}\n${formatCronDelta(results[0])}` : "未来一年内没有匹配时间");
            if (qs("[data-cron-description]") instanceof HTMLElement) qs("[data-cron-description]").dataset.state = "ok";
            if (qs("[data-cron-next]") instanceof HTMLElement) qs("[data-cron-next]").dataset.state = results[0] ? "ok" : "error";
            const list = qs("[data-cron-times]");
            if (list instanceof HTMLElement) {
              list.innerHTML = "";
              results.forEach((date, index) => {
                const item = document.createElement("div");
                item.className = "cron-time-row";
                const order = document.createElement("span");
                order.textContent = `#${index + 1}`;
                const time = document.createElement("strong");
                time.textContent = formatCronDate(date);
                const delta = document.createElement("em");
                delta.textContent = formatCronDelta(date);
                item.append(order, time, delta);
                list.append(item);
              });
            }
          } catch (error) {
            setValue(qs("[data-cron-description]"), error instanceof Error ? error.message : "解析失败");
            if (qs("[data-cron-description]") instanceof HTMLElement) qs("[data-cron-description]").dataset.state = "error";
            setValue(qs("[data-cron-next]"), "无法计算下次执行时间");
            if (qs("[data-cron-next]") instanceof HTMLElement) qs("[data-cron-next]").dataset.state = "error";
            const list = qs("[data-cron-times]");
            if (list instanceof HTMLElement) list.innerHTML = "";
          }
        }
        qs("[data-cron-parse]")?.addEventListener("click", parseCron);
        qs("[data-cron-compose]")?.addEventListener("click", () => {
          const parts = ["minute", "hour", "day", "month", "weekday"].map((name) => textValue(qs(`[data-cron-field='${name}']`)).trim() || "*");
          setValue(qs("[data-cron-expression]"), parts.join(" "));
          parseCron();
        });
        stage.querySelectorAll("[data-cron-template]").forEach((button) => {
          button.addEventListener("click", () => {
            if (!(button instanceof HTMLElement)) return;
            setValue(qs("[data-cron-expression]"), button.dataset.cronTemplate ?? "* * * * *");
            parseCron();
          });
        });

        function readImage(file, preview) {
          return new Promise((resolve, reject) => {
            const img = new Image();
            const url = URL.createObjectURL(file);
            img.onload = () => resolve({ img, url });
            img.onerror = () => {
              URL.revokeObjectURL(url);
              reject(new Error("图片读取失败"));
            };
            img.src = url;
            if (preview instanceof HTMLImageElement) preview.src = url;
          });
        }
        qs("[data-image-file]")?.addEventListener("change", async (event) => {
          const file = event.target instanceof HTMLInputElement ? event.target.files?.[0] : null;
          if (!file) return;
          try {
            if (imageState.url) URL.revokeObjectURL(imageState.url);
            imageState.fileName = file.name.replace(/\.[^.]+$/, "");
            imageState.blob = null;
            const loaded = await readImage(file, qs("[data-image-preview]"));
            imageState.url = loaded.url;
            setValue(qs("[data-image-base64-output]"), "");
            setStatus(qs("[data-image-status]"), `${file.name} / ${(file.size / 1024).toFixed(1)} KB`);
          } catch (error) {
            setStatus(qs("[data-image-status]"), error instanceof Error ? error.message : "图片读取失败", true);
          }
