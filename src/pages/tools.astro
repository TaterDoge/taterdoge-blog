        function parseColor(value) {
          const input = value.trim();
          if (/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(input)) {
            const hex = input.length === 4 ? `#${[...input.slice(1)].map((char) => char + char).join("")}` : input;
            return [Number.parseInt(hex.slice(1, 3), 16), Number.parseInt(hex.slice(3, 5), 16), Number.parseInt(hex.slice(5, 7), 16)];
          }
          const rgb = input.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/i);
          if (rgb) return [Number(rgb[1]), Number(rgb[2]), Number(rgb[3])];
          throw new Error("请输入 HEX 或 RGB");
        }
        function rgbToHsl(r, g, b) {
          r /= 255; g /= 255; b /= 255;
          const max = Math.max(r, g, b), min = Math.min(r, g, b);
          let h = 0, s = 0;
          const l = (max + min) / 2;
          if (max !== min) {
            const d = max - min;
            s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
            h = max === r ? (g - b) / d + (g < b ? 6 : 0) : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
            h *= 60;
          }
          return [Math.round(h), Math.round(s * 100), Math.round(l * 100)];
        }
        function updateColor() {
          try {
            const [r, g, b] = parseColor(textValue(qs("[data-color-input]")));
            const hex = `#${[r, g, b].map((value) => clamp(value, 0, 255).toString(16).padStart(2, "0")).join("")}`;
            const hsl = rgbToHsl(r, g, b);
            setValue(qs("[data-color-picker]"), hex);
            setValue(qs("[data-color-output]"), `${hex}\nrgb(${r}, ${g}, ${b})\nhsl(${hsl[0]} ${hsl[1]}% ${hsl[2]}%)`);
            const preview = qs("[data-color-preview]");
            if (preview instanceof HTMLElement) preview.style.background = hex;
          } catch (error) {
            setValue(qs("[data-color-output]"), error instanceof Error ? error.message : "颜色转换失败");
          }
        }
        qs("[data-color-picker]")?.addEventListener("input", () => {
          setValue(qs("[data-color-input]"), textValue(qs("[data-color-picker]")));
          updateColor();
        });
        qs("[data-color-convert]")?.addEventListener("click", updateColor);
        updateColor();

        function splitDiffLines(value) {
          if (!value) return [];
          const lines = value.replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n");
          if (lines[lines.length - 1] === "") lines.pop();
          return lines;
        }
        function createDiffCode(text, pairText, side, changed) {
          const code = document.createElement("span");
          code.className = "diff-code";
          if (!changed || pairText === null) {
            code.textContent = text || " ";
            return code;
          }
          diffChars(side === "left" ? text : pairText, side === "left" ? pairText : text).forEach((part) => {
            if (side === "left" && part.added) return;
            if (side === "right" && part.removed) return;
            const span = document.createElement("span");
            span.className = part.removed ? "diff-char-remove" : part.added ? "diff-char-add" : "";
            span.textContent = part.value;
            code.append(span);
          });
          if (!code.textContent) code.textContent = " ";
          return code;
        }
        function appendDiffLine(container, line) {
          const row = document.createElement("div");
          row.className = `diff-line diff-${line.type}`;
          const number = document.createElement("span");
          number.className = "diff-line-number";
          number.textContent = line.number ? String(line.number) : "";
          row.append(number, createDiffCode(line.text, line.pairText, line.side, line.changed));
          container.append(row);
        }
        function appendDiffPair(leftPane, rightPane, left, right, state) {
          appendDiffLine(leftPane, {
            number: left?.number ?? "",
            text: left?.text ?? "",
            pairText: right?.text ?? null,
            side: "left",
            type: left ? (state === "same" ? "same" : "removed") : "empty",
            changed: Boolean(left && right && state === "changed"),
          });
          appendDiffLine(rightPane, {
            number: right?.number ?? "",
            text: right?.text ?? "",
            pairText: left?.text ?? null,
            side: "right",
            type: right ? (state === "same" ? "same" : "added") : "empty",
            changed: Boolean(left && right && state === "changed"),
          });
        }
        function createDiffPane(title, count, tone) {
          const pane = document.createElement("section");
          pane.className = `diff-pane ${tone}`;
          const head = document.createElement("div");
          head.className = "diff-pane-head";
          const label = document.createElement("strong");
          label.textContent = title;
          const meta = document.createElement("span");
          meta.textContent = `${count} 行`;
          head.append(label, meta);
          const body = document.createElement("div");
          body.className = "diff-pane-body";
          pane.append(head, body);
          return { pane, body };
        }

        qs("[data-diff-run]")?.addEventListener("click", () => {
          const output = qs("[data-diff-output]");
          if (!(output instanceof HTMLElement)) return;
          output.innerHTML = "";
          const leftText = textValue(qs("[data-diff-left]"));
          const rightText = textValue(qs("[data-diff-right]"));
          const leftPane = createDiffPane("删除", 0, "removed");
          const rightPane = createDiffPane("添加", 0, "added");
          let added = 0;
          let removed = 0;
          let leftLine = 1;
          let rightLine = 1;
          const parts = diffLines(leftText, rightText);

          for (let index = 0; index < parts.length; index += 1) {
            const part = parts[index];
            if (part.removed && parts[index + 1]?.added) {
              const removedLines = splitDiffLines(part.value);
              const addedLines = splitDiffLines(parts[index + 1].value);
              const length = Math.max(removedLines.length, addedLines.length);
              for (let lineIndex = 0; lineIndex < length; lineIndex += 1) {
                const left = removedLines[lineIndex] !== undefined ? { number: leftLine++, text: removedLines[lineIndex] } : null;
                const right = addedLines[lineIndex] !== undefined ? { number: rightLine++, text: addedLines[lineIndex] } : null;
                if (left) removed += 1;
                if (right) added += 1;
                appendDiffPair(leftPane.body, rightPane.body, left, right, left && right ? "changed" : "single");
              }
              index += 1;
              continue;
            }

            const lines = splitDiffLines(part.value);
            lines.forEach((line) => {
              if (part.removed) {
                removed += 1;
                appendDiffPair(leftPane.body, rightPane.body, { number: leftLine++, text: line }, null, "single");
              } else if (part.added) {
                added += 1;
                appendDiffPair(leftPane.body, rightPane.body, null, { number: rightLine++, text: line }, "single");
              } else {
                appendDiffPair(leftPane.body, rightPane.body, { number: leftLine++, text: line }, { number: rightLine++, text: line }, "same");
              }
            });
          }

          const leftMeta = leftPane.pane.querySelector(".diff-pane-head span");
          const rightMeta = rightPane.pane.querySelector(".diff-pane-head span");
          if (leftMeta) leftMeta.textContent = `${removed} 行`;
          if (rightMeta) rightMeta.textContent = `${added} 行`;
          output.append(leftPane.pane, rightPane.pane);
          setStatus(qs("[data-diff-status]"), `删除 ${removed} 行 / 添加 ${added} 行`);
        });

        stage.querySelectorAll("[data-copy-target]").forEach((button) => {
