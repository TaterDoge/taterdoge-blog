---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";
import { tools } from "@/data/tools";
import ToolsWorkbench from "@/components/tools/ToolsWorkbench.tsx";
import "@/styles/tools.css";

const categories = Array.from(new Set(tools.map((item) => item.category)));
const readyCount = tools.filter((item) => item.status !== "draft").length;
---

<BaseLayout title="工具" description={`${siteConfig.name} 收藏和自制的小工具集合`}>
  <div class="page-shell page grid gap-6">
    <section class="page-intro compact-intro items-end">
      <div>
        <p class="eyebrow">Toolbox</p>
        <h1>工具箱</h1>
        <p>常用处理集中在一个工作台里，选择工具后直接输入、预览、复制或下载。</p>
      </div>
      <aside class="intro-note">
        <strong class="text-2xl leading-none text-blue">{readyCount}</strong> 个可用工具<br />
        <span class="text-sm text-muted">{categories.length} 个分类</span>
        <a class="private-publish" href="/admin/manage?tab=tools" data-private-action hidden>
          <Icon name="ListOrdered" size={16} /> 管理工具
        </a>
      </aside>
    </section>

    <ToolsWorkbench
      client:load
      tools={tools}
      categories={categories}
      readyCount={readyCount}
      siteName={siteConfig.name}
    />
  </div>
</BaseLayout>
