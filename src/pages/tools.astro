            const canvas = qs("[data-image-canvas]");
            if (!file) throw new Error("请先选择图片");
            if (!(canvas instanceof HTMLCanvasElement)) throw new Error("当前浏览器不支持 Canvas");
            const { img } = await readImage(file, qs("[data-image-preview]"));
            canvas.width = img.naturalWidth;
            canvas.height = img.naturalHeight;
            const context = canvas.getContext("2d");
            if (!context) throw new Error("当前浏览器无法创建 Canvas 上下文");
            context.drawImage(img, 0, 0);
            const type = textValue(qs("[data-image-format]")) || "image/webp";
            const quality = Number.parseFloat(textValue(qs("[data-image-quality]")) || "0.82");
            const blob = await new Promise((resolve) => canvas.toBlob(resolve, type, quality));
            if (!(blob instanceof Blob)) throw new Error("图片转换失败");
            imageState.blob = blob;
            setStatus(qs("[data-image-status]"), `已转换 / ${(imageState.blob.size / 1024).toFixed(1)} KB`);
            setValue(qs("[data-image-base64-output]"), "");
