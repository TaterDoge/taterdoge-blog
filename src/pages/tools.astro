---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";
import { tools } from "@/data/tools";

const categories = Array.from(new Set(tools.map((item) => item.category)));
const readyCount = tools.filter((item) => item.status !== "draft").length;
---

<BaseLayout title="工具" description={`${siteConfig.name} 收藏和自制的小工具集合`}>
  <div class="page-shell page">
    <section class="page-intro compact-intro">
      <div>
        <p class="eyebrow">Toolbox</p>
        <h1>工具箱</h1>
        <p>常用处理集中在一个工作台里，选择工具后直接输入、预览、复制或下载。</p>
      </div>
      <aside class="intro-note">
        <strong>{readyCount}</strong> 个可用工具<br />
        <span>{categories.length} 个分类</span>
        <a class="private-publish" href="/admin/manage?tab=tools" data-private-action hidden>
          <Icon name="ListOrdered" size={16} /> 管理工具
        </a>
      </aside>
    </section>

    <div class="tools-workbench">
      <section id="tool-index" class="tool-sidebar" data-tool-app>
        <div class="sidebar-head">
          <div>
            <h2>工具清单</h2>
            <p>{tools.length} items</p>
          </div>
          <label class="tool-search">
            <Icon name="Search" size={16} />
            <input type="search" data-tool-search placeholder="搜索工具" aria-label="搜索工具" />
          </label>
        </div>

        <div class="filter-row" aria-label="工具分类筛选">
          <button class="filter-button is-active" type="button" data-filter="all">全部</button>
          {categories.map((category) => <button class="filter-button" type="button" data-filter={category}>{category}</button>)}
        </div>

        <div class="tool-list" data-tool-grid>
          {
            tools.map((tool, index) => (
              <a
                class:list={["tool-card", index === 0 && "is-active", tool.status === "draft" && "is-draft"]}
                href={`#${tool.id}`}
                data-tool-card
                data-tool-id={tool.id}
                data-category={tool.category}
                data-search={`${tool.name} ${tool.description} ${tool.category}`}
                aria-current={index === 0 ? "true" : "false"}
              >
                <span class="tool-icon"><Icon name={tool.icon} size={19} /></span>
                <span class="tool-copy">
                  <span class="tool-title">
                    <strong>{tool.name}</strong>
                    <small>{tool.status === "draft" ? "草稿" : tool.category}</small>
                  </span>
                  <em>{tool.description}</em>
                </span>
              </a>
            ))
          }
        </div>

        <p class="empty-state" data-empty-state hidden>没有匹配的工具</p>
      </section>

      <section class="tool-stage" data-tool-stage aria-live="polite">
        <article id="json" class="tool-panel is-active" data-tool-panel data-panel-id="json">
          <div class="tool-panel-head">
            <span><Icon name="Braces" size={20} /></span>
            <div>
              <h2>JSON 格式化</h2>
              <p>格式化、压缩、复制，错误会显示在状态栏。</p>
            </div>
          </div>
          <div class="workspace dual-editor">
            <label>
              <span>输入</span>
              <textarea class="tool-control tool-textarea code-text" data-json-input data-default={JSON.stringify({ name: siteConfig.name, tools: ["format", "diff", "qr"]})} spellcheck="false"></textarea>
            </label>
            <label>
              <span>输出</span>
              <textarea class="tool-control tool-textarea code-text" data-json-output readonly></textarea>
            </label>
            <div class="tool-footer">
              <p class="tool-status" data-json-status>等待输入</p>
              <div class="panel-actions">
                <button class="tool-button primary" data-json-format type="button">格式化</button>
                <button class="tool-button" data-json-minify type="button">压缩</button>
                <button class="tool-button" data-copy-target="[data-json-output]" type="button">复制</button>
              </div>
            </div>
          </div>
        </article>

        <article id="timestamp" class="tool-panel" data-tool-panel data-panel-id="timestamp" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Clock3" size={20} /></span>
            <div>
              <h2>时间戳转换</h2>
              <p>支持 10 位秒级短时间戳、13 位毫秒级长时间戳和本地时间双向转换。</p>
            </div>
          </div>
          <div class="workspace timestamp-workspace">
            <div class="timestamp-card">
              <div class="timestamp-card-head">
                <strong>时间戳转时间</strong>
                <span>自动识别秒级 / 毫秒级</span>
              </div>
              <label>
                <span>时间戳</span>
                <input class="tool-control code-text" data-ts-input value="1767225600" inputmode="numeric" />
              </label>
              <div class="panel-actions">
                <button class="tool-button primary" data-ts-to-date type="button">转换为本地时间</button>
              </div>
            </div>

            <div class="timestamp-card">
              <div class="timestamp-card-head">
                <strong>时间转时间戳</strong>
                <span>输出秒级和毫秒级</span>
              </div>
              <label>
                <span>本地时间</span>
                <input class="tool-control code-text" data-ts-date type="datetime-local" step="1" />
              </label>
              <div class="panel-actions">
                <button class="tool-button primary" data-ts-to-stamp type="button">生成时间戳</button>
                <button class="tool-button" data-ts-now type="button">填入当前时间</button>
              </div>
            </div>

            <output class="tool-result timestamp-result" data-ts-output>等待转换</output>
          </div>
        </article>

        <article id="base64" class="tool-panel" data-tool-panel data-panel-id="base64" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Binary" size={20} /></span>
            <div>
              <h2>Base64 编解码</h2>
              <p>文本在本地浏览器内编码和解码，支持中文。</p>
            </div>
          </div>
          <div class="workspace dual-editor">
            <label>
              <span>明文</span>
              <textarea class="tool-control tool-textarea code-text" data-base64-plain data-default={siteConfig.title} spellcheck="false"></textarea>
            </label>
            <label>
              <span>Base64 密文</span>
              <textarea class="tool-control tool-textarea code-text" data-base64-encoded spellcheck="false"></textarea>
            </label>
            <div class="tool-footer">
              <p class="tool-status" data-base64-status>等待输入</p>
              <div class="panel-actions">
                <button class="tool-button primary" data-base64-encode type="button">明文 → Base64</button>
                <button class="tool-button" data-base64-decode type="button">Base64 → 明文</button>
                <button class="tool-button" data-copy-target="[data-base64-encoded]" type="button">复制密文</button>
              </div>
            </div>
          </div>
        </article>

        <article id="url" class="tool-panel" data-tool-panel data-panel-id="url" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Link" size={20} /></span>
            <div>
              <h2>URL 编解码</h2>
              <p>适合处理链接、query 参数和中文路径。</p>
            </div>
          </div>
          <div class="workspace dual-editor">
            <label>
              <span>输入</span>
              <textarea class="tool-control tool-textarea code-text" data-url-input data-default="https://marchen.dev/search?q=个人站&tag=工具" spellcheck="false"></textarea>
            </label>
            <label>
              <span>输出</span>
              <textarea class="tool-control tool-textarea code-text" data-url-output readonly></textarea>
            </label>
            <div class="tool-footer">
              <p class="tool-status" data-url-status>等待输入</p>
              <div class="panel-actions">
                <button class="tool-button primary" data-url-encode type="button">编码</button>
                <button class="tool-button" data-url-decode type="button">解码</button>
                <button class="tool-button" data-copy-target="[data-url-output]" type="button">复制</button>
              </div>
            </div>
          </div>
        </article>

        <article id="uuid" class="tool-panel" data-tool-panel data-panel-id="uuid" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Fingerprint" size={20} /></span>
            <div>
              <h2>UUID 生成</h2>
              <p>一次生成多条随机 UUID。</p>
            </div>
          </div>
          <div class="workspace uuid-workspace">
            <div class="uuid-controls">
              <label>
                <span>生成数量</span>
                <input class="tool-control code-text" data-uuid-count value="5" inputmode="numeric" />
              </label>
              <div class="panel-actions">
                <button class="tool-button primary" data-uuid-generate type="button">生成 UUID</button>
                <button class="tool-button" data-copy-target="[data-uuid-output]" type="button">复制结果</button>
              </div>
            </div>
            <label class="wide">
              <span>结果</span>
              <textarea class="tool-control tool-textarea compact code-text" data-uuid-output readonly></textarea>
            </label>
          </div>
        </article>

        <article id="hash" class="tool-panel" data-tool-panel data-panel-id="hash" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Hash" size={20} /></span>
            <div>
              <h2>SHA-256 摘要</h2>
              <p>在浏览器本地计算文本摘要。</p>
            </div>
          </div>
          <div class="workspace hash-workspace">
            <label>
              <span>输入</span>
              <textarea class="tool-control tool-textarea code-text" data-hash-input data-default={siteConfig.name} spellcheck="false"></textarea>
            </label>
            <div class="panel-actions">
              <button class="tool-button primary" data-hash-run type="button">计算 SHA-256</button>
              <button class="tool-button" data-copy-target="[data-hash-output]" type="button">复制摘要</button>
            </div>
            <output class="tool-result hash-output" data-hash-output>等待计算</output>
          </div>
        </article>

        <article id="jwt-decoder" class="tool-panel" data-tool-panel data-panel-id="jwt-decoder" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="KeyRound" size={20} /></span>
            <div>
              <h2>JWT 解码器</h2>
              <p>解码 Header、Payload，支持 HS256/HS384/HS512 密钥验证。</p>
            </div>
          </div>
          <div class="workspace jwt-grid">
            <label class="wide">
              <span>JWT</span>
              <textarea class="tool-control tool-textarea compact code-text" data-jwt-input spellcheck="false"></textarea>
            </label>
            <label>
              <span>HMAC Secret</span>
              <input class="tool-control code-text" data-jwt-secret placeholder="可选" />
            </label>
            <output class="tool-result" data-jwt-meta>等待解码</output>
            <label>
              <span>Header</span>
              <textarea class="tool-control tool-textarea compact code-text" data-jwt-header readonly></textarea>
            </label>
            <label>
              <span>Payload</span>
              <textarea class="tool-control tool-textarea compact code-text" data-jwt-payload readonly></textarea>
            </label>
            <div class="panel-actions wide">
              <button class="tool-button primary" data-jwt-decode type="button">解码</button>
              <button class="tool-button" data-jwt-verify type="button">验证签名</button>
              <button class="tool-button" data-copy-target="[data-jwt-payload]" type="button">复制 Payload</button>
            </div>
          </div>
        </article>

        <article id="text-stats" class="tool-panel" data-tool-panel data-panel-id="text-stats" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Pilcrow" size={20} /></span>
            <div>
              <h2>文本统计</h2>
              <p>字符、中文、英文单词、段落数和阅读时间实时统计。</p>
            </div>
          </div>
          <div class="workspace dual-editor side-result">
            <label>
              <span>文本</span>
              <textarea class="tool-control tool-textarea" data-text-input data-default="把一段文字贴进来，看看它大概需要读多久" spellcheck="false"></textarea>
            </label>
            <aside class="stat-board" data-text-output>
              <span>字符 <strong>0</strong></span>
              <span>中文 <strong>0</strong></span>
              <span>单词 <strong>0</strong></span>
              <span>段落数 <strong>0</strong></span>
              <span>阅读 <strong>1 分钟</strong></span>
            </aside>
          </div>
        </article>

        <article id="regex" class="tool-panel" data-tool-panel data-panel-id="regex" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Regex" size={20} /></span>
            <div>
              <h2>正则测试</h2>
              <p>测试表达式、flags 和匹配片段。</p>
            </div>
          </div>
          <div class="workspace regex-grid">
            <label>
              <span>表达式</span>
              <input class="tool-control code-text" data-regex-pattern value="\\b\\w+\\b" />
            </label>
            <label>
              <span>Flags</span>
              <input class="tool-control code-text" data-regex-flags value="g" />
            </label>
            <textarea class="tool-control tool-textarea compact code-text wide" data-regex-text data-default={`${siteConfig.name} writes code and notes.`} spellcheck="false"></textarea>
            <output class="tool-result wide" data-regex-output>等待测试</output>
            <div class="panel-actions wide">
              <button class="tool-button primary" data-regex-run type="button">测试</button>
            </div>
          </div>
        </article>

        <article id="colors" class="tool-panel" data-tool-panel data-panel-id="colors" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Palette" size={20} /></span>
            <div>
              <h2>颜色速查</h2>
              <p>当前页面核心色彩 token。</p>
            </div>
          </div>
          <div class="swatches">
            <button type="button" data-token="var(--paper)" style="--swatch:var(--paper); --swatch-text:var(--ink)">Paper<small>var(--paper)</small></button>
            <button type="button" data-token="var(--ink)" style="--swatch:var(--ink); --swatch-text:var(--paper)">Ink<small>var(--ink)</small></button>
            <button type="button" data-token="var(--orange)" style="--swatch:var(--orange); --swatch-text:var(--on-accent)">Accent<small>var(--orange)</small></button>
            <button type="button" data-token="var(--blue)" style="--swatch:var(--blue); --swatch-text:var(--on-accent)">Blue<small>var(--blue)</small></button>
          </div>
        </article>

        <article id="code-formatter" class="tool-panel" data-tool-panel data-panel-id="code-formatter" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Code2" size={20} /></span>
            <div>
              <h2>代码美化格式化</h2>
              <p>JavaScript / TypeScript / JSON / YAML / SQL 格式化。</p>
            </div>
          </div>
          <div class="workspace formatter-grid">
            <label>
              <span>语言</span>
              <select class="tool-control" data-format-lang>
                <option value="typescript">TypeScript</option>
                <option value="babel">JavaScript</option>
                <option value="json">JSON</option>
                <option value="yaml">YAML</option>
                <option value="sql">SQL</option>
              </select>
            </label>
            <label>
              <span>缩进</span>
              <input class="tool-control code-text" data-format-tab value="2" inputmode="numeric" />
            </label>
            <label class="wide">
              <span>输入</span>
              <textarea class="tool-control tool-textarea code-text" data-format-input data-default='const hello=(name:string)=>{return {name,ok:true}}' spellcheck="false"></textarea>
            </label>
            <label class="wide">
              <span>输出</span>
              <textarea class="tool-control tool-textarea code-text" data-format-output readonly></textarea>
            </label>
            <div class="tool-footer wide">
              <p class="tool-status" data-format-status>等待输入</p>
              <div class="panel-actions">
                <button class="tool-button primary" data-format-run type="button">格式化</button>
                <button class="tool-button" data-copy-target="[data-format-output]" type="button">复制</button>
              </div>
            </div>
          </div>
        </article>

        <article id="qrcode-generator" class="tool-panel" data-tool-panel data-panel-id="qrcode-generator" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="QrCode" size={20} /></span>
            <div>
              <h2>二维码生成器</h2>
              <p>支持单个或按行批量生成二维码。</p>
            </div>
          </div>
          <div class="workspace qr-compact">
            <label class="qr-text">
              <span>文本 / 链接</span>
              <textarea class="tool-control tool-textarea compact code-text" data-qr-input data-default="https://marchen.dev" spellcheck="false"></textarea>
            </label>
            <div class="qr-controls">
              <label>
                <span>前景</span>
                <input class="tool-control color-field" data-qr-dark type="color" value="#0f172a" />
              </label>
              <label>
                <span>背景</span>
                <input class="tool-control color-field" data-qr-light type="color" value="#ffffff" />
              </label>
              <label>
                <span>尺寸</span>
                <input class="tool-control code-text" data-qr-size value="220" min="64" max="2048" inputmode="numeric" />
              </label>
            </div>
            <div class="tool-footer">
              <p class="tool-status" data-qr-status>等待生成</p>
              <div class="panel-actions">
                <button class="tool-button primary" data-qr-generate type="button">生成</button>
                <button class="tool-button" data-qr-download type="button">下载首个</button>
              </div>
            </div>
            <div class="qr-result">
              <a class="qr-code-item qr-preview-box" data-qr-first-download href="#" download="qrcode-220.png" title="下载第 1 个二维码">
                <img class="qr-code-image" data-qr-preview-image alt="" data-no-media-shell="true" />
                <span class="qr-batch-label">#1</span>
              </a>
              <div class="qr-batch" data-qr-batch></div>
            </div>
          </div>
        </article>

        <article id="cron-parser" class="tool-panel" data-tool-panel data-panel-id="cron-parser" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Clock" size={20} /></span>
            <div>
              <h2>Crontab 表达式解析</h2>
              <p>解析五段式 cron，显示最近几次本地执行时间。</p>
            </div>
          </div>
          <div class="workspace cron-workspace">
            <div class="cron-expression-card">
              <label>
                <span>表达式</span>
                <input class="tool-control code-text" data-cron-expression value="*/15 9-18 * * 1-5" />
              </label>
              <div class="panel-actions">
                <button class="tool-button primary" data-cron-parse type="button">解析表达式</button>
                <button class="tool-button" data-copy-target="[data-cron-expression]" type="button">复制表达式</button>
              </div>
            </div>

            <div class="chip-row cron-presets">
              <button class="chip" type="button" data-cron-template="*/5 * * * *">每 5 分钟</button>
              <button class="chip" type="button" data-cron-template="0 * * * *">每小时整点</button>
              <button class="chip" type="button" data-cron-template="0 9 * * 1-5">工作日 9 点</button>
              <button class="chip" type="button" data-cron-template="30 8 * * 1">每周一 8:30</button>
              <button class="chip" type="button" data-cron-template="0 0 1 * *">每月 1 号</button>
            </div>

            <div class="cron-field-grid">
              <label><span>分钟 <small>0-59</small></span><input class="tool-control code-text" data-cron-field="minute" value="*/15" /></label>
              <label><span>小时 <small>0-23</small></span><input class="tool-control code-text" data-cron-field="hour" value="9-18" /></label>
              <label><span>日期 <small>1-31</small></span><input class="tool-control code-text" data-cron-field="day" value="*" /></label>
              <label><span>月份 <small>1-12</small></span><input class="tool-control code-text" data-cron-field="month" value="*" /></label>
              <label><span>星期 <small>0-7</small></span><input class="tool-control code-text" data-cron-field="weekday" value="1-5" /></label>
            </div>

            <div class="panel-actions">
              <button class="tool-button" data-cron-compose type="button">从字段生成表达式</button>
            </div>

            <div class="cron-summary-grid">
              <output class="tool-result cron-summary" data-cron-description>等待解析</output>
              <output class="tool-result cron-next" data-cron-next>等待下次执行时间</output>
            </div>

            <div class="cron-time-list" data-cron-times></div>
          </div>
        </article>

        <article id="image-convert" class="tool-panel" data-tool-panel data-panel-id="image-convert" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Image" size={20} /></span>
            <div>
              <h2>图片格式转换</h2>
              <p>PNG / WebP / JPG 互转，支持质量压缩和 Base64 导出。</p>
            </div>
          </div>
          <div class="workspace image-convert-workspace">
            <div class="image-convert-controls">
              <label class="file-inline">
                <span>图片</span>
                <input class="tool-control" data-image-file type="file" accept="image/png,image/jpeg,image/webp" />
              </label>
              <label>
                <span>输出格式</span>
                <select class="tool-control" data-image-format>
                  <option value="image/webp">WebP</option>
                  <option value="image/jpeg">JPG</option>
                  <option value="image/png">PNG</option>
                </select>
              </label>
              <label>
                <span>质量</span>
                <input class="tool-control" data-image-quality type="range" min="0.1" max="1" step="0.05" value="0.82" />
              </label>
            </div>
            <div class="tool-footer">
              <output class="tool-result image-convert-status" data-image-status>等待图片</output>
              <div class="panel-actions">
                <button class="tool-button primary" data-image-convert type="button">转换</button>
                <button class="tool-button" data-image-download type="button">下载</button>
                <button class="tool-button" data-image-base64 type="button">导出 Base64</button>
              </div>
            </div>
            <div class="image-convert-preview"><img data-image-preview alt="" data-no-media-shell="true" /></div>
            <textarea class="tool-control tool-textarea compact code-text" data-image-base64-output readonly placeholder="导出的 Base64 会显示在这里"></textarea>
            <canvas data-image-canvas hidden></canvas>
          </div>
        </article>

        <article id="base64-image" class="tool-panel" data-tool-panel data-panel-id="base64-image" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="FileImage" size={20} /></span>
            <div>
              <h2>Base64 图片转换</h2>
              <p>图片转 Base64，也可以把 Data URL 还原为图片预览和下载。</p>
            </div>
          </div>
          <div class="workspace base64-image-workspace">
            <div class="base64-image-controls">
              <label class="file-inline">
                <span>图片</span>
                <input class="tool-control" data-b64-image-file type="file" accept="image/*" />
              </label>
              <div class="panel-actions">
                <button class="tool-button primary" data-b64-image-to-text type="button">图片转 Base64</button>
                <button class="tool-button" data-b64-text-to-image type="button">Base64 转图片</button>
                <button class="tool-button" data-b64-image-download type="button">下载图片</button>
              </div>
            </div>
            <div class="base64-image-body">
              <div class="base64-image-preview">
                <img data-b64-image-preview alt="" data-no-media-shell="true" />
              </div>
              <label>
              <span>Base64 / Data URL</span>
                <textarea class="tool-control tool-textarea compact code-text" data-b64-image-text spellcheck="false"></textarea>
              </label>
            </div>
            <div class="tool-footer">
              <p class="tool-status" data-b64-image-status>等待图片或 Base64</p>
            </div>
          </div>
        </article>

        <article id="color-converter" class="tool-panel" data-tool-panel data-panel-id="color-converter" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Palette" size={20} /></span>
            <div>
              <h2>颜色转换器</h2>
              <p>HEX、RGB、HSL 实时转换。</p>
            </div>
          </div>
          <div class="workspace color-compact">
            <div class="color-controls">
              <div class="color-swatch" data-color-preview></div>
              <label><span>取色</span><input class="tool-control color-field" data-color-picker type="color" value="#2f6fe4" /></label>
              <label><span>颜色值</span><input class="tool-control code-text" data-color-input value="#2f6fe4" /></label>
              <div class="panel-actions">
                <button class="tool-button primary" data-color-convert type="button">转换</button>
                <button class="tool-button" data-copy-target="[data-color-output]" type="button">复制</button>
              </div>
            </div>
            <textarea class="tool-control tool-textarea compact code-text" data-color-output readonly></textarea>
          </div>
        </article>

        <article id="diff-tool" class="tool-panel" data-tool-panel data-panel-id="diff-tool" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="GitCompare" size={20} /></span>
            <div>
              <h2>Diff 对比工具</h2>
              <p>按行对比两段文本并高亮新增、删除和未变内容。</p>
            </div>
          </div>
          <div class="workspace dual-editor">
            <label><span>原文本</span><textarea class="tool-control tool-textarea code-text" data-diff-left data-default="hello\nold line\nsame" spellcheck="false"></textarea></label>
            <label><span>新文本</span><textarea class="tool-control tool-textarea code-text" data-diff-right data-default="hello\nnew line\nsame" spellcheck="false"></textarea></label>
            <div class="tool-footer">
              <p class="tool-status" data-diff-status>等待对比</p>
              <div class="panel-actions"><button class="tool-button primary" data-diff-run type="button">对比</button></div>
            </div>
            <div class="diff-output wide" data-diff-output></div>
          </div>
        </article>

        <article id="prompts" class="tool-panel" data-tool-panel data-panel-id="prompts" aria-hidden="true">
          <div class="tool-panel-head">
            <span><Icon name="Sparkles" size={20} /></span>
            <div>
              <h2>Prompt 抽屉</h2>
              <p>暂存常用提示词片段。</p>
            </div>
          </div>
          <div class="workspace dual-editor">
            <label><span>提示词</span><textarea class="tool-control tool-textarea" data-prompt-input data-default="请用要点列出这段内容的核心结论：" spellcheck="false"></textarea></label>
            <label><span>备注</span><textarea class="tool-control tool-textarea" data-prompt-note data-default="适合快速摘要和整理长文本。" spellcheck="false"></textarea></label>
            <div class="panel-actions wide">
              <button class="tool-button" data-copy-target="[data-prompt-input]" type="button">复制提示词</button>
            </div>
          </div>
        </article>
      </section>
    </div>

    <script>
      import QRCode from "qrcode";
      import { diffChars, diffLines } from "diff";
      import * as prettier from "prettier/standalone";
      import * as parserBabel from "prettier/plugins/babel";
      import * as parserEstree from "prettier/plugins/estree";
      import * as parserTypescript from "prettier/plugins/typescript";
      import * as parserYaml from "prettier/plugins/yaml";
      import { format as formatSql } from "sql-formatter";

      function initTools() {
        const app = document.querySelector("[data-tool-app]");
        const stage = document.querySelector("[data-tool-stage]");
        if (!(app instanceof HTMLElement) || !(stage instanceof HTMLElement) || app.dataset.ready === "true") return;
        app.dataset.ready = "true";

        const cards = Array.from(app.querySelectorAll("[data-tool-card]"));
        const filters = Array.from(app.querySelectorAll("[data-filter]"));
        const panels = Array.from(stage.querySelectorAll("[data-tool-panel]"));
        const emptyState = app.querySelector("[data-empty-state]");
        const searchInput = app.querySelector("[data-tool-search]");
        let activeFilter = "all";
        let imageState = { fileName: "", url: "", blob: null };
        let base64ImageUrl = "";

        const qs = (selector) => stage.querySelector(selector);
        const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
        const textValue = (target) => {
          if (target instanceof HTMLTextAreaElement || target instanceof HTMLInputElement || target instanceof HTMLSelectElement || target instanceof HTMLOutputElement) return target.value;
          return target?.textContent ?? "";
        };
        const setValue = (target, value) => {
          if (target instanceof HTMLTextAreaElement || target instanceof HTMLInputElement || target instanceof HTMLSelectElement || target instanceof HTMLOutputElement) target.value = value;
          else if (target instanceof HTMLElement) target.textContent = value;
        };
        const setStatus = (target, message, isError = false) => {
          if (!(target instanceof HTMLElement)) return;
          target.textContent = message;
          target.dataset.state = isError ? "error" : "ok";
        };
        const utf8ToBase64 = (value) => {
          const bytes = new TextEncoder().encode(value);
          let binary = "";
          for (let index = 0; index < bytes.length; index += 0x8000) {
            binary += String.fromCharCode(...bytes.subarray(index, index + 0x8000));
          }
          return btoa(binary);
        };
        const base64ToUtf8 = (value) => new TextDecoder().decode(Uint8Array.from(atob(value), (char) => char.charCodeAt(0)));
        const base64UrlToBytes = (value) => {
          const base64 = value.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(value.length / 4) * 4, "=");
          return Uint8Array.from(atob(base64), (char) => char.charCodeAt(0));
        };
        const base64UrlToJson = (value) => JSON.parse(new TextDecoder().decode(base64UrlToBytes(value)));
        const bytesToBase64Url = (bytes) => btoa(String.fromCharCode(...new Uint8Array(bytes))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
        const bytesToHex = (bytes) => Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
        const webCrypto = globalThis.crypto;
        const randomBytes = (length) => {
          const bytes = new Uint8Array(length);
          if (typeof webCrypto?.getRandomValues === "function") {
            webCrypto.getRandomValues(bytes);
            return bytes;
          }
          for (let index = 0; index < length; index += 1) bytes[index] = Math.floor(Math.random() * 256);
          return bytes;
        };
        const createUuid = () => {
          if (typeof webCrypto?.randomUUID === "function") return webCrypto.randomUUID();
          const bytes = randomBytes(16);
          bytes[6] = (bytes[6] & 0x0f) | 0x40;
          bytes[8] = (bytes[8] & 0x3f) | 0x80;
          const hex = bytesToHex(bytes);
          return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
        };
        const requireSubtleCrypto = () => {
          if (!webCrypto?.subtle) throw new Error("当前地址不支持 Web Crypto，请用 localhost 或 HTTPS 打开后再计算。");
          return webCrypto.subtle;
        };
        const copyText = async (value) => {
          try {
            if (typeof navigator.clipboard?.writeText === "function") {
              await navigator.clipboard.writeText(value);
              return true;
            }
          } catch {
            // Fall back to the textarea copy path below.
          }
          const textarea = document.createElement("textarea");
          textarea.value = value;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.left = "-9999px";
          document.body.append(textarea);
          textarea.select();
          try {
            return document.execCommand("copy");
          } catch {
            return false;
          } finally {
            textarea.remove();
          }
        };

        function scrollToolTitleIntoView() {
          const title = app.querySelector(".sidebar-head h2");
          const header = document.querySelector("[data-site-header]");
          if (!(title instanceof HTMLElement)) return;
          const headerHeight = header instanceof HTMLElement ? header.offsetHeight : 0;
          const targetTop = title.getBoundingClientRect().top + window.scrollY - headerHeight - 10;
          window.scrollTo({ top: Math.max(0, targetTop), behavior: "smooth" });
        }

        function openTool(id, shouldPushHash = true) {
          const hasPanel = panels.some((panel) => panel instanceof HTMLElement && panel.dataset.panelId === id);
          const targetId = hasPanel ? id : "json";
          cards.forEach((card) => {
            const active = card instanceof HTMLElement && card.dataset.toolId === targetId;
            card.classList.toggle("is-active", active);
            card.setAttribute("aria-current", active ? "true" : "false");
          });
          panels.forEach((panel) => {
            if (!(panel instanceof HTMLElement)) return;
            const active = panel.dataset.panelId === targetId;
            panel.classList.toggle("is-active", active);
            panel.setAttribute("aria-hidden", active ? "false" : "true");
            panel.inert = !active;
          });
          if (shouldPushHash) history.replaceState(null, "", `#${targetId}`);
        }

        function applyFilter() {
          const keyword = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : "";
          filters.forEach((button) => button.classList.toggle("is-active", button instanceof HTMLElement && button.dataset.filter === activeFilter));
          cards.forEach((card) => {
            if (!(card instanceof HTMLElement)) return;
            const matchCategory = activeFilter === "all" || card.dataset.category === activeFilter;
            const matchSearch = !keyword || (card.dataset.search ?? "").toLowerCase().includes(keyword);
            card.hidden = !matchCategory || !matchSearch;
          });
          const visible = cards.filter((card) => card instanceof HTMLElement && !card.hidden);
          if (emptyState instanceof HTMLElement) emptyState.hidden = visible.length > 0;
          const current = cards.find((card) => card instanceof HTMLElement && card.classList.contains("is-active") && !card.hidden);
          if (!current && visible[0] instanceof HTMLElement) openTool(visible[0].dataset.toolId ?? "json", false);
        }

        filters.forEach((button) => {
          button.addEventListener("click", () => {
            if (!(button instanceof HTMLElement)) return;
            activeFilter = button.dataset.filter ?? "all";
            applyFilter();
          });
        });
        searchInput?.addEventListener("input", applyFilter);
        cards.forEach((card) => {
          card.addEventListener("click", (event) => {
            event.preventDefault();
            if (card instanceof HTMLElement) {
              openTool(card.dataset.toolId ?? "json");
              requestAnimationFrame(scrollToolTitleIntoView);
            }
          });
        });

        document.querySelectorAll("textarea[data-default]").forEach((input) => {
          if (input instanceof HTMLTextAreaElement && !input.value) input.value = input.dataset.default ?? "";
        });

        qs("[data-json-format]")?.addEventListener("click", () => {
          const input = qs("[data-json-input]");
          const output = qs("[data-json-output]");
          try {
            setValue(output, JSON.stringify(JSON.parse(textValue(input)), null, 2));
            setStatus(qs("[data-json-status]"), "JSON 已格式化");
          } catch {
            setStatus(qs("[data-json-status]"), "JSON 解析失败", true);
          }
        });
        qs("[data-json-minify]")?.addEventListener("click", () => {
          const input = qs("[data-json-input]");
          const output = qs("[data-json-output]");
          try {
            setValue(output, JSON.stringify(JSON.parse(textValue(input))));
            setStatus(qs("[data-json-status]"), "JSON 已压缩");
          } catch {
            setStatus(qs("[data-json-status]"), "JSON 解析失败", true);
          }
        });

        const formatDateTimeLocal = (date) => {
          const pad = (value) => String(value).padStart(2, "0");
          return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
        };
        const formatHumanTime = (date) => date.toLocaleString("zh-CN", {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
        });
        const renderTimestampResult = (date, source = "") => {
          const milliseconds = date.getTime();
          const seconds = Math.floor(milliseconds / 1000);
          setValue(qs("[data-ts-date]"), formatDateTimeLocal(date));
          setValue(qs("[data-ts-output]"), `${source ? `${source}\n` : ""}本地时间：${formatHumanTime(date)}\n短时间戳（秒）：${seconds}\n长时间戳（毫秒）：${milliseconds}`);
          const output = qs("[data-ts-output]");
          if (output instanceof HTMLElement) output.dataset.state = "ok";
        };
        const timestampToDate = () => {
          const input = qs("[data-ts-input]");
          const output = qs("[data-ts-output]");
          const rawText = textValue(input).trim();
          const raw = Number(rawText);
          if (!Number.isFinite(raw)) {
            setValue(output, "请输入有效时间戳");
            if (output instanceof HTMLElement) output.dataset.state = "error";
            return;
          }
          const isMilliseconds = Math.abs(raw) >= 100000000000;
          renderTimestampResult(new Date(isMilliseconds ? raw : raw * 1000), isMilliseconds ? "识别为长时间戳（毫秒）" : "识别为短时间戳（秒）");
        };
        const dateToTimestamp = () => {
          const output = qs("[data-ts-output]");
          const value = textValue(qs("[data-ts-date]")).trim();
          const date = value ? new Date(value) : new Date();
          if (Number.isNaN(date.getTime())) {
            setValue(output, "请输入有效本地时间");
            if (output instanceof HTMLElement) output.dataset.state = "error";
            return;
          }
          setValue(qs("[data-ts-input]"), String(Math.floor(date.getTime() / 1000)));
          renderTimestampResult(date, "已从本地时间转换");
        };
        qs("[data-ts-to-date]")?.addEventListener("click", timestampToDate);
        qs("[data-ts-to-stamp]")?.addEventListener("click", dateToTimestamp);
        qs("[data-ts-now]")?.addEventListener("click", () => {
          const now = new Date();
          setValue(qs("[data-ts-input]"), String(Math.floor(now.getTime() / 1000)));
          renderTimestampResult(now, "当前时间");
        });
        renderTimestampResult(new Date(Number(textValue(qs("[data-ts-input]"))) * 1000), "默认示例");

        qs("[data-base64-encode]")?.addEventListener("click", () => {
          setValue(qs("[data-base64-encoded]"), utf8ToBase64(textValue(qs("[data-base64-plain]"))));
          setStatus(qs("[data-base64-status]"), "已从左侧明文编码到右侧 Base64");
        });
        qs("[data-base64-decode]")?.addEventListener("click", () => {
          try {
            setValue(qs("[data-base64-plain]"), base64ToUtf8(textValue(qs("[data-base64-encoded]")).trim()));
            setStatus(qs("[data-base64-status]"), "已从右侧 Base64 解码到左侧明文");
          } catch {
            setStatus(qs("[data-base64-status]"), "Base64 解码失败", true);
          }
        });

        qs("[data-url-encode]")?.addEventListener("click", () => {
          setValue(qs("[data-url-output]"), encodeURIComponent(textValue(qs("[data-url-input]"))));
          setStatus(qs("[data-url-status]"), "URL 已编码");
        });
        qs("[data-url-decode]")?.addEventListener("click", () => {
          try {
            setValue(qs("[data-url-output]"), decodeURIComponent(textValue(qs("[data-url-input]"))));
            setStatus(qs("[data-url-status]"), "URL 已解码");
          } catch {
            setStatus(qs("[data-url-status]"), "URL 解码失败", true);
          }
        });

        const generateUuid = () => {
          const count = clamp(Number.parseInt(textValue(qs("[data-uuid-count]")), 10) || 1, 1, 100);
          setValue(qs("[data-uuid-output]"), Array.from({ length: count }, createUuid).join("\n"));
        };
        qs("[data-uuid-generate]")?.addEventListener("click", generateUuid);
        generateUuid();

        qs("[data-hash-run]")?.addEventListener("click", async () => {
          try {
            const buffer = await requireSubtleCrypto().digest("SHA-256", new TextEncoder().encode(textValue(qs("[data-hash-input]"))));
            setValue(qs("[data-hash-output]"), bytesToHex(new Uint8Array(buffer)));
            if (qs("[data-hash-output]") instanceof HTMLElement) qs("[data-hash-output]").dataset.state = "ok";
          } catch (error) {
            setValue(qs("[data-hash-output]"), error instanceof Error ? error.message : "SHA-256 计算失败");
            if (qs("[data-hash-output]") instanceof HTMLElement) qs("[data-hash-output]").dataset.state = "error";
          }
        });

        function describeJwt(payload) {
          const now = Math.floor(Date.now() / 1000);
          const parts = [];
          if (typeof payload.exp === "number") {
            const date = new Date(payload.exp * 1000).toLocaleString("zh-CN");
            parts.push(payload.exp < now ? `已过期：${date}` : `过期时间：${date}`);
          }
          if (typeof payload.iat === "number") parts.push(`签发时间：${new Date(payload.iat * 1000).toLocaleString("zh-CN")}`);
          return parts.join(" / ") || "已解码";
        }
        function decodeJwt() {
          const token = textValue(qs("[data-jwt-input]")).trim();
          const parts = token.split(".");
          if (parts.length !== 3) throw new Error("JWT 需要包含三段内容");
          const header = base64UrlToJson(parts[0]);
          const payload = base64UrlToJson(parts[1]);
          setValue(qs("[data-jwt-header]"), JSON.stringify(header, null, 2));
          setValue(qs("[data-jwt-payload]"), JSON.stringify(payload, null, 2));
          setValue(qs("[data-jwt-meta]"), describeJwt(payload));
          if (qs("[data-jwt-meta]") instanceof HTMLElement) qs("[data-jwt-meta]").dataset.state = "ok";
          return { token, parts, header, payload };
        }
        qs("[data-jwt-decode]")?.addEventListener("click", () => {
          try {
            decodeJwt();
          } catch (error) {
            setValue(qs("[data-jwt-meta]"), error instanceof Error ? error.message : "JWT 解码失败");
            if (qs("[data-jwt-meta]") instanceof HTMLElement) qs("[data-jwt-meta]").dataset.state = "error";
          }
        });
        qs("[data-jwt-verify]")?.addEventListener("click", async () => {
          try {
            const decoded = decodeJwt();
            const alg = decoded.header.alg;
            const hash = alg === "HS256" ? "SHA-256" : alg === "HS384" ? "SHA-384" : alg === "HS512" ? "SHA-512" : "";
            if (!hash) throw new Error("当前只支持 HS256 / HS384 / HS512");
            const secret = textValue(qs("[data-jwt-secret]"));
            if (!secret) throw new Error("请输入 HMAC Secret");
            const subtle = requireSubtleCrypto();
            const key = await subtle.importKey("raw", new TextEncoder().encode(secret), { name: "HMAC", hash }, false, ["sign"]);
            const signature = await subtle.sign("HMAC", key, new TextEncoder().encode(`${decoded.parts[0]}.${decoded.parts[1]}`));
            const valid = bytesToBase64Url(signature) === decoded.parts[2];
            setValue(qs("[data-jwt-meta]"), `${describeJwt(decoded.payload)} / 签名${valid ? "有效" : "无效"}`);
            if (qs("[data-jwt-meta]") instanceof HTMLElement) qs("[data-jwt-meta]").dataset.state = valid ? "ok" : "error";
          } catch (error) {
            setValue(qs("[data-jwt-meta]"), error instanceof Error ? error.message : "JWT 验证失败");
            if (qs("[data-jwt-meta]") instanceof HTMLElement) qs("[data-jwt-meta]").dataset.state = "error";
          }
        });

        const updateTextStats = () => {
          const text = textValue(qs("[data-text-input]"));
          const cjk = (text.match(/[\u4e00-\u9fff]/g) ?? []).length;
          const words = (text.replace(/[\u4e00-\u9fff]/g, " ").match(/[A-Za-z0-9]+(?:[-'][A-Za-z0-9]+)?/g) ?? []).length;
          const lines = text.length ? text.split(/\r\n|\r|\n/).length : 0;
          const minutes = Math.max(1, Math.ceil(cjk / 500 + words / 220 || 0.1));
          const values = [text.length, cjk, words, lines, `${minutes} 分钟`];
          qs("[data-text-output]")?.querySelectorAll("strong").forEach((item, index) => {
            item.textContent = String(values[index] ?? 0);
          });
        };
        qs("[data-text-input]")?.addEventListener("input", updateTextStats);
        updateTextStats();

        qs("[data-regex-run]")?.addEventListener("click", () => {
          try {
            const flagsRaw = textValue(qs("[data-regex-flags]"));
            const flags = flagsRaw.includes("g") ? flagsRaw : `${flagsRaw}g`;
            const regexp = new RegExp(textValue(qs("[data-regex-pattern]")), flags);
            const matches = Array.from(textValue(qs("[data-regex-text]")).matchAll(regexp));
            setValue(qs("[data-regex-output]"), `匹配 ${matches.length} 项：${matches.slice(0, 10).map((match) => match[0]).join(" / ") || "无"}`);
            if (qs("[data-regex-output]") instanceof HTMLElement) qs("[data-regex-output]").dataset.state = "ok";
          } catch (error) {
            setValue(qs("[data-regex-output]"), error instanceof Error ? error.message : "正则表达式错误");
            if (qs("[data-regex-output]") instanceof HTMLElement) qs("[data-regex-output]").dataset.state = "error";
          }
        });

        qs("[data-format-run]")?.addEventListener("click", async () => {
          try {
            const lang = textValue(qs("[data-format-lang]"));
            const tabWidth = clamp(Number.parseInt(textValue(qs("[data-format-tab]")), 10) || 2, 2, 8);
            const input = textValue(qs("[data-format-input]"));
            const parser = lang === "json" ? "json" : lang === "yaml" ? "yaml" : lang === "babel" ? "babel" : lang === "typescript" ? "typescript" : "";
            const formatted = lang === "sql"
              ? formatSql(input, { language: "sql", tabWidth })
              : await prettier.format(input, { parser, plugins: [parserBabel, parserTypescript, parserEstree, parserYaml], tabWidth, semi: true });
            setValue(qs("[data-format-output]"), formatted.trimEnd());
            setStatus(qs("[data-format-status]"), "格式化完成");
          } catch (error) {
            setStatus(qs("[data-format-status]"), error instanceof Error ? error.message : "格式化失败", true);
          }
        });

        async function renderQr() {
          const input = textValue(qs("[data-qr-input]")).trim();
          const lines = input.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
