---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
---

<BaseLayout title="404 · 迷路了" description="这个页面好像不见了">
  <div class="page-shell not-found-page grid min-h-[70vh] items-center py-8">
    <section class="lost-card relative overflow-hidden rounded-lg border border-border-strong bg-surface px-10 pb-9 pt-12">
      <div class="tape top-left" aria-hidden="true"></div>
      <div class="tape top-right" aria-hidden="true"></div>

      <div class="relative mb-2 flex items-center justify-center">
        <span class="lost-num inline-flex select-none items-baseline gap-0.5 font-black leading-[0.88] tracking-tighter text-ink" aria-hidden="true">
          <b>4</b><em>0</em><b>4</b>
        </span>
        <div class="compass absolute top-[-8px] flex size-16 items-center justify-center rounded-full border-[1.5px] border-dashed border-border-strong text-blue" aria-hidden="true">
          <Icon name="Compass" size={48} strokeWidth={1.6} />
        </div>
      </div>

      <div class="mb-5 text-center">
        <p class="eyebrow">Page Not Found</p>
        <h1 class="my-2 text-2xl leading-tight tracking-normal max-sm:text-xl">这个页面走丢了</h1>
        <p class="mx-auto max-w-md text-sm leading-relaxed text-muted">
          它可能被风吹走了，也可能躲到了某个角落里。<br class="max-sm:hidden" />
          不过没关系，你可以从下面这些地方重新出发。
        </p>
      </div>

      <div class="lost-clues mb-7 flex flex-wrap justify-center gap-2" aria-hidden="true">
        <code class="inline-flex rounded bg-note-quiet-bg px-2.5 py-0.5 text-sm text-ink-2">errno 404 · page_missing</code>
        <code class="inline-flex rounded bg-note-quiet-bg px-2.5 py-0.5 text-sm text-ink-2">hint: try the links below ↓</code>
      </div>

      <nav class="mb-6 flex flex-wrap justify-center gap-2.5 max-sm:gap-2" aria-label="404 快速导航">
        <a class="button px-4" href="/">
          <Icon name="House" size={18} /> 回首页
        </a>
        <a class="nav-chip" href="/blog">
          <Icon name="BookOpen" size={16} /> 看文章
        </a>
        <a class="nav-chip" href="/notes">
          <Icon name="Images" size={16} /> 碎念
        </a>
        <a class="nav-chip" href="/tools">
          <Icon name="Wrench" size={16} /> 工具箱
        </a>
        <a class="nav-chip" href="/projects">
          <Icon name="FolderOpen" size={16} /> 项目
        </a>
      </nav>

      <p class="m-0 flex items-center justify-center gap-1.5 border-t border-dashed border-border-soft pt-4 text-center text-sm text-muted">
        <Icon name="Frown" size={14} /> 如果你觉得这不应该发生，
        <a class="font-bold text-blue underline decoration-link-underline underline-offset-2" href="/">回首页</a> 告诉我一声。
      </p>
    </section>
  </div>
</BaseLayout>

