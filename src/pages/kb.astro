---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import PrivateNotFound from "@/components/PrivateNotFound.astro";
import { siteConfig } from "@/data/site";
import { hasPrivateAccess } from "@/lib/private-access";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Vary", "Cookie");

const canViewPrivate = hasPrivateAccess(Astro.cookies);

if (!canViewPrivate) {
  Astro.response.status = 404;
}
---

<BaseLayout
  title={canViewPrivate ? "个人知识库" : "页面未找到"}
  description={canViewPrivate ? `${siteConfig.name} 的私有知识库入口` : "这个页面暂时找不到"}
>
  {
    canViewPrivate ? (
      <div class="page-shell grid gap-6">
        <section class="page-intro">
          <div>
            <p class="eyebrow">Private KB</p>
            <h1>个人知识库</h1>
            <p>这里先留给个人知识库，后续接入第三方问答 API</p>
          </div>
          <aside class="intro-note">私有内容，需要时再开</aside>
        </section>

        <section class="relative mt-2 border-b border-border-soft py-7">
          <span class="tape" aria-hidden="true"></span>
          <Icon name="BrainCircuit" size={32} />
          <h2 class="my-3">知识库问答预留</h2>
          <p class="max-w-content text-muted">
            后续这里会接入 <code class="rounded-md bg-code-inline-bg px-1.5 py-0.5 text-code-inline-text">/api/kb/ask</code>
            ，由服务端转发到第三方知识库 API，再展示回答和引用来源
          </p>
          <form class="mt-5 grid max-w-content gap-2.5">
            <label class="font-black" for="question">问题</label>
            <textarea
              id="question"
              class="min-h-44 resize-y rounded-md border border-border bg-surface p-3.5 text-ink"
              placeholder="例如：我之前写过哪些关于 Astro 的内容？"
            ></textarea>
            <button
              type="button"
              class="justify-self-start rounded-md border border-tag-border bg-orange-soft px-3.5 py-2.5 font-black text-orange"
            >
              API 接入后启用
            </button>
          </form>
        </section>
      </div>
    ) : (
      <div class="page-shell grid gap-6">
        <PrivateNotFound />
      </div>
    )
  }
</BaseLayout>
