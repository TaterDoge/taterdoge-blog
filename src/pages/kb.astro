---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import PrivateNotFound from "@/components/PrivateNotFound.astro";
import { siteConfig } from "@/data/site";
import { hasPrivateAccess } from "@/lib/private-access";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Vary", "Cookie");

const canViewPrivate = hasPrivateAccess(Astro.cookies);

if (!canViewPrivate) {
  Astro.response.status = 404;
}
---

<BaseLayout
  title={canViewPrivate ? "个人知识库" : "页面未找到"}
  description={canViewPrivate ? `${siteConfig.name} 的私有知识库入口` : "这个页面暂时找不到"}
>
  {
    canViewPrivate ? (
      <div class="page-shell page">
        <section class="page-intro">
          <div>
            <p class="eyebrow">Private KB</p>
            <h1>个人知识库</h1>
            <p>这里先留给个人知识库，后续接入第三方问答 API</p>
          </div>
          <aside class="intro-note">私有内容，需要时再开</aside>
        </section>

        <section class="kb-panel">
          <span class="tape" aria-hidden="true"></span>
          <Icon name="BrainCircuit" size={32} />
          <h2>知识库问答预留</h2>
          <p>后续这里会接入 <code>/api/kb/ask</code>，由服务端转发到第三方知识库 API，再展示回答和引用来源</p>
          <form>
            <label for="question">问题</label>
            <textarea id="question" placeholder="例如：我之前写过哪些关于 Astro 的内容？"></textarea>
            <button type="button">API 接入后启用</button>
          </form>
        </section>
      </div>
    ) : (
      <div class="page-shell page">
        <PrivateNotFound />
      </div>
    )
  }
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 24px;
  }

  .kb-panel {
    position: relative;
    margin-top: 8px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border-soft);
  }

  .kb-panel p {
    max-width: 760px;
    color: var(--muted);
  }

  h2 {
    margin: 12px 0 8px;
  }

  code {
    border-radius: 6px;
    background: var(--code-inline-bg);
    padding: 2px 6px;
    color: var(--code-inline-text);
  }

  form {
    display: grid;
    gap: 10px;
    max-width: 760px;
    margin-top: 20px;
  }

  label {
    font-weight: 900;
  }

  textarea {
    min-height: 170px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    padding: 14px;
    color: var(--ink);
    resize: vertical;
  }

  button {
    justify-self: start;
    border: 1px solid var(--tag-border);
    border-radius: 6px;
    background: var(--orange-soft);
    padding: 9px 14px;
    color: var(--orange);
    font-weight: 900;
  }

</style>
