---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import PrivateNotFound from "@/components/PrivateNotFound.astro";
import { favorites } from "@/data/favorites";
import { projects } from "@/data/projects";
import { tools } from "@/data/tools";
import { hasPrivateAccess } from "@/lib/private-access";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Vary", "Cookie");

const canManage = hasPrivateAccess(Astro.cookies);
const tabParam = Astro.url.searchParams.get("tab");
const initialTab = tabParam === "tools" || tabParam === "favorites" ? tabParam : "projects";

if (!canManage) {
  Astro.response.status = 404;
}
---

<BaseLayout title={canManage ? "内容管理" : "页面未找到"} description={canManage ? "调整项目、工具和收藏的展示顺序" : "这个页面暂时找不到"}>
  <div class="page-shell page">
    {
      canManage ? (
        <>
          <section class="page-intro">
            <div>
              <p class="eyebrow">Manage</p>
              <h1>内容管理</h1>
              <p>拖动调整项目、工具和收藏展示顺序；保存后会提交到 GitHub，并由 Vercel 自动部署</p>
            </div>
            <aside class="intro-note">排序会影响前台展示</aside>
          </section>

          <section class="manage-panel" data-manage-app>
            <div class="manage-tabs" role="tablist" aria-label="管理类型">
              <button class:list={["manage-tab", initialTab === "projects" && "is-active"]} type="button" data-tab-button="projects">
                <Icon name="Rocket" size={17} /> 项目
              </button>
              <button class:list={["manage-tab", initialTab === "tools" && "is-active"]} type="button" data-tab-button="tools">
                <Icon name="Wrench" size={17} /> 工具
              </button>
              <button class:list={["manage-tab", initialTab === "favorites" && "is-active"]} type="button" data-tab-button="favorites">
                <Icon name="Bookmark" size={17} /> 收藏
              </button>
            </div>

            <article class:list={["manage-view", initialTab === "projects" && "is-active"]} data-manage-view="projects">
              <div class="manage-head">
                <div>
                  <h2>项目顺序</h2>
                  <p>首页会按这里的项目顺序展示前几个项目。</p>
                </div>
                <button class="button manage-save" type="button" data-save-kind="projects">
                  <Icon name="Save" size={17} /> 保存项目
                </button>
              </div>
              <div class="sortable-list" data-sortable-list="projects"></div>
            </article>

            <article class:list={["manage-view", initialTab === "tools" && "is-active"]} data-manage-view="tools">
              <div class="manage-head">
                <div>
                  <h2>工具顺序</h2>
                  <p>工具箱和首页常用工具都会沿用这份数据顺序。</p>
                </div>
                <button class="button manage-save" type="button" data-save-kind="tools">
                  <Icon name="Save" size={17} /> 保存工具
                </button>
              </div>
              <div class="sortable-list" data-sortable-list="tools"></div>
            </article>

            <article class:list={["manage-view", initialTab === "favorites" && "is-active"]} data-manage-view="favorites">
              <div class="manage-head">
                <div>
                  <h2>收藏顺序</h2>
                  <p>收藏可以拖到不同分类里，也可以在弹窗中新增或编辑分类。</p>
                </div>
                <div class="manage-actions">
                  <button class="plain-action" type="button" data-add-category>
                    <Icon name="FolderPlus" size={17} /> 新增分类
                  </button>
                  <button class="plain-action" type="button" data-add-favorite>
                    <Icon name="Plus" size={17} /> 添加收藏
                  </button>
                  <button class="button manage-save" type="button" data-save-kind="favorites">
                    <Icon name="Save" size={17} /> 保存收藏
                  </button>
                </div>
              </div>
              <div class="favorite-board" data-favorite-board></div>
            </article>

            <output class="manage-status" data-manage-status>拖动完成后点保存</output>
          </section>

          <dialog class="favorite-dialog" data-favorite-dialog>
            <form method="dialog" data-favorite-form>
              <div class="dialog-head">
                <h2 data-dialog-title>添加收藏</h2>
                <button class="icon-button" value="cancel" type="submit" aria-label="关闭">
                  <Icon name="X" size={18} />
                </button>
              </div>

              <input name="index" type="hidden" />
              <label>
                <span>标题</span>
                <input name="title" required />
              </label>
              <label>
                <span>描述</span>
                <input name="description" required />
              </label>
              <label>
                <span>链接</span>
                <input name="url" required type="url" />
              </label>
              <div class="form-grid two">
                <label>
                  <span>分类</span>
                  <input name="category" list="favorite-categories" required />
                  <datalist id="favorite-categories"></datalist>
                </label>
                <label>
                  <span>图标</span>
                  <input name="icon" placeholder="Rocket / BookOpen / Github" />
                </label>
              </div>
              <label class="check-line">
                <input name="featured" type="checkbox" />
                <span>首页展示</span>
              </label>

              <div class="dialog-actions">
                <button class="plain-action" value="cancel" type="submit">取消</button>
                <button class="button" value="default" type="submit">保存</button>
              </div>
            </form>
          </dialog>

          <script define:vars={{ initialProjects: projects, initialTools: tools, initialFavorites: favorites, initialTab }}>
            function initManageApp() {
              const app = document.querySelector("[data-manage-app]");
              if (!(app instanceof HTMLElement) || app.dataset.ready === "true") return;
              app.dataset.ready = "true";

              const clone = (value) => JSON.parse(JSON.stringify(value));
              let manageKeySeed = 0;
              const assignManageKey = (item, prefix) => {
                if (!item || typeof item !== "object" || Object.prototype.hasOwnProperty.call(item, "__manageKey")) return item;
                Object.defineProperty(item, "__manageKey", {
                  value: `${prefix}-${manageKeySeed++}`,
                  enumerable: false,
                  writable: true,
                });
                return item;
              };

              const state = {
                projects: clone(initialProjects),
                tools: clone(initialTools),
                favorites: clone(initialFavorites),
                favoriteCategories: Array.from(new Set(initialFavorites.map((item) => item.category))),
              };
              state.projects.forEach((item) => assignManageKey(item, "project"));
              state.tools.forEach((item) => assignManageKey(item, "tool"));
              state.favorites.forEach((item) => assignManageKey(item, "favorite"));

              let activeTab = initialTab;
              let dragState = null;
              let dropTarget = null;
              let pendingEditCategory = "";
              const dropMarker = document.createElement("div");
              dropMarker.className = "drop-marker";
              const tabs = Array.from(app.querySelectorAll("[data-tab-button]"));
              const views = Array.from(app.querySelectorAll("[data-manage-view]"));
              const status = app.querySelector("[data-manage-status]");
              const favoriteDialog = document.querySelector("[data-favorite-dialog]");
              const favoriteForm = document.querySelector("[data-favorite-form]");
              const favoriteDatalist = document.querySelector("#favorite-categories");

              const setStatus = (message, mode = "idle") => {
                if (!(status instanceof HTMLOutputElement)) return;
                status.value = message;
                status.dataset.state = mode;
              };

              const setTab = (tab) => {
                activeTab = tab;
                tabs.forEach((button) => button.classList.toggle("is-active", button instanceof HTMLElement && button.dataset.tabButton === tab));
                views.forEach((view) => view.classList.toggle("is-active", view instanceof HTMLElement && view.dataset.manageView === tab));
                history.replaceState(null, "", `/admin/manage?tab=${tab}`);
              };

              const moveItemToIndex = (items, from, rawTarget) => {
                if (from < 0 || from >= items.length) return false;
                const target = Math.max(0, Math.min(rawTarget, items.length));
                let adjusted = from < target ? target - 1 : target;
                if (from === adjusted) return false;
                const [item] = items.splice(from, 1);
                adjusted = Math.max(0, Math.min(adjusted, items.length));
                items.splice(adjusted, 0, item);
                return true;
              };

              const createBadge = (text, className = "") => {
                const badge = document.createElement("span");
                badge.className = `manage-badge${className ? ` ${className}` : ""}`;
                badge.textContent = text;
                return badge;
              };

              const shouldShowHomeBadge = (kind, item, index) => {
                if (kind === "projects") return index < 3;
                if (kind === "tools") return index < 3;
                if (kind === "favorites") return index < 4;
                return Boolean(item?.featured);
              };

              const createHomeBadge = () => {
                const badge = createBadge("首页", "is-home");
                badge.dataset.homeBadge = "true";
                return badge;
              };

              const clearDropState = () => {
                dropMarker.remove();
                dropTarget = null;
                app.querySelectorAll(".is-drop-target").forEach((target) => target.classList.remove("is-drop-target"));
              };

              const rowIndex = (row) => Number.parseInt(row.dataset.index ?? "-1", 10);

              const positionDropMarker = (container, viewportY) => {
                const appRect = app.getBoundingClientRect();
                const containerRect = container.getBoundingClientRect();
                if (!dropMarker.parentElement) app.append(dropMarker);
                dropMarker.style.left = `${containerRect.left - appRect.left}px`;
                dropMarker.style.top = `${viewportY - appRect.top}px`;
                dropMarker.style.width = `${containerRect.width}px`;
              };

              const getBeforeKey = (row, after) => {
                const beforeRow = after ? row.nextElementSibling : row;
                return beforeRow instanceof HTMLElement && beforeRow.classList.contains("sortable-row") ? beforeRow.dataset.key ?? "" : "";
              };

              const showDropMarker = (row, kind, event) => {
                if (!dragState || dragState.kind !== kind) return;
                const index = rowIndex(row);
                if (index < 0) return;
                const rect = row.getBoundingClientRect();
                const after = event.clientY > rect.top + rect.height / 2;
                const parent = row.parentElement;
                if (!(parent instanceof HTMLElement)) return;
                const targetIndex = index + (after ? 1 : 0);
                positionDropMarker(parent, after ? rect.bottom : rect.top);
                dropTarget = {
                  kind,
                  index: targetIndex,
                  category: row.dataset.category ?? row.closest("[data-category]")?.dataset.category ?? "",
                  beforeKey: getBeforeKey(row, after),
                  container: parent,
                };
                app.querySelectorAll(".is-drop-target").forEach((target) => target.classList.remove("is-drop-target"));
                row.classList.add("is-drop-target");
              };

              const updateGroupEmptyState = (group) => {
                const list = group.querySelector(".favorite-group-list");
                if (!(list instanceof HTMLElement)) return;
                const hasRows = Boolean(list.querySelector(".sortable-row"));
                const empty = list.querySelector(".group-empty");
                if (hasRows && empty) empty.remove();
                if (!hasRows && !empty) {
                  const nextEmpty = document.createElement("p");
                  nextEmpty.className = "group-empty";
                  nextEmpty.textContent = "把收藏拖到这里，或新增收藏时选择这个分类。";
                  list.append(nextEmpty);
                }
              };

              const syncSortIndexes = (kind) => {
                const list = app.querySelector(`[data-sortable-list="${kind}"]`);
                if (!(list instanceof HTMLElement)) return;
                list.querySelectorAll(".sortable-row").forEach((row, index) => {
                  if (!(row instanceof HTMLElement)) return;
                  row.dataset.index = String(index);
                  const meta = row.querySelector(".row-meta");
                  const item = state[kind]?.[index];
                  meta?.querySelector("[data-home-badge='true']")?.remove();
                  if (meta instanceof HTMLElement && shouldShowHomeBadge(kind, item, index)) meta.append(createHomeBadge());
                });
              };

              const syncFavoriteIndexes = () => {
                app.querySelectorAll(".favorite-row").forEach((row) => {
                  if (!(row instanceof HTMLElement)) return;
                  const index = state.favorites.findIndex((item) => item.__manageKey === row.dataset.key);
                  row.dataset.index = String(index);
                  const actions = row.querySelector(".row-actions");
                  const item = state.favorites[index];
                  actions?.querySelector("[data-home-badge='true']")?.remove();
                  if (actions instanceof HTMLElement && shouldShowHomeBadge("favorites", item, index)) actions.prepend(createHomeBadge());
                });
              };

              const commitDrop = () => {
                if (!dragState || !dropTarget || dragState.kind !== dropTarget.kind) {
                  clearDropState();
                  return;
                }

                const draggedRow = app.querySelector(".sortable-row.is-dragging");
                let changed = false;

                if ((dragState.kind === "projects" || dragState.kind === "tools") && draggedRow instanceof HTMLElement) {
                  changed = moveItemToIndex(state[dragState.kind], dragState.index, dropTarget.index);
                  if (changed) {
                    const container = dropTarget.container;
                    const beforeRow = dropTarget.beforeKey ? container?.querySelector(`[data-key="${CSS.escape(dropTarget.beforeKey)}"]`) : null;
                    if (container instanceof HTMLElement) container.insertBefore(draggedRow, beforeRow instanceof HTMLElement ? beforeRow : null);
                    syncSortIndexes(dragState.kind);
                  }
                }

                if (dragState.kind === "favorites" && draggedRow instanceof HTMLElement) {
                  const sourceGroup = draggedRow.closest(".favorite-group");
                  changed = moveFavoriteTo(dragState.index, dropTarget.index, dropTarget.category);
                  if (changed) {
                    const targetGroup = dropTarget.container?.closest(".favorite-group");
                    const targetCategory = targetGroup instanceof HTMLElement ? targetGroup.dataset.category ?? dropTarget.category : dropTarget.category;
                    const beforeRow = dropTarget.beforeKey ? dropTarget.container?.querySelector(`[data-key="${CSS.escape(dropTarget.beforeKey)}"]`) : null;
                    draggedRow.dataset.category = targetCategory;
                    if (dropTarget.container instanceof HTMLElement) dropTarget.container.insertBefore(draggedRow, beforeRow instanceof HTMLElement ? beforeRow : null);
                    if (sourceGroup instanceof HTMLElement) updateGroupEmptyState(sourceGroup);
                    if (targetGroup instanceof HTMLElement) updateGroupEmptyState(targetGroup);
                    syncFavoriteIndexes();
                  }
                }

                if (changed) setStatus("顺序已调整，记得保存。", "idle");
                clearDropState();
              };

              const bindDrag = (row, kind) => {
                row.draggable = true;
                row.setAttribute("aria-label", "拖动调整顺序");
                row.addEventListener("dragstart", (event) => {
                  dragState = {
                    kind,
                    index: rowIndex(row),
                    category: row.dataset.category ?? row.closest("[data-category]")?.dataset.category ?? "",
                  };
                  row.classList.add("is-dragging");
                  event.dataTransfer?.setData("text/plain", `${kind}:${dragState.index}`);
                  if (event.dataTransfer) event.dataTransfer.effectAllowed = "move";
                });
                row.addEventListener("dragend", () => {
                  dragState = null;
                  row.classList.remove("is-dragging");
                  clearDropState();
                });
                row.addEventListener("dragover", (event) => {
                  event.preventDefault();
                  if (event.dataTransfer) event.dataTransfer.dropEffect = "move";
                  showDropMarker(row, kind, event);
                });
                row.addEventListener("drop", (event) => {
                  event.preventDefault();
                  event.stopPropagation();
                  commitDrop();
                });
              };

              const renderSortList = (kind) => {
                const list = app.querySelector(`[data-sortable-list="${kind}"]`);
                if (!(list instanceof HTMLElement)) return;
                const items = state[kind];
                list.replaceChildren();
                if (list.dataset.dragReady !== "true") {
                  list.dataset.dragReady = "true";
                  list.addEventListener("dragover", (event) => {
                    event.preventDefault();
                    if (!dragState || dragState.kind !== kind) return;
                    if (event.target instanceof Element && event.target.closest(".sortable-row")) return;
                    if (event.dataTransfer) event.dataTransfer.dropEffect = "move";
                    positionDropMarker(list, list.getBoundingClientRect().bottom);
                    dropTarget = { kind, index: state[kind].length, category: "", beforeKey: "", container: list };
                    app.querySelectorAll(".is-drop-target").forEach((target) => target.classList.remove("is-drop-target"));
                  });
                  list.addEventListener("drop", (event) => {
                    event.preventDefault();
                    commitDrop();
                  });
                }

                items.forEach((item, index) => {
                  const row = document.createElement("div");
                  row.className = "sortable-row";
                  row.dataset.index = String(index);
                  row.dataset.key = item.__manageKey;
                  bindDrag(row, kind);

                  const handle = document.createElement("span");
                  handle.className = "drag-handle";
                  handle.setAttribute("aria-hidden", "true");

                  const copy = document.createElement("span");
                  copy.className = "row-copy";
                  const title = document.createElement("strong");
                  title.textContent = item.name;
                  const desc = document.createElement("em");
                  desc.textContent = item.description;
                  copy.append(title, desc);

                  const meta = document.createElement("span");
                  meta.className = "row-meta";
                  meta.append(createBadge(item.category ?? "未分类"));
                  if (item.status) meta.append(createBadge(item.status));
                  if (shouldShowHomeBadge(kind, item, index)) meta.append(createHomeBadge());

                  row.append(handle, copy, meta);
                  list.append(row);
                });
              };

              const ensureFavoriteCategory = (category) => {
                const next = String(category || "").trim();
                if (next && !state.favoriteCategories.includes(next)) state.favoriteCategories.push(next);
                return next;
              };

              const updateFavoriteCategoryDatalist = () => {
                if (!(favoriteDatalist instanceof HTMLDataListElement)) return;
                favoriteDatalist.replaceChildren(
                  ...state.favoriteCategories.map((category) => {
                    const option = document.createElement("option");
                    option.value = category;
                    return option;
                  }),
                );
              };

              const favoriteInsertIndex = (category) => {
                const lastIndex = state.favorites.map((item, index) => ({ item, index })).filter(({ item }) => item.category === category).at(-1)?.index;
                if (typeof lastIndex === "number") return lastIndex + 1;
                const categoryPosition = state.favoriteCategories.indexOf(category);
                for (const nextCategory of state.favoriteCategories.slice(categoryPosition + 1)) {
                  const firstIndex = state.favorites.findIndex((item) => item.category === nextCategory);
                  if (firstIndex >= 0) return firstIndex;
                }
                return state.favorites.length;
              };

              const moveFavoriteTo = (from, rawTarget, category) => {
                if (from < 0 || from >= state.favorites.length) return false;
                const target = Math.max(0, Math.min(rawTarget, state.favorites.length));
                const [item] = state.favorites.splice(from, 1);
                const nextCategory = ensureFavoriteCategory(category);
                const oldCategory = item.category;
                item.category = nextCategory;
                let adjusted = from < target ? target - 1 : target;
                adjusted = Math.max(0, Math.min(adjusted, state.favorites.length));
                if (from === adjusted && oldCategory === nextCategory) {
                  state.favorites.splice(from, 0, item);
                  return false;
                }
                state.favorites.splice(Math.max(0, adjusted), 0, item);
                return true;
              };

              const openFavoriteDialog = (index = -1) => {
                if (!(favoriteDialog instanceof HTMLDialogElement) || !(favoriteForm instanceof HTMLFormElement)) return;
                favoriteForm.reset();
                updateFavoriteCategoryDatalist();
                const title = favoriteDialog.querySelector("[data-dialog-title]");
                if (title instanceof HTMLElement) title.textContent = index >= 0 ? "编辑收藏" : "添加收藏";
                const item = state.favorites[index];
                const elements = favoriteForm.elements;
                elements.namedItem("index").value = String(index);
                if (item) {
                  elements.namedItem("title").value = item.title ?? "";
                  elements.namedItem("description").value = item.description ?? "";
                  elements.namedItem("url").value = item.url ?? "";
                  elements.namedItem("category").value = item.category ?? "";
                  elements.namedItem("icon").value = item.icon ?? "";
                  elements.namedItem("featured").checked = Boolean(item.featured);
                }
                favoriteDialog.showModal();
              };

              const renderFavorites = () => {
                const board = app.querySelector("[data-favorite-board]");
                if (!(board instanceof HTMLElement)) return;
                board.replaceChildren();
                state.favoriteCategories = state.favoriteCategories.filter((category, index, list) => category && list.indexOf(category) === index);
                state.favorites.forEach((item) => ensureFavoriteCategory(item.category));

                state.favoriteCategories.forEach((category) => {
                  const group = document.createElement("section");
                  group.className = "favorite-group";
                  group.dataset.category = category;
                  group.addEventListener("dragover", (event) => {
                    event.preventDefault();
                    if (!dragState || dragState.kind !== "favorites") return;
                    if (event.target instanceof Element && event.target.closest(".sortable-row")) return;
                    const list = group.querySelector(".favorite-group-list");
                    if (!(list instanceof HTMLElement)) return;
                    if (event.dataTransfer) event.dataTransfer.dropEffect = "move";
                    positionDropMarker(list, list.getBoundingClientRect().bottom);
                    dropTarget = { kind: "favorites", index: favoriteInsertIndex(category), category, beforeKey: "", container: list };
                    app.querySelectorAll(".is-drop-target").forEach((target) => target.classList.remove("is-drop-target"));
                    group.classList.add("is-drop-target");
                  });
                  group.addEventListener("dragenter", () => {
                    if (dragState?.kind === "favorites") group.classList.add("is-drop-target");
                  });
                  group.addEventListener("dragleave", () => group.classList.remove("is-drop-target"));
                  group.addEventListener("drop", (event) => {
                    event.preventDefault();
                    commitDrop();
                  });

                  const head = document.createElement("div");
                  head.className = "favorite-group-head";
                  const titleWrap = document.createElement("label");
                  titleWrap.className = "favorite-category-label";
                  const title = document.createElement("input");
                  title.className = "favorite-category-input";
                  title.value = category;
                  title.readOnly = true;
                  title.setAttribute("aria-label", "收藏分类名称");
                  const edit = document.createElement("button");
                  edit.className = "category-edit-button";
                  edit.type = "button";
                  edit.textContent = "编辑";
                  const applyCategoryRename = () => {
                    const next = title.value.trim();
                    title.value = next || category;
                    title.readOnly = true;
                    title.classList.remove("is-editing");
                    if (!next || next === category) return;
                    state.favorites.forEach((item) => {
                      if (item.category === category) item.category = next;
                    });
                    state.favoriteCategories = state.favoriteCategories.map((item) => (item === category ? next : item));
                    renderFavorites();
                    setStatus("分类已修改，记得保存。", "idle");
                  };
                  edit.addEventListener("click", () => {
                    title.readOnly = false;
                    title.classList.add("is-editing");
                    title.focus();
                    title.select();
                  });
                  title.addEventListener("keydown", (event) => {
                    if (event.key === "Enter") {
                      event.preventDefault();
                      applyCategoryRename();
                    }
                    if (event.key === "Escape") {
                      title.value = category;
                      title.readOnly = true;
                      title.classList.remove("is-editing");
                    }
                  });
                  title.addEventListener("blur", applyCategoryRename);
                  if (category === pendingEditCategory) {
                    title.readOnly = false;
                    title.classList.add("is-editing");
                    window.requestAnimationFrame(() => {
                      title.focus();
                      title.select();
                      pendingEditCategory = "";
                    });
                  }
                  titleWrap.append(title);
                  head.append(titleWrap, edit);

                  const list = document.createElement("div");
                  list.className = "favorite-group-list";
                  const groupItems = state.favorites.map((item, index) => ({ item, index })).filter(({ item }) => item.category === category);
                  if (groupItems.length === 0) {
                    const empty = document.createElement("p");
                    empty.className = "group-empty";
                    empty.textContent = "把收藏拖到这里，或新增收藏时选择这个分类。";
                    list.append(empty);
                  }

                  groupItems.forEach(({ item, index }) => {
                    const row = document.createElement("div");
                    row.className = "sortable-row favorite-row";
                    row.dataset.index = String(index);
                    row.dataset.category = category;
                    row.dataset.key = item.__manageKey;
                    bindDrag(row, "favorites");

                    const handle = document.createElement("span");
                    handle.className = "drag-handle";
                    handle.setAttribute("aria-hidden", "true");
                    const copy = document.createElement("span");
                    copy.className = "row-copy";
                    const name = document.createElement("strong");
                    name.textContent = item.title;
                    const desc = document.createElement("em");
                    desc.textContent = item.description;
                    copy.append(name, desc);

                    const actions = document.createElement("span");
                    actions.className = "row-actions";
                    if (shouldShowHomeBadge("favorites", item, index)) actions.append(createHomeBadge());
                    const editButton = document.createElement("button");
                    editButton.className = "plain-action small";
                    editButton.type = "button";
                    editButton.textContent = "编辑";
                    editButton.addEventListener("click", () => {
                      const currentRow = editButton.closest(".favorite-row");
                      const currentIndex = currentRow instanceof HTMLElement ? Number.parseInt(currentRow.dataset.index ?? "-1", 10) : index;
                      openFavoriteDialog(currentIndex);
                    });
                    actions.append(editButton);

                    row.append(handle, copy, actions);
                    list.append(row);
                  });

                  group.append(head, list);
                  board.append(group);
                });
              };

              const renderAll = () => {
                renderSortList("projects");
                renderSortList("tools");
                renderFavorites();
              };

              tabs.forEach((button) => {
                button.addEventListener("click", () => {
                  if (button instanceof HTMLElement) setTab(button.dataset.tabButton ?? "projects");
                });
              });

              app.querySelector("[data-add-favorite]")?.addEventListener("click", () => openFavoriteDialog());
              app.querySelector("[data-add-category]")?.addEventListener("click", () => {
                const base = "新分类";
                let category = base;
                let count = 2;
                while (state.favoriteCategories.includes(category)) {
                  category = `${base} ${count}`;
                  count += 1;
                }
                ensureFavoriteCategory(category);
                pendingEditCategory = category;
                renderFavorites();
                setStatus("分类已新增，直接输入名称后把收藏拖进去或添加收藏。", "idle");
              });

              favoriteForm?.addEventListener("submit", (event) => {
                if (!(favoriteForm instanceof HTMLFormElement) || !(favoriteDialog instanceof HTMLDialogElement)) return;
                const submitter = event.submitter;
                if (submitter instanceof HTMLButtonElement && submitter.value === "cancel") return;
                event.preventDefault();
                const data = new FormData(favoriteForm);
                const index = Number.parseInt(String(data.get("index") || "-1"), 10);
                const item = {
                  title: String(data.get("title") || "").trim(),
                  description: String(data.get("description") || "").trim(),
                  url: String(data.get("url") || "").trim(),
                  category: ensureFavoriteCategory(String(data.get("category") || "").trim()),
                  icon: String(data.get("icon") || "Bookmark").trim() || "Bookmark",
                  featured: data.get("featured") === "on",
                };
                if (!item.title || !item.description || !item.url || !item.category) return;
                if (index >= 0 && state.favorites[index]) {
                  Object.defineProperty(item, "__manageKey", {
                    value: state.favorites[index].__manageKey,
                    enumerable: false,
                    writable: true,
                  });
                  state.favorites[index] = item;
                } else {
                  assignManageKey(item, "favorite");
                  state.favorites.splice(favoriteInsertIndex(item.category), 0, item);
                }
                favoriteDialog.close();
                renderFavorites();
                setStatus("收藏已更新，记得保存。", "idle");
              });

              app.querySelectorAll("[data-save-kind]").forEach((button) => {
                button.addEventListener("click", async () => {
                  if (!(button instanceof HTMLButtonElement)) return;
                  const kind = button.dataset.saveKind;
                  if (!kind || !state[kind]) return;
                  button.disabled = true;
                  setStatus("正在提交到 GitHub...", "loading");
                  try {
                    const response = await fetch("/api/admin/manage", {
                      method: "POST",
                      headers: { "content-type": "application/json" },
                      credentials: "same-origin",
                      body: JSON.stringify({ kind, items: state[kind] }),
                    });
                    const result = await response.json();
                    if (!response.ok || !result?.ok) throw new Error(result?.error || "保存失败");
                    setStatus(result.local ? `已保存到本地：${result.path}` : `已提交：${result.path}`, "ok");
                  } catch (error) {
                    setStatus(error instanceof Error ? error.message : "保存失败", "error");
                  } finally {
                    button.disabled = false;
                  }
                });
              });

              renderAll();
              setTab(activeTab);
            }

            initManageApp();
            document.addEventListener("astro:page-load", initManageApp);
          </script>
        </>
      ) : (
        <PrivateNotFound />
      )
    }
  </div>
</BaseLayout>

