---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import PublishApp from "@/components/publish/PublishApp.tsx";
import { hasPrivateAccess } from "@/lib/private-access";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Vary", "Cookie");

const canPublish = hasPrivateAccess(Astro.cookies);
const typeParam = Astro.url.searchParams.get("type");
const initialType = typeParam === "note" || typeParam === "project" ? typeParam : "blog";

if (!canPublish) {
  Astro.response.status = 404;
}
---

<BaseLayout title={canPublish ? "发布内容" : "页面未找到"} description={canPublish ? "发布文章和碎念到 GitHub 内容仓库" : "这个页面暂时找不到"}>
  <div class="page-shell grid gap-6">
    {
      canPublish ? (
        <>
          <section class="page-intro">
            <div>
              <p class="eyebrow">Publish</p>
              <h1>发布内容</h1>
              <p>内容会写入 GitHub 仓库里的 Markdown 文件，提交后由 Vercel 自动重新部署</p>
            </div>
            <aside class="intro-note">写完先确认类型和可见性</aside>
          </section>

          <PublishApp client:load initialType={initialType} />
        </>
      ) : (
        <section class="relative grid min-h-[min(520px,62vh)] place-items-center content-center gap-3 text-center">
          <span class="tape" aria-hidden="true"></span>
          <Icon name="FileQuestion" size={42} class="text-blue" />
          <p class="eyebrow">404</p>
          <h1 class="m-0">页面未找到</h1>
          <p class="m-0 text-muted">你访问的页面不存在，或者暂时还没开放</p>
          <a class="button" href="/"><Icon name="ArrowLeft" size={18} /> 返回首页</a>
        </section>
      )
    }
  </div>
</BaseLayout>
