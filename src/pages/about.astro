---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";

const skillGroups = [
  {
    icon: "Bot",
    title: "AI 应用",
    text: "关注大模型应用、Agent、MCP 和工作流搭建，喜欢把重复流程拆成能自动跑的小系统",
    tags: ["Agent", "MCP", "Dify", "Coze", "AI Workflow"],
  },
  {
    icon: "Server",
    title: "全栈开发",
    text: "会从前端界面一路接到 API、数据库和部署，做东西时更在意它能不能稳定上线",
    tags: ["Vue", "Uni-app", "Node.js", "FastAPI", "RESTful API"],
  },
  {
    icon: "WandSparkles",
    title: "工具化",
    text: "喜欢写脚本和小工具，把数据处理、批量操作、接口集成这些琐事变得更省心",
    tags: ["Python", "Automation", "Golang", "Database", "ECharts"],
  },
];

const timeline = [
  { icon: "Rocket", label: "2026", text: "小站重启，把文章、项目、碎念和工具重新整理成更顺手的入口" },
  { icon: "Brain", label: "2025", text: "开始深入 AI 应用开发，搭建第一个知识库和自动化工作流" },
  { icon: "Code", label: "2024", text: "公开记录学习笔记和踩坑经验，做出第一批能跑起来的效率工具" },
  { icon: "Sparkles", label: "更早", text: "从前端入坑，一路折腾到全栈，始终保持对新产品和技术的好奇心" },
];

const focusRow =
  "grid grid-cols-1 gap-1 border-t border-border-soft py-3 min-xs:grid-cols-[108px_minmax(0,1fr)] min-xs:gap-4";
---

<BaseLayout title="关于" description={`关于 ${siteConfig.name} 和正在折腾的各种有趣小东西`}>
  <div class="page-shell grid gap-10">
    <!-- Hero: 居中布局，头像 + 名字 + 一句话 -->
    <section class="flex flex-col items-center border-b border-border-soft px-0 pb-9 pt-12 text-center">
      <div class="mb-5 size-36 overflow-hidden rounded-full border-[3px] border-border-strong shadow-soft-card">
        <img class="size-full object-cover" src="/images/image-placeholder.svg" data-media-src={siteConfig.avatar} alt={siteConfig.name} />
      </div>
      <h1 class="m-0 text-5xl leading-tight text-ink">{siteConfig.name}</h1>
      <p class="m-0 mt-2 text-base font-extrabold tracking-wide text-muted">Full-stack / AI app / tiny tools</p>
      <p class="mx-auto mt-4 max-w-narrow text-base leading-loose text-muted">一个喜欢把想法从界面、接口、数据到上线都跑通的人，这个站是折腾记录、工具收藏和碎碎念的大本营</p>
    </section>

    <!-- 技术坐标：三列卡片 -->
    <section class="grid gap-4 border-b border-border-soft pb-7">
      <div>
        <p class="eyebrow">What I Build</p>
        <h2 class="mt-1.5 mb-0 text-xl leading-tight">技术坐标</h2>
      </div>
      <div class="grid grid-cols-1 gap-4 min-lg:grid-cols-3">
        {skillGroups.map((group) => (
          <article class="grid content-start gap-3 border-t-2 border-blue pt-3.5">
            <div class="flex items-center gap-2.5">
              <span class="grid size-9 place-items-center rounded-md border border-tag-border bg-blue-soft text-blue">
                <Icon name={group.icon} size={20} />
              </span>
              <h3 class="m-0 text-base">{group.title}</h3>
            </div>
            <p class="m-0 text-sm leading-relaxed text-muted">{group.text}</p>
            <div class="flex flex-wrap gap-2">
              {group.tags.map((tag) => (
                <span class="rounded-md border border-border px-2 py-1 text-xs font-extrabold text-ink-2">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 时间线 -->
    <section class="grid gap-4 border-b border-border-soft pb-7">
      <div>
        <p class="eyebrow">Journey</p>
        <h2 class="mt-1.5 mb-0 text-xl leading-tight">折腾路线</h2>
      </div>
      <ol class="ml-3.5 grid list-none gap-0 border-l-2 border-border p-0 m-0">
        {timeline.map((item) => (
          <li class="relative grid grid-cols-[36px_minmax(0,1fr)] gap-3.5 py-4">
            <div class="relative left-[-17px] grid size-8 place-items-center rounded-full border-2 border-blue bg-surface text-blue">
              <Icon name={item.icon} size={16} />
            </div>
            <div class="pt-1">
              <span class="mb-1 inline-block text-sm font-black tracking-wide text-blue">{item.label}</span>
              <p class="m-0 text-sm leading-relaxed text-muted">{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- 当前关注 + 便签 -->
    <section class="grid items-start gap-8 border-b border-border-soft pb-7 max-lg:grid-cols-1 min-lg:grid-cols-[minmax(0,1fr)_330px]">
      <div>
        <div>
          <p class="eyebrow">Current Focus</p>
          <h2 class="mt-1.5 mb-0 text-xl leading-tight">最近在关心</h2>
        </div>
        <ul class="mt-3.5 grid list-none gap-3.5 p-0 m-0">
          <li class={focusRow}>
            <b class="text-ink">AI 工作流</b><span class="text-muted">把知识库、自动化和工具调用拼成真正能省时间的流程</span>
          </li>
          <li class={focusRow}>
            <b class="text-ink">前端体验</b><span class="text-muted">界面不只是能用，还要清楚、顺手、有自己的气质</span>
          </li>
          <li class={focusRow}>
            <b class="text-ink">后端与数据</b><span class="text-muted">接口、鉴权、数据库设计和性能优化都要一起考虑</span>
          </li>
        </ul>
      </div>
      <div class="relative -rotate-[1.2deg] rounded-lg border border-border-strong bg-note-bg p-5.5">
        <span class="tape" aria-hidden="true"></span>
        <p class="m-0 font-note text-lg leading-loose text-ink-2">比起完美的方案，我更喜欢一个能跑通的原型：先让核心成立，再慢慢把细节磨亮</p>
      </div>
    </section>

    <!-- 联系方式 -->
    <section class="grid gap-3">
      <h2 class="m-0 flex items-center gap-2 text-base"><Icon name="Send" size={20} /> 找到我</h2>
      <div class="flex flex-wrap gap-2">
        {siteConfig.socials.map((item) => (
          <a class="inline-flex items-center gap-2 border-b border-border py-2 font-black text-ink-2" href={item.href}>
            <Icon name={item.icon} size={20} /> <span>{item.name}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

