---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ToolFavoriteCard from "@/components/ToolFavoriteCard.astro";
import { favorites } from "@/data/favorites";
import { projects } from "@/data/projects";
import { dailyQuotes } from "@/data/dailyQuotes";
import { siteConfig, nowItems, learningItems, weeklyGoal } from "@/data/site";
import { tools } from "@/data/tools";
import { getReadingMinutes } from "@/lib/reading-time";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.visibility === "public")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const featuredProjects = projects.slice(0, 3);
const featuredTools = tools.slice(0, 3);
const featuredFavorites = favorites.slice(0, 4);
const formatDailyQuote = (quote: string) => quote.replace(/\s+[—-]\s+[^—-]+$/u, "");
const displayDailyQuotes = dailyQuotes.map(formatDailyQuote);
const dayIndex = Math.floor(Date.now() / 86400000) % dailyQuotes.length;
const todayQuote = displayDailyQuotes[dayIndex];
const titleSuffix = siteConfig.title.startsWith(siteConfig.name)
  ? siteConfig.title.slice(siteConfig.name.length)
  : "";
const heroAriaLabel = `${siteConfig.title}，把灵感变成可以翻阅的日常`;
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="page-shell relative z-10 grid gap-10">
    <section class="grid grid-cols-1 items-stretch gap-6 overflow-visible min-lg:grid-cols-[236px_minmax(0,1fr)]">
      <aside class="relative flex h-full flex-col overflow-visible rounded-lg border border-border-strong bg-surface px-4 pb-4 pt-5.5 shadow-soft-card transition-[box-shadow,transform,border-color] duration-200 hover:border-line-blue hover:shadow-pop-card max-lg:grid max-lg:grid-cols-[112px_minmax(0,1fr)] max-lg:items-center max-lg:gap-x-4 max-sm:grid-cols-1 max-sm:text-center [&_.media-shell]:mx-auto [&_.media-shell]:mb-3 [&_.media-shell]:size-28 [&_.media-shell]:rounded-full max-lg:[&_.media-shell]:row-span-3 max-lg:[&_.media-shell]:m-0 max-sm:[&_.media-shell]:mx-auto max-sm:[&_.media-shell]:mb-3">
        <span class="absolute top-[-12px] left-[22px] z-20 h-5 w-[62px] -rotate-[9deg] bg-tape-blue-bg" aria-hidden="true"></span>
        <img class="mx-auto mb-3 block size-28 rounded-full object-cover max-lg:row-span-3 max-lg:m-0 max-sm:mx-auto max-sm:mb-3" src="/images/image-placeholder.svg" data-media-src={siteConfig.avatar} alt={`${siteConfig.name} 的头像插画`} />
        <h2 class="m-0 text-center font-hand text-3xl leading-none tracking-normal">{siteConfig.name}</h2>
        <p class="mt-4 mb-auto text-sm leading-relaxed text-muted">攒灵感、收藏好东西、折腾有趣的小项目，把生活过成自己喜欢的样子</p>
        <div class="grid grid-cols-2 gap-2 max-lg:col-span-full">
          {siteConfig.socials.slice(0, 4).map((item) => (
            <a class="inline-flex items-center justify-center gap-1.5 rounded-md border border-border px-1 py-1.5 text-xs font-extrabold text-ink" href={item.href} aria-label={item.name}><Icon name={item.icon} size={18} /><span>{item.name}</span></a>
          ))}
        </div>
        <dl class="mt-4 mb-0 grid grid-cols-3 gap-2 max-lg:col-span-full">
          <div><dt class="m-0 text-center text-2xs font-extrabold text-muted">文章</dt><dd class="m-0 text-center text-base font-black text-blue">{posts.length}</dd></div>
          <div><dt class="m-0 text-center text-2xs font-extrabold text-muted">项目</dt><dd class="m-0 text-center text-base font-black text-blue">{projects.length}</dd></div>
          <div><dt class="m-0 text-center text-2xs font-extrabold text-muted">工具</dt><dd class="m-0 text-center text-base font-black text-blue">{tools.length}</dd></div>
        </dl>
      </aside>

      <div class="relative grid min-h-[330px] grid-cols-1 gap-6 overflow-visible rounded-lg border border-border-strong bg-[linear-gradient(var(--page-grid-x)_1px,transparent_1px),linear-gradient(90deg,var(--page-grid-y)_1px,transparent_1px),var(--surface)] bg-[length:30px_30px,30px_30px,auto] px-8 pb-6 pt-8 shadow-soft-lift transition-[box-shadow,transform,border-color] duration-200 before:absolute before:right-[26px] before:top-[-14px] before:z-20 before:h-7 before:w-24 before:rotate-[3deg] before:border before:border-border before:bg-[repeating-linear-gradient(-45deg,transparent_0_7px,rgba(37,99,235,0.12)_7px_9px),var(--tape-blue-bg)] before:content-[''] hover:border-line-blue hover:shadow-pop-lift min-lg:grid-cols-[minmax(0,1fr)_270px] min-lg:grid-rows-[1fr_auto] min-lg:gap-x-7 max-sm:px-5 max-sm:pb-5.5 max-sm:pt-7">
        <div class="relative z-10 max-w-xl">
          <p class="eyebrow">Personal Site</p>
          <h1 class="relative my-3 grid gap-1.5 text-[clamp(2.2rem,3vw,3.35rem)] leading-tight tracking-normal max-sm:text-4xl" data-typewriter-title aria-label={heroAriaLabel}>
            <span class="font-hand text-[0.92em] font-normal leading-tight text-blue">
              <span id="big-title" class="mr-1 min-h-[1.2em] text-[1.48em] font-normal after:ml-0.5 after:hidden after:h-[1em] after:w-2.5 after:translate-y-0 after:rounded-sm after:bg-orange after:align-[-0.1em] after:opacity-100 after:transition-[opacity,transform,background-color] after:duration-300 after:content-[''] [&.is-active]:after:inline-block [&.is-active]:after:animate-type-caret [&.is-final]:after:inline-block [&.is-final]:after:animate-type-caret" data-typewriter-part data-typewriter-text={siteConfig.name}>{siteConfig.name}</span>{titleSuffix && <span class="min-h-[1.2em] after:ml-0.5 after:hidden after:h-[1em] after:w-2.5 after:translate-y-0 after:rounded-sm after:bg-orange after:align-[-0.1em] after:opacity-100 after:transition-[opacity,transform,background-color] after:duration-300 after:content-[''] [&.is-active]:after:inline-block [&.is-active]:after:animate-type-caret [&.is-final]:after:inline-block [&.is-final]:after:animate-type-caret" data-typewriter-part data-typewriter-text={titleSuffix}>{titleSuffix}</span>}
            </span>
            <span class="min-h-[1.2em] text-[0.68em] font-black after:ml-0.5 after:hidden after:h-[1em] after:w-2.5 after:translate-y-0 after:rounded-sm after:bg-orange after:align-[-0.1em] after:opacity-100 after:transition-[opacity,transform,background-color] after:duration-300 after:content-[''] [&.is-active]:after:inline-block [&.is-active]:after:animate-type-caret [&.is-final]:after:inline-block [&.is-final]:after:animate-type-caret" data-typewriter-part data-typewriter-text="把灵感变成可以翻阅的日常">把灵感变成可以翻阅的日常</span>
          </h1>
          <p class="m-0 max-w-prose text-base text-muted">灵感碎片、有趣的项目和顺手的小工具都收在这里，清爽一点，少年气一点，也真的好用</p>
          <div class="mt-5 flex flex-wrap gap-2.5">
            <a class="button px-4" href="/blog"><Icon name="BookOpen" size={18} /> 看文章</a>
          </div>
        </div>
        <aside class="relative z-10 w-full rotate-[2.2deg] self-start border border-border-strong bg-surface-strong px-5 py-4 shadow-pop-card before:absolute before:top-[-10px] before:left-[26px] before:h-[18px] before:w-16 before:-rotate-[6deg] before:bg-tape-bg before:shadow-[0_1px_0_var(--tape-shadow)_inset] before:content-[''] min-lg:col-start-2 min-lg:row-start-1 max-lg:mt-5.5 max-lg:max-w-xs">
          <span class="block font-hand text-xl font-black text-orange">stay curious</span>
          <p class="mt-1.5 mb-0 font-note text-base text-ink-2">每一天都值得被认真记录下来</p>
        </aside>
        <div class="relative z-10 my-1 mb-4 h-[138px] w-full justify-self-center self-end min-lg:col-start-2 min-lg:row-start-1 max-lg:hidden" aria-hidden="true">
          <span class="absolute top-3 left-[42px] z-40 h-4 w-[76px] -rotate-[5deg] bg-tape-blue-bg opacity-90 shadow-[0_1px_0_var(--tape-shadow)_inset]"></span>
          <div class="absolute top-5.5 left-0.5 h-24 w-[156px] -rotate-[2deg] rounded-lg border border-border-strong bg-surface-strong p-[15px_14px] shadow-soft-lift before:absolute before:top-2.5 before:left-[13px] before:size-[7px] before:rounded-full before:bg-orange before:shadow-[14px_0_0_var(--yellow),28px_0_0_var(--mint)] before:content-['']">
            <i class="mt-2.5 block h-[7px] w-[76%] rounded-full bg-[color-mix(in_srgb,var(--blue)_20%,transparent)]"></i>
            <i class="mt-2.5 block h-[7px] w-[56%] rounded-full bg-[color-mix(in_srgb,var(--blue)_20%,transparent)]"></i>
            <i class="mt-2.5 block h-[7px] w-[68%] rounded-full bg-[color-mix(in_srgb,var(--blue)_20%,transparent)]"></i>
            <b class="absolute bottom-3 left-[18px] size-2 rounded-full bg-blue opacity-75"></b>
            <b class="absolute bottom-3 left-[34px] size-2 rounded-full bg-blue opacity-45"></b>
            <b class="absolute bottom-3 left-[50px] size-2 rounded-full bg-blue opacity-30"></b>
          </div>
          <div class="absolute top-[34px] right-0 h-[86px] w-32 rotate-[5deg] overflow-hidden rounded-lg border border-border-strong bg-surface-strong p-[13px_12px] shadow-soft-lift">
            <span class="grid size-8 place-items-center rounded-lg border border-tag-border bg-blue-soft text-blue"><Icon name="Sparkles" size={18} strokeWidth={2.4} /></span>
            <i class="mt-2 block h-1.5 w-16 rounded-full bg-border-soft"></i>
            <i class="mt-2 block h-1.5 w-12 rounded-full bg-border-soft"></i>
            <i class="mt-2 block h-1.5 w-[54px] rounded-full bg-[color-mix(in_srgb,var(--blue)_18%,transparent)]"></i>
          </div>
          <div class="absolute bottom-1 left-[94px] h-[15px] w-[132px] -rotate-[7deg] rounded-full border border-[color-mix(in_srgb,var(--line-blue)_70%,transparent)] bg-[linear-gradient(90deg,#d9e8ff_0_14px,#f8fbff_14px_22px,#c7dcff_22px_100%),var(--blue-soft)] shadow-soft-lift before:absolute before:top-1/2 before:left-[-16px] before:h-0 before:w-0 before:-translate-y-1/2 before:border-y-8 before:border-y-transparent before:border-r-[19px] before:border-r-[#b8cff8] before:content-[''] after:absolute after:top-1/2 after:left-[-20px] after:h-[5px] after:w-1.5 after:-translate-y-1/2 after:rounded-l-full after:bg-[#6f94d8] after:content-['']">
            <span class="absolute top-0.5 right-3 h-[11px] w-0.5 bg-[rgba(23,35,59,0.22)] shadow-[7px_0_0_rgba(23,35,59,0.16),-92px_0_0_rgba(47,111,228,0.18),-84px_0_0_rgba(47,111,228,0.12)]"></span>
          </div>
        </div>
        <div class="relative z-10 col-span-full grid grid-cols-1 gap-4 min-sm:grid-cols-3 max-lg:mt-6" aria-label="近期更新">
          {nowItems.map((item, index) => (
            <span class="relative animate-track-in border-t-2 border-blue pt-2.5 text-sm font-extrabold text-muted [animation-delay:calc(var(--i)*80ms)]" style={`--i:${index + 1}`}>
              <b class="block text-ink">5.{12 - index}</b>
              {item}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 items-start gap-7 min-lg:grid-cols-[minmax(0,1fr)_292px]">
      <main class="grid min-w-0 gap-10">
        <section>
          <div class="section-header">
            <div>
              <p class="eyebrow">Writing</p>
              <h2 class="section-title">最近写下</h2>
            </div>
            <a class="plain-link" href="/blog">查看全部 <Icon name="ArrowRight" size={16} /></a>
          </div>
          <div class="grid">
            {posts.map((post, index) => (
              <ArticleCard
                href={`/blog/${post.id}`}
                title={post.data.title}
                description={post.data.description}
                date={post.data.pubDate}
                tags={post.data.tags}
                cover={post.data.cover}
                readingMinutes={getReadingMinutes(post.body)}
                featured={index === 0}
              />
            ))}
          </div>
        </section>

        <section>
          <div class="section-header">
            <div>
              <p class="eyebrow">Projects</p>
              <h2 class="section-title">正在打磨</h2>
            </div>
            <a class="plain-link" href="/projects">全部项目 <Icon name="ArrowRight" size={16} /></a>
          </div>
          <div class="grid">
            {featuredProjects.map((project) => <ProjectCard project={project} />)}
          </div>
        </section>
      </main>

      <aside class="grid gap-5">
        <section class="rounded-md border border-border-strong bg-note-bg p-4 -rotate-[1.1deg]">
          <h2 class="m-0 text-base">今日一句</h2>
          <p class="mt-2 mb-0 font-note text-base text-ink-2" data-daily-quote>{todayQuote}</p>
        </section>

        <section class="border-b border-border-soft py-4">
          <div class="mb-2 flex items-center justify-between gap-3">
            <h2 class="m-0 text-base">常用工具</h2>
            <a class="text-xs font-black text-blue" href="/tools#tool-index">更多</a>
          </div>
          <div class="grid">
            {featuredTools.slice(0, 3).map((tool) => (
              <ToolFavoriteCard title={tool.name} description={tool.description} href={tool.href} icon={tool.icon} label={tool.category} />
            ))}
          </div>
        </section>

        <section class="relative overflow-hidden rounded-lg border border-border bg-surface px-4 pb-4 pt-5 shadow-soft-card transition-[box-shadow,transform,border-color] duration-200 before:pointer-events-none before:absolute before:inset-0 before:bg-[linear-gradient(var(--page-grid-x)_1px,transparent_1px),linear-gradient(90deg,var(--page-grid-y)_1px,transparent_1px)] before:bg-[length:28px_28px] before:opacity-[0.52] before:content-[''] hover:border-line-blue hover:shadow-pop-card" aria-label="现在在学">
          <Icon class="absolute top-2 right-3 z-10 rotate-[-10deg] text-line-blue" name="Paperclip" size={42} strokeWidth={2.1} />
          <div class="relative z-10 mb-3 border-b border-border-soft pr-11 pb-3">
            <h3 class="m-0 text-base font-black tracking-normal text-ink">现在在学 / Now</h3>
          </div>
          <div class="relative z-10 grid">
            {learningItems.map((item) => (
              <div class="grid grid-cols-[24px_minmax(0,1fr)_42px] items-center gap-x-2 gap-y-2 border-b border-border-soft py-3 max-sm:grid-cols-[24px_minmax(0,1fr)_54px] max-sm:gap-2">
                <span class:list={[ "grid", "size-5", "place-items-center", "rounded-md", "border-2", "text-blue", item.checked ? "border-line-blue bg-blue-soft" : "border-border bg-surface-strong"]} aria-hidden="true">
                  {item.checked && <Icon name="Check" size={14} strokeWidth={3} />}
                </span>
                <strong class="text-sm font-black text-ink">{item.name}</strong>
                <span class="col-start-3 row-start-1 justify-self-end text-xs font-black text-blue max-sm:col-start-2">{item.status}</span>
                <div class="col-start-2 col-end-3 row-start-2 h-1 overflow-hidden rounded-full bg-border-soft max-sm:col-start-2 max-sm:col-end-3" aria-label={`${item.name} 进度 ${item.progress}%`}>
                  <i class="block h-full rounded-[inherit] bg-blue" style={`width:${item.progress}%`}></i>
                </div>
                <em class="col-start-3 row-start-2 justify-self-end text-xs not-italic font-black text-ink-2 max-sm:col-start-3 max-sm:row-start-2">{item.progress}%</em>
              </div>
            ))}
          </div>
          <div class="relative z-10 mt-4 grid gap-1.5 rounded-lg border border-border-soft bg-surface-soft p-3.5">
            <b class="text-sm text-ink">本周目标</b>
            <span class="text-sm font-extrabold leading-relaxed text-ink-2">{weeklyGoal}</span>
          </div>
        </section>
      </aside>
    </section>

    <section class="border-t border-border-soft pt-5.5">
      <div>
        <div class="section-header compact mb-1">
          <h2 class="section-title">常去的地方</h2>
          <a class="plain-link" href="/favorites">全部收藏 <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="grid grid-cols-1 gap-x-6 min-sm:grid-cols-2">
          {featuredFavorites.map((favorite) => (
            <ToolFavoriteCard title={favorite.title} description={favorite.description} href={favorite.url} icon={favorite.icon} label={favorite.category} />
          ))}
        </div>
      </div>
    </section>
    <script define:vars={{ quotes: displayDailyQuotes }}>
      const quoteTarget = document.querySelector("[data-daily-quote]");
      if (quoteTarget) {
        const day = Math.floor(Date.now() / 86400000);
        quoteTarget.textContent = quotes[day % quotes.length];
      }
    </script>
    <script>
      function initHomeTypewriter() {
        const title = document.querySelector("[data-typewriter-title]");
        if (!(title instanceof HTMLElement)) return;

        const parts = Array.from(title.querySelectorAll("[data-typewriter-part]")).filter((part) => part instanceof HTMLElement);
        if (parts.length === 0) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          title.classList.remove("is-typing");
          parts.forEach((part) => {
            if (!(part instanceof HTMLElement)) return;
            part.textContent = part.dataset.typewriterText ?? part.textContent ?? "";
          });
          return;
        }

        const runId = String(Date.now());
        title.dataset.typewriterRun = runId;
        title.classList.add("is-typing");

        parts.forEach((part) => {
          if (part instanceof HTMLElement) part.textContent = "";
        });

        const writePart = (part, text, done) => {
          part.classList.add("is-active");
          let index = 0;
          const write = () => {
            if (title.dataset.typewriterRun !== runId) return;
            part.textContent = text.slice(0, index);
            index += 1;
            if (index <= text.length) {
              window.setTimeout(write, text[index - 1]?.charCodeAt(0) > 127 ? 110 : 70);
              return;
            }
            part.classList.remove("is-active");
            done();
          };
          write();
        };

        const writeNext = (index = 0) => {
          const part = parts[index];
          if (!(part instanceof HTMLElement)) {
            title.classList.remove("is-typing");
            title.classList.add("is-typed");
            if (parts.length > 0) parts[parts.length - 1].classList.add("is-final");
            return;
          }
          writePart(part, part.dataset.typewriterText ?? "", () => writeNext(index + 1));
        };

        window.setTimeout(() => writeNext(), 180);
      }

      initHomeTypewriter();
      document.addEventListener("astro:page-load", initHomeTypewriter);
      document.addEventListener("astro:after-swap", initHomeTypewriter);
    </script>
  </div>
</BaseLayout>
