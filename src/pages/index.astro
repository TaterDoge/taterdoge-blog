---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ToolFavoriteCard from "@/components/ToolFavoriteCard.astro";
import { favorites } from "@/data/favorites";
import { projects } from "@/data/projects";
import { dailyQuotes } from "@/data/dailyQuotes";
import { siteConfig, nowItems, learningItems, weeklyGoal } from "@/data/site";
import { tools } from "@/data/tools";
import { getReadingMinutes } from "@/lib/reading-time";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.visibility === "public")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const notes = (await getCollection("notes"))
  .filter((note) => note.data.visibility === "public")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const featuredProjects = projects.slice(0, 3);
const featuredTools = tools.slice(0, 3);
const featuredFavorites = favorites.slice(0, 4);
const formatDailyQuote = (quote: string) => quote.replace(/\s+[—-]\s+[^—-]+$/u, "");
const displayDailyQuotes = dailyQuotes.map(formatDailyQuote);
const dayIndex = Math.floor(Date.now() / 86400000) % dailyQuotes.length;
const todayQuote = displayDailyQuotes[dayIndex];
const formatNoteTime = (date: Date) =>
  date.toLocaleString("zh-CN", {
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  });
const titleSuffix = siteConfig.title.startsWith(siteConfig.name)
  ? siteConfig.title.slice(siteConfig.name.length)
  : "";
const heroAriaLabel = `${siteConfig.title}，把灵感变成可以翻阅的日常`;
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="page-shell home">
    <section class="home-hero">
      <aside class="profile-panel">
        <span class="blue-tape" aria-hidden="true"></span>
        <img src="/images/image-placeholder.svg" data-media-src={siteConfig.avatar} alt={`${siteConfig.name} 的头像插画`} />
        <h2>{siteConfig.name}</h2>
        <p>攒灵感、收藏好东西、折腾有趣的小项目，把生活过成自己喜欢的样子</p>
        <div class="profile-links">
          {siteConfig.socials.slice(0, 4).map((item) => (
            <a href={item.href} aria-label={item.name}><Icon name={item.icon} size={18} /><span>{item.name}</span></a>
          ))}
        </div>
        <dl>
          <div><dt>文章</dt><dd>{posts.length}</dd></div>
          <div><dt>项目</dt><dd>{projects.length}</dd></div>
          <div><dt>工具</dt><dd>{tools.length}</dd></div>
        </dl>
      </aside>

      <div class="hero-board">
        <div class="hero-copy">
          <p class="eyebrow">Personal Site</p>
          <h1 data-typewriter-title aria-label={heroAriaLabel}>
            <span class="hero-name">
              <span id="big-title" data-typewriter-part data-typewriter-text={siteConfig.name}>{siteConfig.name}</span>{titleSuffix && <span class="title-suffix" data-typewriter-part data-typewriter-text={titleSuffix}>{titleSuffix}</span>}
            </span>
            <span data-typewriter-part data-typewriter-text="把灵感变成可以翻阅的日常">把灵感变成可以翻阅的日常</span>
          </h1>
          <p class="lead">灵感碎片、有趣的项目和顺手的小工具都收在这里，清爽一点，少年气一点，也真的好用</p>
          <div class="hero-actions">
            <a class="button" href="/blog"><Icon name="BookOpen" size={18} /> 看文章</a>
            <a class="button secondary" href="/notes"><Icon name="Images" size={18} /> 看碎念</a>
          </div>
        </div>
        <aside class="quote-note">
          <span>stay curious</span>
          <p>每一天都值得被认真记录下来</p>
        </aside>
        <div class="hero-decor-cluster" aria-hidden="true">
          <span class="decor-tape"></span>
          <div class="decor-terminal">
            <i></i>
            <i></i>
            <i></i>
            <b></b>
            <b></b>
            <b></b>
          </div>
          <div class="decor-card">
            <span><Icon name="Sparkles" size={18} strokeWidth={2.4} /></span>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <div class="decor-pencil">
            <span></span>
          </div>
        </div>
        <div class="update-track" aria-label="近期更新">
          {nowItems.map((item, index) => (
            <span style={`--i:${index + 1}`}>
              <b>5.{12 - index}</b>
              {item}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="home-layout">
      <main class="main-feed">
        <section>
          <div class="section-header">
            <div>
              <p class="eyebrow">Writing</p>
              <h2 class="section-title">最近写下</h2>
            </div>
            <a class="plain-link" href="/blog">查看全部 <Icon name="ArrowRight" size={16} /></a>
          </div>
          <div class="post-list">
            {posts.map((post, index) => (
              <ArticleCard
                href={`/blog/${post.id}`}
                title={post.data.title}
                description={post.data.description}
                date={post.data.pubDate}
                tags={post.data.tags}
                cover={post.data.cover?.src}
                readingMinutes={getReadingMinutes(post.body)}
                featured={index === 0}
              />
            ))}
          </div>
        </section>

        <section class="project-now-section">
          <div class="section-header">
            <div>
              <p class="eyebrow">Projects</p>
              <h2 class="section-title">正在打磨</h2>
            </div>
            <a class="plain-link" href="/projects">全部项目 <Icon name="ArrowRight" size={16} /></a>
          </div>
          <div class="project-list">
            {featuredProjects.map((project) => <ProjectCard project={project} />)}
          </div>
        </section>
      </main>

      <aside class="home-rail">
        <section class="rail-block memo yellow">
          <h2>今日一句</h2>
          <p data-daily-quote>{todayQuote}</p>
        </section>

        <section class="rail-block">
          <div class="rail-heading">
            <h2>最近碎念</h2>
            <a href="/notes">全部</a>
          </div>
          <div class="note-links">
            {notes.map((note) => (
              <a href="/notes">
                <time datetime={note.data.pubDate.toISOString()}>{formatNoteTime(note.data.pubDate)}</time>
                <span>{note.data.title}</span>
              </a>
            ))}
          </div>
        </section>

        <section class="rail-block">
          <div class="rail-heading">
            <h2>常用工具</h2>
            <a href="/tools#tool-index">更多</a>
          </div>
          <div class="rail-list">
            {featuredTools.slice(0, 3).map((tool) => (
              <ToolFavoriteCard title={tool.name} description={tool.description} href={tool.href} icon={tool.icon} label={tool.category} />
            ))}
          </div>
        </section>

        <section class="learning-card" aria-label="现在在学">
          <Icon class="paperclip" name="Paperclip" size={42} strokeWidth={2.1} />
          <div class="learning-head">
            <h3>现在在学 / Now</h3>
          </div>
          <div class="learning-list">
            {learningItems.map((item) => (
              <div class="learning-item">
                <span class:list={["check-box", { done: item.checked }]} aria-hidden="true">
                  {item.checked && <Icon name="Check" size={14} strokeWidth={3} />}
                </span>
                <strong>{item.name}</strong>
                <span class="learning-state">{item.status}</span>
                <div class="learning-progress" aria-label={`${item.name} 进度 ${item.progress}%`}>
                  <i style={`width:${item.progress}%`}></i>
                </div>
                <em>{item.progress}%</em>
              </div>
            ))}
          </div>
          <div class="learning-goal">
            <b>本周目标</b>
            <span>{weeklyGoal}</span>
          </div>
        </section>
      </aside>
    </section>

    <section class="resource-strip">
      <div>
        <div class="section-header compact">
          <h2 class="section-title">常去的地方</h2>
          <a class="plain-link" href="/favorites">全部收藏 <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="resource-list">
          {featuredFavorites.map((favorite) => (
            <ToolFavoriteCard title={favorite.title} description={favorite.description} href={favorite.url} icon={favorite.icon} label={favorite.category} />
          ))}
        </div>
      </div>
    </section>
    <script define:vars={{ quotes: displayDailyQuotes }}>
      const quoteTarget = document.querySelector("[data-daily-quote]");
      if (quoteTarget) {
        const day = Math.floor(Date.now() / 86400000);
        quoteTarget.textContent = quotes[day % quotes.length];
      }
    </script>
    <script>
      function initHomeTypewriter() {
        const title = document.querySelector("[data-typewriter-title]");
        if (!(title instanceof HTMLElement)) return;

        const parts = Array.from(title.querySelectorAll("[data-typewriter-part]")).filter((part) => part instanceof HTMLElement);
        if (parts.length === 0) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          title.classList.remove("is-typing");
          parts.forEach((part) => {
            if (!(part instanceof HTMLElement)) return;
            part.textContent = part.dataset.typewriterText ?? part.textContent ?? "";
          });
          return;
        }

        const runId = String(Date.now());
        title.dataset.typewriterRun = runId;
        title.classList.add("is-typing");

        parts.forEach((part) => {
          if (part instanceof HTMLElement) part.textContent = "";
        });

        const writePart = (part, text, done) => {
          part.classList.add("is-active");
          let index = 0;
          const write = () => {
            if (title.dataset.typewriterRun !== runId) return;
            part.textContent = text.slice(0, index);
            index += 1;
            if (index <= text.length) {
              window.setTimeout(write, text[index - 1]?.charCodeAt(0) > 127 ? 110 : 70);
              return;
            }
            part.classList.remove("is-active");
            done();
          };
          write();
        };

        const writeNext = (index = 0) => {
          const part = parts[index];
          if (!(part instanceof HTMLElement)) {
            title.classList.remove("is-typing");
            title.classList.add("is-typed");
            if (parts.length > 0) parts[parts.length - 1].classList.add("is-final");
            return;
          }
          writePart(part, part.dataset.typewriterText ?? "", () => writeNext(index + 1));
        };

        window.setTimeout(() => writeNext(), 180);
      }

      initHomeTypewriter();
      document.addEventListener("astro:page-load", initHomeTypewriter);
      document.addEventListener("astro:after-swap", initHomeTypewriter);
    </script>
  </div>
</BaseLayout>

<style>
  .home {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 42px;
  }

  .home-hero {
    display: grid;
    overflow: visible;
    grid-template-columns: 236px minmax(0, 1fr);
    gap: 26px;
    align-items: stretch;
  }

  .profile-panel {
    position: relative;
    overflow: visible;
    align-self: start;
    padding: 22px 18px 18px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: 0 10px 22px var(--shadow-soft);
    transition: box-shadow 200ms ease-out, transform 200ms ease-out, border-color 200ms ease-out;
  }

  .profile-panel:hover {
    border-color: var(--line-blue);
    box-shadow: 0 16px 34px var(--shadow-pop);
  }

  .blue-tape {
    position: absolute;
    top: -12px;
    left: 22px;
    z-index: 2;
    width: 62px;
    height: 20px;
    background: var(--tape-blue-bg);
    transform: rotate(-9deg);
  }

  .profile-panel img {
    width: 112px;
    height: 112px;
    display: block;
    margin: 0 auto 12px;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-panel :global(.media-shell) {
    width: 112px;
    height: 112px;
    margin: 0 auto 12px;
    border-radius: 50%;
  }

  .profile-panel h2 {
    margin: 0;
    text-align: center;
    font-family: var(--font-hand);
    font-size: 2.05rem;
    line-height: 1;
    letter-spacing: 0;
  }

  .profile-panel p {
    margin: 10px 0 14px;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .profile-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 7px;
  }

  .profile-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 6px 4px;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 800;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 16px 0 0;
  }

  dt,
  dd {
    margin: 0;
    text-align: center;
  }

  dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
  }

  dd {
    color: var(--blue);
    font-size: 1.1rem;
    font-weight: 900;
  }

  .hero-board {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    grid-template-rows: 1fr auto;
    gap: 24px 28px;
    overflow: visible;
    min-height: 330px;
    padding: 34px 34px 24px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background:
      linear-gradient(var(--page-grid-x) 1px, transparent 1px),
      linear-gradient(90deg, var(--page-grid-y) 1px, transparent 1px),
      var(--surface);
    background-size: 30px 30px, 30px 30px, auto;
    box-shadow: 0 10px 26px var(--shadow-soft);
    transition: box-shadow 200ms ease-out, transform 200ms ease-out, border-color 200ms ease-out;
  }

  .hero-board:hover {
    border-color: var(--line-blue);
    box-shadow: 0 18px 42px var(--shadow-pop);
  }

  .hero-board::before {
    position: absolute;
    right: 26px;
    top: -14px;
    z-index: 2;
    width: 96px;
    height: 28px;
    border: 1px solid var(--border);
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0 7px,
        rgba(37, 99, 235, 0.12) 7px 9px
      ),
      var(--tape-blue-bg);
    content: "";
    transform: rotate(3deg);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 540px;
  }

  h1 {
    position: relative;
    display: grid;
    gap: 6px;
    margin: 12px 0 12px;
    font-size: clamp(2.2rem, 3vw, 3.35rem);
    line-height: 1.08;
    letter-spacing: 0;
  }

  [data-typewriter-part] {
    min-height: 1.2em;
  }

  [data-typewriter-part].is-active::after,
  [data-typewriter-part].is-final::after {
    display: inline-block;
    width: 10px;
    height: 1em;
    margin-left: 3px;
    background: var(--orange);
    content: "";
    opacity: 1;
    border-radius: 2px;
    transition:
      opacity 260ms ease-out,
      transform 260ms ease-out,
      background-color 260ms ease-out;
    transform: translateY(0);
    vertical-align: -0.1em;
    animation: type-caret 1000ms ease-in-out infinite;
  }

  @keyframes type-caret {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    45% {
      opacity: 1;
    }
    72% {
      opacity: 0.18;
      transform: translateY(1px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-name {
    color: var(--blue);
    font-family: var(--font-hand);
    font-size: 0.92em;
    font-weight: 400;
    line-height: 1.1;
  }

  #big-title {
    margin-right: 5px;
    font-size: 1.48em;
    font-weight: 400;
  }

  h1 > span:not(.hero-name) {
    font-size: 0.68em;
    font-weight: 900;
  }

  .lead {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .button {
    padding: 0 15px;
  }

  .button.secondary {
    border-color: var(--tag-border);
    background: var(--blue-soft);
    color: var(--blue);
  }

  .button.secondary:hover {
    border-color: var(--blue);
    background: #d4e4ff;
    color: var(--blue);
  }

  .quote-note {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 1;
    align-self: start;
    width: 100%;
    padding: 18px 20px;
    border: 1px solid var(--border-strong);
    background: var(--surface-strong);
    box-shadow: 0 14px 28px var(--shadow-pop);
    transform: rotate(2.2deg);
  }

  .quote-note::before {
    position: absolute;
    top: -10px;
    left: 26px;
    width: 64px;
    height: 18px;
    background: var(--tape-bg);
    box-shadow: 0 1px 0 var(--tape-shadow) inset;
    content: "";
    transform: rotate(-6deg);
  }

  .quote-note span {
    display: block;
    color: var(--orange);
    font-family: var(--font-hand);
    font-size: 1.35rem;
    font-weight: 900;
  }

  .quote-note p {
    margin: 6px 0 0;
    color: var(--ink-2);
    font-family: var(--font-note);
    font-size: 1.05rem;
  }

  .hero-decor-cluster {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    justify-self: center;
    width: 100%;
    height: 138px;
    margin: 4px 0 16px;
  }

  .decor-tape {
    position: absolute;
    top: 12px;
    left: 42px;
    z-index: 4;
    width: 76px;
    height: 16px;
    background: var(--tape-blue-bg);
    box-shadow: 0 1px 0 var(--tape-shadow) inset;
    opacity: 0.92;
    transform: rotate(-5deg);
  }

  .decor-terminal,
  .decor-card,
  .decor-pencil {
    position: absolute;
    border: 1px solid var(--border-strong);
    background: var(--surface-strong);
    box-shadow: 0 14px 28px var(--shadow-soft);
  }

  .decor-terminal {
    left: 2px;
    top: 22px;
    width: 156px;
    height: 96px;
    border-radius: 8px;
    padding: 15px 14px;
    transform: rotate(-2deg);
  }

  .decor-terminal::before {
    position: absolute;
    top: 10px;
    left: 13px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow:
      14px 0 0 var(--yellow),
      28px 0 0 var(--mint);
    content: "";
  }

  .decor-terminal i,
  .decor-terminal b,
  .decor-card i {
    display: block;
    border-radius: 999px;
  }

  .decor-terminal i {
    height: 7px;
    margin-top: 10px;
    background: color-mix(in srgb, var(--blue) 20%, transparent);
  }

  .decor-terminal i:nth-of-type(1) {
    width: 76%;
  }

  .decor-terminal i:nth-of-type(2) {
    width: 56%;
  }

  .decor-terminal i:nth-of-type(3) {
    width: 68%;
  }

  .decor-terminal b {
    position: absolute;
    bottom: 12px;
    width: 8px;
    height: 8px;
    background: var(--blue);
    opacity: 0.75;
  }

  .decor-terminal b:nth-of-type(1) {
    left: 18px;
  }

  .decor-terminal b:nth-of-type(2) {
    left: 34px;
    opacity: 0.45;
  }

  .decor-terminal b:nth-of-type(3) {
    left: 50px;
    opacity: 0.28;
  }

  .decor-card {
    right: 0;
    top: 34px;
    width: 128px;
    height: 86px;
    overflow: hidden;
    border-radius: 8px;
    padding: 13px 12px;
    transform: rotate(5deg);
  }

  .decor-card span {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid var(--tag-border);
    border-radius: 8px;
    background: var(--blue-soft);
    color: var(--blue);
  }

  .decor-card i {
    height: 6px;
    margin-top: 8px;
    background: var(--border-soft);
  }

  .decor-card i:nth-of-type(1) {
    width: 64px;
  }

  .decor-card i:nth-of-type(2) {
    width: 48px;
  }

  .decor-card i:nth-of-type(3) {
    width: 54px;
    background: color-mix(in srgb, var(--blue) 18%, transparent);
  }

  .decor-pencil {
    left: 94px;
    bottom: 4px;
    width: 132px;
    height: 15px;
    border-color: color-mix(in srgb, var(--line-blue) 70%, transparent);
    border-radius: 999px;
    background:
      linear-gradient(
        90deg,
        #d9e8ff 0 14px,
        #f8fbff 14px 22px,
        #c7dcff 22px 100%
      ),
      var(--blue-soft);
    transform: rotate(-7deg);
  }

  .decor-pencil::before {
    position: absolute;
    left: -16px;
    top: 50%;
    width: 0;
    height: 0;
    border-top: 8px solid transparent;
    border-right: 19px solid #b8cff8;
    border-bottom: 8px solid transparent;
    content: "";
    transform: translateY(-50%);
  }

  .decor-pencil::after {
    position: absolute;
    left: -20px;
    top: 50%;
    width: 6px;
    height: 5px;
    border-radius: 999px 0 0 999px;
    background: #6f94d8;
    content: "";
    transform: translateY(-50%);
  }

  .decor-pencil span {
    position: absolute;
    right: 12px;
    top: 2px;
    width: 2px;
    height: 11px;
    background: rgba(23, 35, 59, 0.22);
    box-shadow:
      7px 0 0 rgba(23, 35, 59, 0.16),
      -92px 0 0 rgba(47, 111, 228, 0.18),
      -84px 0 0 rgba(47, 111, 228, 0.12);
  }

  .update-track {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

