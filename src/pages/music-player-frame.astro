---
import { siteConfig } from "@/data/site";
import "@/styles/music-player-frame.css";

const music = siteConfig.music;
const hasPlaylist = Boolean(music.playlistId && !music.playlistId.startsWith("YOUR_"));
const playlistUrl = music.metingApi
  .replace(":server", "tencent")
  .replace(":type", "playlist")
  .replace(":id", encodeURIComponent(music.playlistId))
  .replace(":r", String(Date.now()));
---

<!doctype html>
<html lang="zh-CN" class="h-full w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/vendor/aplayer/APlayer.min.css" />
    <script is:inline src="/vendor/aplayer/APlayer.min.js"></script>
</head>
  <body
    class="m-0 block h-full w-full overflow-hidden bg-transparent font-sans text-ink"
    data-has-playlist={hasPlaylist ? "true" : "false"}
    data-playlist-url={hasPlaylist ? playlistUrl : ""}
  >
    {
      hasPlaylist ? (
        <div id="player" class="min-h-full w-full"></div>
      ) : (
        <div class="frame-empty grid min-h-full w-full content-center gap-1 rounded-lg text-sm leading-snug text-muted">
          <strong class="text-sm text-ink">播放器已就绪</strong>
          <span>配置歌单 ID 后自动加载</span>
        </div>
      )
    }

    <script>
      (() => {
        const body = document.body;
        if (body.dataset.hasPlaylist !== "true" || !body.dataset.playlistUrl || !window.APlayer) return;

        const playerHost = document.querySelector("#player");
        if (!playerHost) return;

        const normalizeAudio = (items) => {
          if (!Array.isArray(items)) return [];
          return items
            .map((item) => ({
              name: item.name || item.title || "Audio name",
              artist: item.artist || item.author || "Audio artist",
              url: item.url,
              cover: item.cover || item.pic,
              lrc: item.lrc || item.lyric || "",
              type: item.type || "auto",
            }))
            .filter((item) => item.url);
        };

        const syncLyricFallback = () => {
          const lrc = playerHost.querySelector(".aplayer-lrc");
          if (!(lrc instanceof HTMLElement)) return;

          let hint = lrc.querySelector(".marchen-lrc-empty");
          if (!hint) {
            hint = document.createElement("p");
            hint.className = "marchen-lrc-empty";
            hint.textContent = "这是一首纯音乐哦~";
            lrc.append(hint);
          }

          const lines = Array.from(lrc.querySelectorAll("p:not(.marchen-lrc-empty)"));
          const hasText = lines.some((line) => {
            const text = line.textContent?.trim() ?? "";
            return text && !/^(loading|加载中|暂无歌词|no lyric|not available)$/i.test(text);
          });
          lrc.classList.toggle("is-empty", !hasText);
        };

        const postPlaylistState = () => {
          const list = playerHost.querySelector(".aplayer-list");
          const expanded = list instanceof HTMLElement && !list.classList.contains("aplayer-list-hide");

          body.dataset.playlistExpanded = expanded ? "true" : "false";
          window.parent?.postMessage(
            {
              type: "marchen-music-playlist",
              expanded,
            },
            window.location.origin
          );
        };

        const syncPlaylistStateSoon = () => {
          window.requestAnimationFrame(postPlaylistState);
        };

        fetch(body.dataset.playlistUrl, { credentials: "same-origin" })
          .then((response) => (response.ok ? response.json() : []))
          .then((items) => {
            const audio = normalizeAudio(items);
            if (!audio.length) {
              playerHost.innerHTML = '<div class="frame-empty"><strong>歌单加载失败</strong><span>稍后刷新重试</span></div>';
              return;
            }

            const player = new window.APlayer({
              container: playerHost,
              audio,
              autoplay: false,
              mutex: true,
              lrcType: 3,
              loop: "all",
              order: "list",
              preload: "metadata",
              theme: "#ff7a2f",
            });

            player.on("listshow", syncPlaylistStateSoon);
            player.on("listhide", syncPlaylistStateSoon);
            player.list?.hide?.();
            postPlaylistState();
            window.setTimeout(postPlaylistState, 80);

            const tryPlay = () => {
              player.audio?.play?.().catch(() => {});
              window.removeEventListener("pointerdown", tryPlay, true);
              window.removeEventListener("keydown", tryPlay, true);
            };

            window.addEventListener("pointerdown", tryPlay, true);
            window.addEventListener("keydown", tryPlay, true);
            syncLyricFallback();
            window.setTimeout(syncLyricFallback, 800);
            window.setTimeout(syncLyricFallback, 2400);
            new MutationObserver(syncLyricFallback).observe(playerHost, { childList: true, subtree: true, characterData: true });
          })
          .catch(() => {
            playerHost.innerHTML = '<div class="frame-empty"><strong>歌单加载失败</strong><span>稍后刷新重试</span></div>';
          });
      })();
    </script>
  </body>
</html>
