---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { hasPrivateAccess } from "@/lib/private-access";
import "@/styles/notes.css";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Vary", "Cookie");

const canViewPrivate = hasPrivateAccess(Astro.cookies);
const notes = (await getCollection("notes")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const visibleNotes = notes.filter((note) => note.data.visibility !== "private" || canViewPrivate);
const formatMomentTime = (date: Date) =>
  date.toLocaleString("zh-CN", {
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false});
---

<BaseLayout title="零星碎念" description="更轻量的日常记录、想法和朋友圈式笔记">
  <div class="page-shell page grid gap-6 pb-5">
    <section class="page-intro">
      <div>
        <p class="eyebrow">Moments</p>
        <h1>零星碎念</h1>
        <p>这里不是博客目录，更像随手发的小动态：纯文字、图片、图文混排都贴成一条条便签</p>
      </div>
      <aside class="intro-note">
        <span>想到什么就贴上来</span>
        <a class="private-publish" href="/admin/publish?type=note" data-private-action hidden>
          <Icon name="PencilLine" size={16} /> 发布碎念
        </a>
      </aside>
    </section>

    <section class="mx-auto grid w-full max-w-content gap-6 max-xs:w-full" aria-label="碎念列表">
      {visibleNotes.map((note, index) => {
        const text = note.body.trim();
        const images = note.data.images ?? [];
        const visibleImages = images.slice(0, 9);
        const imageCount = visibleImages.length;
        const isPrivate = note.data.visibility === "private";

        return (
          <article
            class:list={[
              "moment",
              `tone-${(index % 4) + 1}`,
              { "private-note": isPrivate, "is-visible": isPrivate },
            ]}
          >
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-black text-muted">
              <time datetime={note.data.pubDate.toISOString()}>{formatMomentTime(note.data.pubDate)}</time>
              <span class="inline-flex flex-wrap items-center gap-2">
                <Icon name={note.data.visibility === "private" ? "Lock" : "Globe2"} size={14} /> {note.data.mood ?? "记录"}
              </span>
            </div>
            <h2 class="moment-title relative my-2.5 mb-4 pb-3 font-hand text-2xl font-bold leading-tight tracking-normal text-ink">{note.data.title}</h2>
            {images.length > 0 && (
              <div class:list={["image-grid", `count-${imageCount}`]}>
                {visibleImages.map((image, imageIndex) => (
                  <img
                    src="/images/image-placeholder.svg"
                    data-media-src={image}
                    alt={`${note.data.title} 图片 ${imageIndex + 1}`}
                    loading="lazy"
                    data-note-image
                    data-media-min-placeholder="180"
                  />
                ))}
              </div>
            )}
            {text && <p class="m-0 whitespace-pre-wrap text-sm leading-loose text-ink-2">{text}</p>}
            <div class="mt-3.5 flex flex-wrap items-center justify-end gap-2.5 border-t border-dashed border-border pt-2.5">
              <div class="flex flex-wrap items-center gap-2">
                {note.data.tags.slice(0, 3).map((tag) => <span class="text-2xs font-black text-blue">#{tag}</span>)}
              </div>
            </div>
          </article>
        );
      })}
    </section>

    <script>
      import { setupLightbox } from "@/lib/lightbox";

      let cleanupNoteLightbox = () => {};

      function initNoteLightbox() {
        cleanupNoteLightbox();
        const root = document.querySelector(".page");
        if (!(root instanceof HTMLElement)) return;
        cleanupNoteLightbox = setupLightbox(root, "[data-note-image]");
        document.addEventListener("astro:before-swap", cleanupNoteLightbox, { once: true });
      }

      initNoteLightbox();
      document.addEventListener("astro:page-load", initNoteLightbox);
    </script>
  </div>
</BaseLayout>

