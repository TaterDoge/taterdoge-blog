---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";
import { siteConfig } from "@/data/site";

const techTags = Array.from(new Set(projects.flatMap((p) => p.tags ?? [])));
const categoryCount = Array.from(new Set(projects.map((p) => p.category))).length;
---

<BaseLayout title="项目" description={`${siteConfig.name} 的项目、实验和有趣的小东西`}>
  <div class="page-shell grid gap-6">
    <section class="page-intro">
      <div>
        <p class="eyebrow">Projects</p>
        <h1>项目</h1>
        <p>从想法到成品的过程都放在这里，有做好的、有还在磨的，每一步都是认真的</p>
      </div>
      <aside class="intro-note">
        <span>想到就动手试试</span>
        <div class="mt-3.5 flex flex-wrap justify-center gap-2">
          <a class="private-publish !m-0" href="/admin/publish?type=project" data-private-action hidden>
            <Icon name="PencilLine" size={16} /> 新增项目
          </a>
          <a class="private-publish !m-0" href="/admin/manage?tab=projects" data-private-action hidden>
            <Icon name="ListOrdered" size={16} /> 排序项目
          </a>
        </div>
      </aside>
    </section>

    <section class="grid grid-cols-1 items-start gap-7 pb-1.5 max-lg:grid-cols-1 min-lg:grid-cols-[minmax(0,1fr)_260px]">
      <div class="grid grid-cols-1 gap-x-6 max-lg:grid-cols-1 min-lg:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} variant="page" />)}
      </div>

      <aside class="sticky top-[94px] grid gap-5 max-lg:static max-lg:grid-cols-2 max-xs:grid-cols-1">
        <div class="border-b border-border-soft py-4">
          <h3 class="mb-3 flex items-center gap-2 text-sm font-black"><Icon name="BarChart3" size={16} /> 项目概览</h3>
          <dl class="m-0 grid gap-2">
            <div class="flex justify-between text-sm text-muted"><dt class="m-0">总数</dt><dd class="m-0 font-black text-blue">{projects.length}</dd></div>
            <div class="flex justify-between text-sm text-muted"><dt class="m-0">分类</dt><dd class="m-0 font-black text-blue">{categoryCount}</dd></div>
            <div class="flex justify-between text-sm text-muted"><dt class="m-0">维护中</dt><dd class="m-0 font-black text-blue">{projects.filter((p) => p.status === "维护中").length}</dd></div>
          </dl>
        </div>

        <div class="border-b border-border-soft py-4">
          <h3 class="mb-3 flex items-center gap-2 text-sm font-black"><Icon name="Tags" size={16} /> 技术标签</h3>
          <div class="flex flex-wrap gap-2">
            {techTags.slice(0, 12).map((tag) => (
              <span class="rounded-md border border-border px-2 py-0.5 text-2xs font-extrabold text-ink-2">{tag}</span>
            ))}
          </div>
        </div>

        <div class="relative -rotate-1 rounded-lg border border-border-strong bg-note-bg px-4 py-6">
          <span class="tape" aria-hidden="true"></span>
          <p class="m-0 font-note text-base leading-loose text-ink-2">比起完美的方案，我更喜欢一个能跑通的原型</p>
        </div>
      </aside>
    </section>
  </div>
</BaseLayout>
