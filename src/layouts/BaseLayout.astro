---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import MusicPlayer from "@/components/MusicPlayer.astro";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/data/site";
import "@fontsource/caveat/400.css";
import "@fontsource/caveat/700.css";
import "@/styles/theme.css";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
} = Astro.props;
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href="/images/image-placeholder.svg" as="image" />
    <script is:inline>
      (() => {
        const storageKey = "marchen_theme";
        const readTheme = () => {
          const stored = localStorage.getItem(storageKey);
          if (stored === "light" || stored === "dark") return stored;
          return window.matchMedia?.("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        };
        const applyTheme = (root = document.documentElement) => {
          root.dataset.theme = readTheme();
        };

        window.__marchenApplyTheme = applyTheme;
        applyTheme();

        if (!window.__marchenThemeSwapBound) {
          document.addEventListener("astro:before-swap", (event) => {
            applyTheme(event.newDocument.documentElement);
          });
          document.addEventListener("astro:after-swap", () => applyTheme());
          window.__marchenThemeSwapBound = true;
        }
      })();
    </script>
    {/* dev 下 ClientRouter 软导航会用 SSR 内联的残缺 Tailwind dev CSS 覆盖完整客户端样式，
        导致路由返回后卡片栅格/图片样式丢失；生产构建无此问题，仅 dev 禁用。 */}
    {import.meta.env.PROD && <ClientRouter />}
    <script src="../scripts/marchen-images.ts" />
    <script src="../scripts/marchen-decor.ts" />
    <script src="../scripts/marchen-pagefind.ts" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main class="site-main">
      <div class="site-decor" aria-hidden="true">
        <svg class="site-decor-lines" viewBox="0 0 1440 2000" preserveAspectRatio="none">
          <path class="site-decor-line left-main" d="M118 96 C168 104 188 140 170 182 C152 224 92 218 76 270 C54 342 144 348 140 424 C136 506 68 520 78 604 C88 686 164 688 136 774 C110 856 54 878 78 956 C104 1034 174 1022 150 1110 C126 1200 52 1218 86 1310 C116 1394 184 1398 146 1494 C112 1580 52 1622 92 1714 C124 1788 166 1818 134 1914" />
          <path class="site-decor-line right-main" d="M1318 144 C1262 172 1248 226 1284 270 C1320 314 1370 318 1342 390 C1312 466 1252 454 1246 536 C1240 620 1324 644 1304 734 C1286 820 1238 844 1264 922 C1292 1006 1362 1010 1328 1104 C1298 1190 1234 1212 1266 1300 C1298 1392 1360 1406 1328 1504 C1298 1590 1240 1628 1282 1712 C1316 1780 1342 1830 1306 1904" />
        </svg>

        <span class="site-decor-item site-decor-braces" data-site-parallax="8">
          <img src="/images/decorative_element/sprite0.webp" alt="" loading="lazy" decoding="async" data-no-media-shell="true" />
        </span>
        <span class="site-decor-item site-decor-code-card" data-site-parallax="6">
          <img src="/images/decorative_element/sprite1.webp" alt="" loading="lazy" decoding="async" data-no-media-shell="true" />
        </span>
        <span class="site-decor-item site-decor-cup" data-site-parallax="9">
          <img src="/images/decorative_element/sprite2.webp" alt="" loading="lazy" decoding="async" data-no-media-shell="true" />
        </span>
        <span class="site-decor-item site-decor-plant" data-site-parallax="7">
          <img src="/images/decorative_element/sprite3.webp" alt="" loading="lazy" decoding="async" data-no-media-shell="true" />
        </span>
        <span class="site-decor-item site-decor-books" data-site-parallax="5">
          <img src="/images/decorative_element/sprite4.webp" alt="" loading="lazy" decoding="async" data-no-media-shell="true" />
        </span>
        <span class="site-decor-item site-decor-phone" data-site-parallax="6">
          <img src="/images/decorative_element/sprite5.webp" alt="" loading="lazy" decoding="async" data-no-media-shell="true" />
        </span>
        <span class="site-decor-item site-decor-window" data-site-parallax="8">
          <img src="/images/decorative_element/sprite6.webp" alt="" loading="lazy" decoding="async" data-no-media-shell="true" />
        </span>
        <span class="site-decor-item site-decor-keyboard" data-site-parallax="5">
          <img src="/images/decorative_element/sprite7.webp" alt="" loading="lazy" decoding="async" data-no-media-shell="true" />
        </span>
        <span class="site-decor-item site-decor-coffee" data-site-parallax="10">
          <img src="/images/decorative_element/sprite8.webp" alt="" loading="lazy" decoding="async" data-no-media-shell="true" />
        </span>
      </div>
      <slot />
      <Footer />
    </main>
    <MusicPlayer />
  </body>
</html>
