{
  "name": "astro-marchen",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "bash scripts/subset-font.sh && bun run check:content && astro build && pagefind --site dist/client && rm -rf .vercel/output/static/pagefind && cp -R dist/client/pagefind .vercel/output/static/pagefind",
    "preview": "bun run build && bunx --bun serve -l 4173 .vercel/output/static",
    "astro": "astro",
    "check:content": "tsx scripts/check-content.ts",
    "test": "bun test",
    "typecheck": "astro check",
    "sync:kb": "tsx scripts/sync-kb.ts",
    "vercel-build": "bun run check:content && bun run sync:kb && bun run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/solid-js": "^7.0.2",
    "@astrojs/vercel": "^10.0.8",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fontsource/caveat": "5.2.8",
    "@lucide/astro": "^1.33.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^6.4.8",
    "astro-expressive-code": "^0.44.1",
    "diff": "^9.0.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.15",
    "sql-formatter": "^15.8.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.124",
    "@iconify/tailwind4": "^1.2.3",
    "@types/bun": "^1.4.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "vite": "^7",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.18",
    "path-to-regexp": "6.3.0",
    "sharp": "^0.35.3"
  }
}
