{
  "name": "astro-marchen",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "bash scripts/subset-font.sh && bun run check:content && astro build && pagefind --site dist/client && rm -rf .vercel/output/static/pagefind && cp -R dist/client/pagefind .vercel/output/static/pagefind",
    "preview": "bun run build && bunx --bun serve -l 4173 .vercel/output/static",
    "astro": "astro",
    "check:content": "tsx scripts/check-content.ts",
    "sync:kb": "tsx scripts/sync-kb.ts",
    "vercel-build": "bun run check:content && bun run sync:kb && bun run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/solid-js": "^7.0.1",
    "@astrojs/vercel": "^10.0.6",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fontsource/caveat": "5.2.8",
    "@lucide/astro": "^1.14.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "astro-expressive-code": "^0.44.1",
    "diff": "^9.0.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "prettier": "^3.8.3",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.14",
    "sql-formatter": "^15.8.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.119",
    "@iconify/tailwind4": "^1.2.3",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "^7"
  }
}
